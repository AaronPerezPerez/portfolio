---
import { personalInfo } from '../lib/data';
import NeonCard from './ui/NeonCard.astro';
import SocialLink from './ui/SocialLink.astro';
import Icon from './ui/Icon.astro';
import TerminalLine from './ui/TerminalLine.astro';

const currentYear = new Date().getFullYear();

// SVG icons for social links (SocialLink expects SVG strings)
const socialIcons = {
  github: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>`,
  linkedin: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>`,
  twitter: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`
};
---

<footer class="footer">
  <div class="container">
    <!-- Terminal-style contact section -->
    <NeonCard class="footer-terminal reveal">
      <div class="terminal-header">
        <span class="prompt-user">aarón</span>
        <span class="prompt-at">@</span>
        <span class="prompt-host">portfolio</span>
        <span class="prompt-colon">:</span>
        <span class="prompt-path">~</span>
        <span class="prompt-symbol">$</span>
        <span class="prompt-cursor">_</span>
      </div>

      <div class="terminal-commands">
        <div class="command-line">
          <TerminalLine prompt=">" command="contact" args="--email" />
          <a href={`mailto:${personalInfo.email}`} class="cmd-output">{personalInfo.email}</a>
        </div>

        <TerminalLine prompt=">" command="social" args="--list" />

        <div class="social-links">
          <SocialLink
            href={personalInfo.social.github}
            icon={socialIcons.github}
            label="GitHub"
            variant="button"
          />
          <SocialLink
            href={personalInfo.social.linkedin}
            icon={socialIcons.linkedin}
            label="LinkedIn"
            variant="button"
          />
          <SocialLink
            href={personalInfo.social.twitter}
            icon={socialIcons.twitter}
            label="X/Twitter"
            variant="button"
          />
        </div>
      </div>
    </NeonCard>

    <!-- Divider -->
    <div class="footer-divider">
      <div class="divider-line"></div>
      <span class="divider-text">EOF</span>
      <div class="divider-line"></div>
    </div>

    <!-- Copyright -->
    <div class="footer-bottom">
      <p class="copyright">
        <span class="comment">// </span>
        © {currentYear} {personalInfo.name}. All rights reserved.
      </p>
      <p class="built-with">
        <span class="comment">// </span>
        Built with
        <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>
        +
        <a href="https://tailwindcss.com" target="_blank" rel="noopener">Tailwind</a>
        +
        <span class="love">♥</span>
      </p>
      <p class="location-tag">
        <span class="comment">// </span>
        Made in {personalInfo.location.split(',')[0]}
        <span class="flag">🇮🇨</span>
      </p>
    </div>
  </div>

  <!-- Back to top -->
  <a href="#hero" class="back-to-top" aria-label="Back to top">
    <Icon name="arrow-up" size={20} />
  </a>
</footer>

<style>
  .footer {
    background: var(--color-bg-secondary);
    padding: 80px 0 40px;
    position: relative;
  }

  /* Terminal contact */
  .footer-terminal {
    margin-bottom: 40px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .terminal-header {
    font-family: var(--font-mono);
    font-size: 14px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }

  .prompt-user {
    color: var(--color-neon-green);
  }

  .prompt-at {
    color: var(--color-text-muted);
  }

  .prompt-host {
    color: var(--color-neon-cyan);
  }

  .prompt-colon {
    color: var(--color-text-muted);
  }

  .prompt-path {
    color: var(--color-neon-magenta);
  }

  .prompt-symbol {
    color: var(--color-text-muted);
    margin-left: 4px;
  }

  .prompt-cursor {
    color: var(--color-neon-cyan);
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  .terminal-commands {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .command-line {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    flex-wrap: wrap;
  }

  .cmd-prompt {
    color: var(--color-neon-green);
  }

  .cmd-text {
    color: var(--color-neon-cyan);
  }

  .cmd-output {
    color: var(--color-neon-orange);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .cmd-output:hover {
    text-decoration: underline;
    text-shadow: 0 0 10px rgba(255, 107, 53, 0.5);
  }

  /* Social links */
  .social-links {
    display: flex;
    gap: 16px;
    margin-top: 8px;
    padding-left: 20px;
    flex-wrap: wrap;
  }

  /* Divider */
  .footer-divider {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 30px;
  }

  .divider-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(0, 255, 247, 0.3),
      transparent
    );
  }

  .divider-text {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-muted);
    letter-spacing: 4px;
  }

  /* Footer bottom */
  .footer-bottom {
    text-align: center;
  }

  .footer-bottom p {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-muted);
    margin: 8px 0;
  }

  .comment {
    color: var(--color-neon-green);
    opacity: 0.5;
  }

  .copyright {
    color: var(--color-text-secondary);
  }

  .built-with a {
    color: var(--color-neon-cyan);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .built-with a:hover {
    text-decoration: underline;
    text-shadow: 0 0 10px rgba(0, 255, 247, 0.5);
  }

  .love {
    color: var(--color-neon-magenta);
    animation: pulse-heart 1.5s ease-in-out infinite;
  }

  @keyframes pulse-heart {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.2); }
  }

  .flag {
    margin-left: 4px;
  }

  /* Back to top button */
  .back-to-top {
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    width: 44px;
    height: 44px;
    background: var(--color-bg-terminal);
    border: 1px solid var(--color-neon-cyan);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-neon-cyan);
    text-decoration: none;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    z-index: 100;
  }

  .back-to-top.visible {
    opacity: 1;
    visibility: visible;
  }

  .back-to-top:hover {
    background: var(--color-neon-cyan);
    color: var(--color-bg-primary);
    box-shadow: 0 0 20px rgba(0, 255, 247, 0.5);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .social-links {
      flex-direction: column;
      padding-left: 0;
    }

    .back-to-top {
      bottom: 20px;
      /* Already centered with left: 50% + transform */
    }
  }
</style>

<script>
  // Show/hide back to top button based on scroll
  const backToTop = document.querySelector('.back-to-top');

  if (backToTop) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 500) {
        backToTop.classList.add('visible');
      } else {
        backToTop.classList.remove('visible');
      }
    });
  }
</script>
