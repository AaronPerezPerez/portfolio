---
/**
 * ConversationsSidebar - Left panel with search, filters, and conversation list
 *
 * Uses event delegation for efficient handling of conversation clicks.
 * The actual list rendering is done client-side by the admin script.
 */
---

<aside class="conversations-sidebar">
  <!-- Search Section -->
  <div class="search-section">
    <div class="search-wrapper">
      <input
        type="text"
        id="search-input"
        class="search-input"
        placeholder="Search... (press /)"
      />
      <svg class="search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
    </div>
    <!-- Search results dropdown (populated by JS) -->
    <div id="search-results" class="search-results hidden"></div>
  </div>

  <!-- Filters Toggle -->
  <div class="filters-section">
    <button id="filters-toggle" class="filters-toggle">
      <span class="filters-label">
        <svg class="filter-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
        </svg>
        <span>FILTERS</span>
        <span id="active-filters-count" class="filter-badge hidden">0</span>
      </span>
      <svg id="filters-chevron" class="chevron-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
      </svg>
    </button>

    <!-- Filters Panel (collapsible) -->
    <div id="filters-panel" class="filters-panel hidden">
      <!-- Date Range -->
      <div class="filter-group">
        <label class="filter-label">DATE RANGE</label>
        <div class="filter-row">
          <input type="date" id="filter-date-from" class="filter-input" />
          <span class="filter-separator">→</span>
          <input type="date" id="filter-date-to" class="filter-input" />
        </div>
      </div>

      <!-- Language -->
      <div class="filter-group">
        <label class="filter-label">LANGUAGE</label>
        <select id="filter-language" class="filter-select">
          <option value="">All languages</option>
          <option value="es">Spanish</option>
          <option value="en">English</option>
        </select>
      </div>

      <!-- Message Count -->
      <div class="filter-group">
        <label class="filter-label">MESSAGE COUNT</label>
        <div class="filter-row">
          <input type="number" id="filter-min-messages" placeholder="Min" min="0" class="filter-input" />
          <span class="filter-separator">-</span>
          <input type="number" id="filter-max-messages" placeholder="Max" min="0" class="filter-input" />
        </div>
      </div>

      <!-- Tag Filter -->
      <div class="filter-group">
        <label class="filter-label">TAG</label>
        <select id="filter-tag" class="filter-select">
          <option value="">All tags</option>
          <!-- Options populated by JS -->
        </select>
      </div>

      <!-- Filter Actions -->
      <div class="filter-actions">
        <button id="clear-filters-btn" class="btn-filter btn-clear">Clear</button>
        <button id="apply-filters-btn" class="btn-filter btn-apply">Apply</button>
      </div>
    </div>
  </div>

  <!-- Active Filter Chips -->
  <div id="active-filters-chips" class="filter-chips hidden"></div>

  <!-- Bulk Action Bar -->
  <div id="bulk-action-bar" class="bulk-bar hidden">
    <div class="bulk-left">
      <input type="checkbox" id="select-all-checkbox" class="bulk-checkbox" />
      <span class="bulk-count">
        <span id="selected-count">0</span> selected
      </span>
    </div>
    <div class="bulk-actions">
      <button id="bulk-delete-btn" class="bulk-btn delete" title="Delete selected">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
        </svg>
      </button>
      <button id="bulk-tag-btn" class="bulk-btn tag" title="Add tag">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
        </svg>
      </button>
      <button id="bulk-export-btn" class="bulk-btn export" title="Export selected">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Bulk Tag Dropdown -->
  <div id="bulk-tag-dropdown" class="tag-dropdown hidden">
    <div class="tag-dropdown-title">Select tag to add:</div>
    <div id="bulk-tag-options" class="tag-options"></div>
  </div>

  <!-- Conversations List Container (uses event delegation) -->
  <div id="conversations-list" class="conversations-list">
    <div class="loading-state">Loading...</div>
  </div>
</aside>

<style>
  .conversations-sidebar {
    width: 20rem;
    border-right: 1px solid var(--border-color);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }

  /* Search */
  .search-section {
    padding: 0.75rem;
    border-bottom: 1px solid var(--border-color);
    position: relative;
  }

  .search-wrapper {
    position: relative;
  }

  .search-input {
    width: 100%;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    padding: 0.5rem 0.75rem 0.5rem 2rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-primary);
    transition: border-color 0.2s ease;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--primary);
  }

  .search-icon {
    position: absolute;
    left: 0.625rem;
    top: 50%;
    transform: translateY(-50%);
    width: 1rem;
    height: 1rem;
    color: var(--text-muted);
  }

  .search-results {
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    top: 100%;
    margin-top: 0.25rem;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
    max-height: 20rem;
    overflow-y: auto;
    z-index: 50;
  }

  .search-results.hidden {
    display: none;
  }

  /* Filters */
  .filters-section {
    border-bottom: 1px solid var(--border-color);
  }

  .filters-toggle {
    width: 100%;
    padding: 0.5rem 0.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .filters-toggle:hover {
    background: var(--bg-secondary);
  }

  .filters-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .filter-icon {
    width: 0.875rem;
    height: 0.875rem;
  }

  .filter-badge {
    padding: 0.125rem 0.375rem;
    background: var(--primary);
    color: var(--bg-primary);
    border-radius: 4px;
    font-size: 0.625rem;
  }

  .filter-badge.hidden {
    display: none;
  }

  .chevron-icon {
    width: 1rem;
    height: 1rem;
    transition: transform 0.2s ease;
  }

  .chevron-icon.open {
    transform: rotate(180deg);
  }

  .filters-panel {
    padding: 0 0.75rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .filters-panel.hidden {
    display: none;
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .filter-label {
    font-size: 0.625rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .filter-row {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .filter-input,
  .filter-select {
    flex: 1;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    padding: 0.25rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-primary);
  }

  .filter-input:focus,
  .filter-select:focus {
    outline: none;
    border-color: var(--primary);
  }

  .filter-separator {
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .filter-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .btn-filter {
    flex: 1;
    padding: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-clear {
    background: transparent;
    border: 1px solid var(--border-color);
    color: var(--text-muted);
  }

  .btn-clear:hover {
    border-color: var(--text-primary);
    color: var(--text-primary);
  }

  .btn-apply {
    background: var(--primary);
    border: none;
    color: var(--bg-primary);
  }

  .btn-apply:hover {
    opacity: 0.9;
  }

  /* Filter Chips */
  .filter-chips {
    padding: 0.5rem 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    border-bottom: 1px solid var(--border-color);
  }

  .filter-chips.hidden {
    display: none;
  }

  /* Bulk Action Bar */
  .bulk-bar {
    padding: 0.5rem 0.75rem;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .bulk-bar.hidden {
    display: none;
  }

  .bulk-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .bulk-checkbox {
    width: 1rem;
    height: 1rem;
    accent-color: var(--primary);
  }

  .bulk-count {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .bulk-actions {
    display: flex;
    gap: 0.5rem;
  }

  .bulk-btn {
    width: 1.75rem;
    height: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    border: 1px solid var(--border-color);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .bulk-btn svg {
    width: 0.875rem;
    height: 0.875rem;
  }

  .bulk-btn.delete:hover {
    border-color: #ef4444;
    color: #ef4444;
  }

  .bulk-btn.tag:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .bulk-btn.export:hover {
    border-color: var(--color-neon-green);
    color: var(--color-neon-green);
  }

  /* Tag Dropdown */
  .tag-dropdown {
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
    padding: 0.5rem;
    z-index: 50;
  }

  .tag-dropdown.hidden {
    display: none;
  }

  .tag-dropdown-title {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .tag-options {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  /* Conversations List */
  .conversations-list {
    flex: 1;
    overflow-y: auto;
  }

  .loading-state {
    padding: 1rem;
    text-align: center;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
</style>
