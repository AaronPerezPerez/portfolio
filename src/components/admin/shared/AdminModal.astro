---
/**
 * AdminModal - Reusable modal dialog component
 *
 * Props:
 * - id: Modal element ID (for JS manipulation)
 * - title: Terminal header title (e.g., "confirm.delete")
 * - heading: Main heading text
 * - description: Description text
 * - variant: Color variant ("danger" | "warning" | "info")
 * - confirmText: Confirm button text
 * - cancelText: Cancel button text
 */

interface Props {
  id: string;
  title?: string;
  heading?: string;
  description?: string;
  variant?: 'danger' | 'warning' | 'info';
  confirmText?: string;
  cancelText?: string;
}

const {
  id,
  title = 'confirm.action',
  heading = 'Confirm Action?',
  description = 'This action cannot be undone.',
  variant = 'danger',
  confirmText = 'Confirm',
  cancelText = 'Cancel',
} = Astro.props;

const variantClasses = {
  danger: {
    iconBg: 'bg-red-500/20',
    iconColor: 'text-red-400',
    buttonBg: 'bg-red-500 hover:bg-red-600',
  },
  warning: {
    iconBg: 'bg-yellow-500/20',
    iconColor: 'text-yellow-400',
    buttonBg: 'bg-yellow-500 hover:bg-yellow-600',
  },
  info: {
    iconBg: 'bg-blue-500/20',
    iconColor: 'text-blue-400',
    buttonBg: 'bg-blue-500 hover:bg-blue-600',
  },
};

const styles = variantClasses[variant];
---

<div id={id} class="admin-modal hidden">
  <div class="modal-backdrop"></div>
  <div class="modal-container">
    <div class="modal-content">
      <div class="terminal-header">
        <span class="terminal-dot dot-red"></span>
        <span class="terminal-dot dot-yellow"></span>
        <span class="terminal-dot dot-green"></span>
        <span class="terminal-title" id={`${id}-title`}>{title}</span>
      </div>

      <div class="modal-body">
        <div class="modal-header-content">
          <div class={`modal-icon ${styles.iconBg}`}>
            <svg class={`icon ${styles.iconColor}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
          </div>
          <div class="modal-text">
            <h3 class="modal-heading" id={`${id}-heading`}>{heading}</h3>
            <p class="modal-description" id={`${id}-description`}>{description}</p>
          </div>
        </div>

        <!-- Custom content slot -->
        <slot />

        <div class="modal-actions">
          <button id={`${id}-cancel`} class="btn btn-cancel">
            {cancelText}
          </button>
          <button id={`${id}-confirm`} class={`btn btn-confirm ${styles.buttonBg}`}>
            {confirmText}
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .admin-modal {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .admin-modal.hidden {
    display: none;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
  }

  .modal-container {
    position: relative;
    width: 100%;
    max-width: 28rem;
    margin: 0 1rem;
  }

  .modal-content {
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }

  .terminal-header {
    background: rgba(var(--bg-tertiary-rgb, 30, 30, 45), 0.8);
    padding: 12px 16px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
  }

  .terminal-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    margin-right: 8px;
  }

  .dot-red { background: #ef4444; }
  .dot-yellow { background: #eab308; }
  .dot-green { background: #22c55e; }

  .terminal-title {
    margin-left: 1rem;
    font-size: 0.75rem;
    opacity: 0.7;
    font-family: var(--font-mono);
  }

  .modal-body {
    padding: 1.5rem;
  }

  .modal-header-content {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .modal-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .modal-icon .icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  .modal-text {
    flex: 1;
  }

  .modal-heading {
    font-family: var(--font-mono);
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .modal-description {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .modal-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .btn {
    flex: 1;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s ease;
    border: none;
  }

  .btn-cancel {
    background: transparent;
    border: 1px solid var(--border-color);
    color: var(--text-primary);
  }

  .btn-cancel:hover {
    background: var(--bg-secondary);
  }

  .btn-confirm {
    color: white;
  }
</style>
