---
import { experiences } from '../lib/data';
---

<section id="experience" class="section experience-section">
  <div class="container">
    <h2 class="section-title reveal">
      <span class="title-prefix">//</span> Experience
    </h2>

    <div class="timeline">
      <div class="timeline-line"></div>

      {experiences.map((exp, index) => (
        <div
          class={`timeline-item ${exp.current ? 'current' : ''} reveal-left`}
          style={`--delay: ${index * 150}ms`}
        >
          <div class="timeline-node">
            <div class="node-dot"></div>
            {exp.current && <div class="node-pulse"></div>}
          </div>

          <div class="timeline-card">
            <div class="card-header">
              <div class="card-company">
                <span class="company-bracket">{'{'}</span>
                <span class="company-name">{exp.company}</span>
                <span class="company-bracket">{'}'}</span>
              </div>
              {exp.current && (
                <span class="active-indicator">Active</span>
              )}
            </div>

            <div class="card-role">
              <span class="role-prompt">&gt;</span>
              <span class="role-text">{exp.role}</span>
            </div>

            <div class="card-meta">
              <span class="meta-location">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
                {exp.location}
              </span>
              <span class="meta-date">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                  <line x1="16" y1="2" x2="16" y2="6"/>
                  <line x1="8" y1="2" x2="8" y2="6"/>
                  <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                {exp.startDate} - {exp.endDate}
                {exp.duration && <span class="duration">({exp.duration})</span>}
              </span>
            </div>

            <p class="card-description">{exp.description}</p>

            <div class="card-technologies">
              {exp.technologies.map((tech) => (
                <span class="tech-tag">{tech}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .experience-section {
    background: var(--color-bg-primary);
    position: relative;
  }

  .title-prefix {
    color: var(--color-neon-magenta);
    margin-right: 12px;
  }

  .timeline {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
    padding-left: 60px;
  }

  .timeline-line {
    position: absolute;
    left: 20px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(
      180deg,
      var(--color-neon-cyan),
      var(--color-neon-magenta),
      var(--color-neon-cyan)
    );
    box-shadow: 0 0 10px rgba(0, 255, 247, 0.5);
  }

  .timeline-item {
    position: relative;
    margin-bottom: 50px;
    transition-delay: var(--delay);
  }

  .timeline-item:last-child {
    margin-bottom: 0;
  }

  /* Timeline node */
  .timeline-node {
    position: absolute;
    left: -52px;
    top: 20px;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .node-dot {
    width: 14px;
    height: 14px;
    background: var(--color-bg-primary);
    border: 3px solid var(--color-neon-cyan);
    border-radius: 50%;
    z-index: 2;
    transition: all 0.3s ease;
  }

  .timeline-item.current .node-dot {
    background: var(--color-neon-green);
    border-color: var(--color-neon-green);
    box-shadow: 0 0 15px rgba(57, 255, 20, 0.7);
  }

  .node-pulse {
    position: absolute;
    width: 24px;
    height: 24px;
    border: 2px solid var(--color-neon-green);
    border-radius: 50%;
    animation: node-pulse 2s ease-out infinite;
  }

  @keyframes node-pulse {
    0% {
      transform: scale(1);
      opacity: 1;
    }
    100% {
      transform: scale(2);
      opacity: 0;
    }
  }

  .timeline-item:hover .node-dot {
    transform: scale(1.2);
    box-shadow: 0 0 20px rgba(0, 255, 247, 0.7);
  }

  /* Timeline card */
  .timeline-card {
    background: var(--color-bg-terminal);
    border: 1px solid rgba(0, 255, 247, 0.3);
    border-radius: 8px;
    padding: 24px;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .timeline-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: var(--color-neon-cyan);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .timeline-item.current .timeline-card::before {
    background: var(--color-neon-green);
    opacity: 1;
  }

  .timeline-item:hover .timeline-card {
    border-color: var(--color-neon-cyan);
    box-shadow: 0 0 30px rgba(0, 255, 247, 0.2);
    transform: translateX(5px);
  }

  .timeline-item:hover .timeline-card::before {
    opacity: 1;
  }

  /* Card header */
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .card-company {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .company-bracket {
    color: var(--color-neon-magenta);
    font-weight: 300;
  }

  .company-name {
    color: var(--color-text-primary);
  }

  /* Card role */
  .card-role {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    font-family: var(--font-mono);
    font-size: 1.1rem;
  }

  .role-prompt {
    color: var(--color-neon-green);
    font-weight: 600;
  }

  .role-text {
    color: var(--color-neon-cyan);
  }

  /* Card meta */
  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 16px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .meta-location,
  .meta-date {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .meta-location svg,
  .meta-date svg {
    color: var(--color-neon-cyan);
    opacity: 0.7;
  }

  .duration {
    color: var(--color-text-secondary);
    margin-left: 4px;
  }

  /* Card description */
  .card-description {
    color: var(--color-text-secondary);
    font-size: 14px;
    line-height: 1.7;
    margin-bottom: 20px;
  }

  /* Technologies */
  .card-technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tech-tag {
    padding: 4px 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    background: transparent;
    border: 1px solid rgba(0, 255, 247, 0.4);
    color: var(--color-neon-cyan);
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .tech-tag:hover {
    background: rgba(0, 255, 247, 0.1);
    border-color: var(--color-neon-cyan);
    box-shadow: 0 0 10px rgba(0, 255, 247, 0.3);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .timeline {
      padding-left: 40px;
    }

    .timeline-line {
      left: 10px;
    }

    .timeline-node {
      left: -34px;
    }

    .card-meta {
      flex-direction: column;
      gap: 10px;
    }

    .card-company {
      font-size: 1.2rem;
    }
  }
</style>
