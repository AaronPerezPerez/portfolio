---
import { experiences } from '../lib/data';
import SectionTitle from './ui/SectionTitle.astro';
import TechTag from './ui/TechTag.astro';
import Icon from './ui/Icon.astro';
import Badge from './ui/Badge.astro';
---

<section id="experience" class="section experience-section">
  <div class="container">
    <SectionTitle title="Experience" />

    <div class="timeline">
      <div class="timeline-line"></div>

      {experiences.map((exp, index) => (
        <div
          id={`exp-${exp.slug}`}
          class={`timeline-item ${exp.current ? 'current' : ''} reveal-left`}
          style={`--delay: ${index * 150}ms`}
        >
          <div class="timeline-node">
            <div class="node-dot"></div>
            {exp.current && <div class="node-pulse"></div>}
          </div>

          <a href={`/experience/${exp.slug}`} class="timeline-card-link">
          <div class="timeline-card" transition:name={`exp-card-${exp.slug}`}>
            <div class="card-header">
              <div class="card-company">
                <div
                  class="company-logo"
                  style={`--logo-color: ${exp.logoColor}`}
                  transition:name={`exp-logo-${exp.slug}`}
                >
                  {exp.logo.startsWith('/') || exp.logo.startsWith('http') ? (
                    <img src={exp.logo} alt={`${exp.company} logo`} class="logo-img" loading="lazy" decoding="async" />
                  ) : (
                    <span class="logo-icon" set:html={exp.logo} />
                  )}
                </div>
                <div class="company-text">
                  <span class="company-bracket">{'{'}</span>
                  <span class="company-name" transition:name={`exp-title-${exp.slug}`}>
                    {exp.company}
                  </span>
                  <span class="company-bracket">{'}'}</span>
                </div>
              </div>
              {exp.current && (
                <Badge label="Active" variant="green" />
              )}
            </div>

            <div class="card-role" transition:name={`exp-role-${exp.slug}`}>
              <span class="role-prompt">&gt;</span>
              <span class="role-text">{exp.role}</span>
            </div>

            <div class="card-meta">
              <span class="meta-location" transition:name={`exp-location-${exp.slug}`}>
                <Icon name="location" size={14} />
                {exp.location}
              </span>
              <span class="meta-date" transition:name={`exp-date-${exp.slug}`}>
                <Icon name="calendar" size={14} />
                {exp.startDate} - {exp.endDate}
                {exp.duration && <span class="duration">({exp.duration})</span>}
              </span>
            </div>

            <p class="card-description" transition:name={`exp-desc-${exp.slug}`}>{exp.description}</p>

            <div class="card-technologies" transition:name={`exp-tech-${exp.slug}`}>
              {exp.technologies.map((tech) => (
                <TechTag name={tech} size="md" />
              ))}
            </div>
          </div>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .experience-section {
    background: var(--color-bg-primary);
    position: relative;
    overflow-x: hidden;
  }

  .timeline {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
    padding-left: 60px;
  }

  .timeline-line {
    position: absolute;
    left: 20px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(
      180deg,
      var(--color-neon-cyan),
      var(--color-neon-magenta),
      var(--color-neon-cyan)
    );
    box-shadow: 0 0 10px rgba(0, 255, 247, 0.5);
  }

  .timeline-item {
    position: relative;
    margin-bottom: 50px;
    transition-delay: var(--delay);
  }

  .timeline-item:last-child {
    margin-bottom: 0;
  }

  /* Timeline node */
  .timeline-node {
    position: absolute;
    left: -52px;
    top: 20px;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .node-dot {
    width: 14px;
    height: 14px;
    background: var(--color-bg-primary);
    border: 3px solid var(--color-neon-cyan);
    border-radius: 50%;
    z-index: 2;
    transition: all 0.3s ease;
  }

  .timeline-item.current .node-dot {
    background: var(--color-neon-green);
    border-color: var(--color-neon-green);
    box-shadow: 0 0 15px rgba(57, 255, 20, 0.7);
  }

  .node-pulse {
    position: absolute;
    width: 24px;
    height: 24px;
    border: 2px solid var(--color-neon-green);
    border-radius: 50%;
    animation: node-pulse 2s ease-out infinite;
  }

  @keyframes node-pulse {
    0% {
      transform: scale(1);
      opacity: 1;
    }
    100% {
      transform: scale(2);
      opacity: 0;
    }
  }

  .timeline-item:hover .node-dot {
    transform: scale(1.2);
    box-shadow: 0 0 20px rgba(0, 255, 247, 0.7);
  }

  /* Timeline card link */
  .timeline-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  /* Timeline card */
  .timeline-card {
    background: var(--color-bg-terminal);
    border: 1px solid rgba(0, 255, 247, 0.3);
    border-radius: 8px;
    padding: 24px;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .timeline-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: var(--color-neon-cyan);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .timeline-item.current .timeline-card::before {
    background: var(--color-neon-green);
    opacity: 1;
  }

  .timeline-item:hover .timeline-card {
    border-color: var(--color-neon-cyan);
    box-shadow: 0 0 30px rgba(0, 255, 247, 0.2);
    transform: translateX(5px);
  }

  .timeline-item:hover .timeline-card::before {
    opacity: 1;
  }

  /* Card header */
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .card-company {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .company-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    color: var(--color-text-muted);
    transition: all 0.3s ease;
    text-decoration: none;
    --logo-color: var(--color-neon-cyan);
  }

  .logo-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    transition: all 0.3s ease;
  }

  .logo-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .logo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 6px;
  }

  .company-logo:hover {
    border-color: var(--logo-color);
    background: color-mix(in srgb, var(--logo-color) 15%, transparent);
    box-shadow: 0 0 20px color-mix(in srgb, var(--logo-color) 30%, transparent);
    color: var(--logo-color);
    transform: scale(1.05);
  }

  .company-text {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .company-bracket {
    color: var(--color-neon-magenta);
    font-weight: 300;
  }

  .company-name {
    color: var(--color-text-primary);
    transition: all 0.2s ease;
  }

  .timeline-card-link:hover .company-name {
    color: var(--color-neon-cyan);
    text-shadow: 0 0 10px rgba(0, 255, 247, 0.5);
  }

  /* Card role */
  .card-role {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    font-family: var(--font-mono);
    font-size: 1.1rem;
  }

  .role-prompt {
    color: var(--color-neon-green);
    font-weight: 600;
  }

  .role-text {
    color: var(--color-neon-cyan);
  }

  /* Card meta */
  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 16px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .meta-location,
  .meta-date {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .meta-location :global(.icon),
  .meta-date :global(.icon) {
    color: var(--color-neon-cyan);
    opacity: 0.7;
  }

  .duration {
    color: var(--color-text-secondary);
    margin-left: 4px;
  }

  /* Card description */
  .card-description {
    color: var(--color-text-secondary);
    font-size: 14px;
    line-height: 1.7;
    margin-bottom: 20px;
  }

  /* Technologies */
  .card-technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .timeline {
      padding-left: 40px;
    }

    .timeline-line {
      left: 10px;
    }

    .timeline-node {
      left: -34px;
    }

    .card-meta {
      flex-direction: column;
      gap: 10px;
    }

    .card-company {
      font-size: 1.2rem;
    }
  }

  @media (max-width: 480px) {
    .timeline {
      padding-left: 30px;
    }

    .timeline-line {
      left: 5px;
    }

    .timeline-node {
      left: -28px;
      width: 14px;
      height: 14px;
    }

    .node-dot {
      width: 6px;
      height: 6px;
    }

    .timeline-card {
      padding: 16px;
    }

    .card-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .card-company {
      font-size: 1rem;
    }

    .card-company-inner {
      font-size: 0.9rem;
    }

    .card-role {
      font-size: 0.85rem;
    }

    .card-description {
      font-size: 0.8rem;
      line-height: 1.5;
    }

    .meta-location,
    .meta-date {
      font-size: 0.7rem;
    }

    .card-technologies {
      gap: 6px;
    }
  }
</style>
