---
import { experiences } from '../lib/data';
import SectionTitle from './ui/SectionTitle.astro';
import TechTag from './ui/TechTag.astro';
import Icon from './ui/Icon.astro';

// Flatten all projects from experiences with company info
const workProjects = experiences.flatMap(exp =>
  exp.projects.map(project => ({
    ...project,
    company: exp.company,
    companyColor: exp.logoColor,
  }))
);
---

<section id="work-projects" class="section work-projects-section">
  <div class="container">
    <SectionTitle title="Work Projects" />

    <div class="work-projects-grid">
      {workProjects.map((project, index) => (
        <div
          class="project-card reveal"
          style={`--delay: ${index * 100}ms; --accent-color: ${project.companyColor}`}
        >
          <div class="project-image-container">
            <img
              src={project.image}
              alt={project.name}
              class="project-image"
              loading="lazy"
              decoding="async"
            />
            <div class="scanlines"></div>
            <div class="image-overlay">
              {project.url ? (
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="view-project-btn"
                >
                  <Icon name="arrow-right" size={14} />
                  <span>VIEW_LIVE</span>
                </a>
              ) : (
                <span class="internal-badge">INTERNAL</span>
              )}
            </div>
          </div>

          <div class="project-content">
            <div class="project-header">
              <span class="project-company" style={`color: ${project.companyColor}`}>
                @{project.company}
              </span>
            </div>

            <h3 class="project-name">{project.name}</h3>

            <div class="description-wrapper">
              <p class="project-description">{project.description}</p>
              <button class="read-more-btn" aria-expanded="false">
                <span class="read-more-text">READ_MORE</span>
                <span class="read-less-text">READ_LESS</span>
              </button>
            </div>

            <div class="project-technologies">
              {project.technologies.slice(0, 5).map((tech) => (
                <TechTag name={tech} size="sm" />
              ))}
              {project.technologies.length > 5 && (
                <span class="more-tech">+{project.technologies.length - 5}</span>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .work-projects-section {
    background: var(--color-bg-secondary);
  }

  .work-projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 24px;
  }

  /* Project card */
  .project-card {
    display: flex;
    flex-direction: column;
    background: var(--color-bg-terminal);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s ease;
    transition-delay: var(--delay);
  }

  .project-card:hover {
    border-color: var(--accent-color, var(--color-neon-cyan));
    box-shadow:
      0 0 30px color-mix(in srgb, var(--accent-color, var(--color-neon-cyan)) 20%, transparent),
      0 10px 40px rgba(0, 0, 0, 0.3);
    transform: translateY(-5px);
  }

  /* Image container */
  .project-image-container {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #0a0a0a;
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.5s ease;
  }

  .project-card:hover .project-image {
    transform: scale(1.05);
  }

  /* Scanlines overlay - uses global styles but adjusted for images */
  .project-image-container .scanlines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.3;
  }

  /* Image overlay */
  .image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      transparent 40%,
      rgba(0, 0, 0, 0.8) 100%
    );
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 16px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .project-card:hover .image-overlay {
    opacity: 1;
  }

  .view-project-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-neon-cyan);
    background: rgba(0, 0, 0, 0.8);
    border: 1px solid var(--color-neon-cyan);
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.2s ease;
    backdrop-filter: blur(4px);
  }

  .view-project-btn:hover {
    background: var(--color-neon-cyan);
    color: #000;
    box-shadow: 0 0 20px rgba(0, 255, 247, 0.5);
  }

  .internal-badge {
    display: inline-flex;
    padding: 8px 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-muted);
    background: rgba(0, 0, 0, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    backdrop-filter: blur(4px);
  }

  /* Project content */
  .project-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 20px;
  }

  .project-header {
    margin-bottom: 8px;
  }

  .project-company {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
  }

  .project-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 12px;
    transition: color 0.2s ease;
  }

  .project-card:hover .project-name {
    color: var(--accent-color, var(--color-neon-cyan));
  }

  .description-wrapper {
    margin-bottom: 16px;
  }

  .project-description {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .description-wrapper.expanded .project-description {
    display: block;
    -webkit-line-clamp: unset;
  }

  .read-more-btn {
    display: none;
    align-items: center;
    gap: 4px;
    margin-top: 8px;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent-color, var(--color-neon-cyan));
    background: none;
    border: none;
    cursor: pointer;
    opacity: 0.8;
    transition: opacity 0.2s ease;
  }

  .read-more-btn:hover {
    opacity: 1;
  }

  .read-more-btn.visible {
    display: inline-flex;
  }

  .read-more-btn .read-less-text {
    display: none;
  }

  .description-wrapper.expanded .read-more-btn .read-more-text {
    display: none;
  }

  .description-wrapper.expanded .read-more-btn .read-less-text {
    display: inline;
  }

  .project-technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    margin-top: auto;
    padding-top: 12px;
  }

  .more-tech {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-muted);
    padding: 4px 8px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .work-projects-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .project-content {
      padding: 16px;
    }

    .project-name {
      font-size: 1.1rem;
    }

    .project-description {
      font-size: 12px;
      -webkit-line-clamp: 2;
    }
  }
</style>

<script>
  function initReadMore() {
    const wrappers = document.querySelectorAll('.description-wrapper');

    wrappers.forEach(wrapper => {
      const description = wrapper.querySelector('.project-description') as HTMLElement;
      const button = wrapper.querySelector('.read-more-btn') as HTMLButtonElement;

      if (!description || !button) return;

      // Check if text is truncated
      const isTruncated = description.scrollHeight > description.clientHeight;

      if (isTruncated) {
        button.classList.add('visible');

        button.addEventListener('click', () => {
          const isExpanded = wrapper.classList.toggle('expanded');
          button.setAttribute('aria-expanded', String(isExpanded));
        });
      }
    });
  }

  // Run on page load
  initReadMore();

  // Re-run after view transitions
  document.addEventListener('astro:after-swap', initReadMore);
</script>
