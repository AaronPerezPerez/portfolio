---
import { skills, currentFocus, techDetails } from '../lib/data';
import SectionTitle from './ui/SectionTitle.astro';
import NeonCard from './ui/NeonCard.astro';
import TechTag from './ui/TechTag.astro';

const skillCategories = Object.entries(skills);
---

<section id="skills" class="section skills-section">
  <div class="container">
    <SectionTitle title="Tech Stack" />

    <div class="skills-container">
      <!-- Main skills grid -->
      <div class="skills-grid">
        {skillCategories.map(([key, category], index) => (
          <NeonCard
            variant={key === 'core' ? 'featured' : 'default'}
            delay={index * 80}
            class={`skill-category ${key === 'core' ? 'featured' : ''} reveal`}
          >
            <div class="category-header">
              <span class="category-icon">{category.icon}</span>
              <h3 class="category-label">{category.label}</h3>
            </div>

            <div class="category-items">
              {category.items.map((item) => {
                const details = techDetails[item];
                return (
                  <TechTag
                    name={item}
                    icon={details?.icon}
                    color={details?.color}
                    size="lg"
                    highlight={key === 'core'}
                  />
                );
              })}
            </div>
          </NeonCard>
        ))}
      </div>

      <!-- Currently Focusing On -->
      <NeonCard variant="magenta" class="focus-section reveal delay-6">
        <div class="focus-header">
          <span class="focus-prefix">//</span>
          <span class="focus-label">CURRENTLY_FOCUSING_ON</span>
        </div>
        <div class="focus-items">
          {currentFocus.map((item) => (
            <TechTag name={item} size="md" color="#ff00ff" />
          ))}
        </div>
      </NeonCard>
    </div>
  </div>
</section>

<style>
  .skills-section {
    background: linear-gradient(
      180deg,
      var(--color-bg-primary) 0%,
      var(--color-bg-secondary) 100%
    );
  }

  .skills-container {
    max-width: 900px;
    margin: 0 auto;
  }

  /* Skills grid */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-bottom: 40px;
  }

  /* Featured (Daily Driver) spans full width */
  .skill-category.featured {
    grid-column: span 2;
  }

  /* Category header */
  .category-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }

  .category-icon {
    font-size: 1.2rem;
    color: var(--color-neon-cyan);
    text-shadow: 0 0 8px rgba(0, 255, 247, 0.4);
  }

  .category-label {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0;
  }

  .skill-category.featured .category-label {
    color: var(--color-neon-cyan);
  }

  /* Skill tags container */
  .category-items {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* Focus section */
  .focus-section {
    position: relative;
    overflow: hidden;
  }

  .focus-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--color-neon-magenta),
      var(--color-neon-cyan),
      var(--color-neon-magenta)
    );
  }

  .focus-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }

  .focus-prefix {
    color: var(--color-neon-green);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .focus-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-muted);
    letter-spacing: 2px;
  }

  .focus-items {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }

    .skill-category.featured {
      grid-column: span 1;
    }

    .focus-items {
      flex-direction: column;
    }
  }
</style>
