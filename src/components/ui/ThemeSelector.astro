---
// Import theme data from centralized config (SINGLE SOURCE OF TRUTH)
import { baseThemes, gamingThemes } from '../../scripts/modules/theme/theme-config';
---

<div class="theme-selector" data-theme-selector>
  <div class="toggle-wrapper">
    <button class="theme-toggle" aria-label="Select theme (T)" aria-expanded="false">
      <span class="toggle-icon">🎨</span>
      <span class="toggle-text">THEME</span>
      <svg class="chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </button>
    <kbd class="shortcut-hint">T</kbd>
  </div>

  <div class="theme-dropdown" aria-hidden="true">
    <div class="dropdown-header">
      <span class="header-prompt">&gt;</span>
      <span class="header-text">SELECT_THEME</span>
    </div>

    <!-- Tab Navigation -->
    <div class="tab-nav" role="tablist">
      <button
        class="tab-button active"
        data-tab="general"
        role="tab"
        aria-selected="true"
        aria-controls="panel-general"
      >
        <span class="tab-icon">🎨</span>
        <span class="tab-label">GENERAL</span>
        <span class="tab-count">{baseThemes.length}</span>
      </button>
      <button
        class="tab-button"
        data-tab="gaming"
        role="tab"
        aria-selected="false"
        aria-controls="panel-gaming"
      >
        <span class="tab-icon">🕹️</span>
        <span class="tab-label">GAMING</span>
        <span class="tab-count">{gamingThemes.length}</span>
      </button>
    </div>

    <!-- Tab Panels -->
    <div class="tab-panels">
      <div class="tab-panel active" id="panel-general" data-panel="general" role="tabpanel">
        <div class="theme-list">
          {baseThemes.map((theme) => (
            <button
              class="theme-option"
              data-theme-id={theme.id}
              data-category="general"
              aria-label={`Switch to ${theme.name} theme`}
            >
              <span class="theme-icon">{theme.icon}</span>
              <span class="theme-name">{theme.name}</span>
              <div class="theme-preview">
                {theme.colors.map((color) => (
                  <span class="color-swatch" style={`background-color: ${color};`}></span>
                ))}
              </div>
              <span class="theme-check">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </span>
            </button>
          ))}
        </div>
      </div>

      <div class="tab-panel" id="panel-gaming" data-panel="gaming" role="tabpanel">
        <div class="theme-list">
          {gamingThemes.map((theme) => (
            <button
              class="theme-option"
              data-theme-id={theme.id}
              data-category="gaming"
              aria-label={`Switch to ${theme.name} theme`}
            >
              <span class="theme-icon">{theme.icon}</span>
              <span class="theme-name">{theme.name}</span>
              <div class="theme-preview">
                {theme.colors.map((color) => (
                  <span class="color-swatch" style={`background-color: ${color};`}></span>
                ))}
              </div>
              <span class="theme-check">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </span>
            </button>
          ))}
        </div>
      </div>
    </div>

    <div class="dropdown-footer">
      <div class="keyboard-hints">
        <span class="hint"><kbd>←</kbd><kbd>→</kbd> tab</span>
        <span class="hint"><kbd>↑</kbd><kbd>↓</kbd> theme</span>
        <span class="hint"><kbd>↵</kbd> select</span>
        <span class="hint"><kbd>esc</kbd> close</span>
      </div>
      <span class="footer-text">// localStorage.theme</span>
    </div>
  </div>
</div>

<style>
  .theme-selector {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 1000;
    font-family: var(--font-mono);
  }

  /* Toggle wrapper */
  .toggle-wrapper {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Shortcut hint badge */
  .shortcut-hint {
    padding: 4px 8px;
    background: var(--color-bg-terminal);
    border: 1px solid rgba(0, 255, 247, 0.2);
    border-radius: 4px;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 10px;
    opacity: 0.7;
    transition: all 0.3s ease;
  }

  .toggle-wrapper:hover .shortcut-hint {
    opacity: 1;
    border-color: var(--color-neon-cyan);
    color: var(--color-neon-cyan);
  }

  /* Toggle button */
  .theme-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: var(--color-bg-terminal);
    border: 1px solid rgba(0, 255, 247, 0.3);
    border-radius: 6px;
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: 12px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .theme-toggle:hover {
    border-color: var(--color-neon-cyan);
    box-shadow: 0 0 15px rgba(0, 255, 247, 0.2);
  }

  .toggle-icon {
    font-size: 14px;
  }

  .toggle-text {
    color: var(--color-neon-cyan);
    letter-spacing: 1px;
  }

  .chevron {
    color: var(--color-text-muted);
    transition: transform 0.3s ease;
  }

  .theme-selector.open .chevron {
    transform: rotate(180deg);
  }

  /* Dropdown */
  .theme-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 280px;
    max-height: 600px;
    background: var(--color-bg-terminal);
    border: 1px solid var(--color-neon-cyan);
    border-radius: 8px;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-10px);
    transition: all 0.3s ease;
    box-shadow:
      0 0 20px rgba(0, 255, 247, 0.2),
      0 10px 40px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
  }

  .theme-selector.open .theme-dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  /* Dropdown header */
  .dropdown-header {
    padding: 12px 16px;
    border-bottom: 1px solid rgba(0, 255, 247, 0.2);
    font-size: 11px;
    letter-spacing: 2px;
    flex-shrink: 0;
  }

  .header-prompt {
    color: var(--color-neon-green);
  }

  .header-text {
    color: var(--color-text-muted);
    margin-left: 8px;
  }

  /* Tab Navigation */
  .tab-nav {
    display: flex;
    border-bottom: 1px solid rgba(0, 255, 247, 0.2);
    flex-shrink: 0;
  }

  .tab-button {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 12px;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tab-button:hover {
    background: rgba(0, 255, 247, 0.05);
    color: var(--color-text-secondary);
  }

  .tab-button.active {
    color: var(--color-neon-cyan);
    border-bottom-color: var(--color-neon-cyan);
    background: rgba(0, 255, 247, 0.08);
  }

  .tab-icon {
    font-size: 12px;
  }

  .tab-label {
    font-weight: 500;
  }

  .tab-count {
    padding: 2px 6px;
    background: rgba(0, 255, 247, 0.15);
    border-radius: 10px;
    font-size: 9px;
    color: var(--color-neon-cyan);
  }

  .tab-button.active .tab-count {
    background: var(--color-neon-cyan);
    color: var(--color-bg-primary);
  }

  /* Tab Panels */
  .tab-panels {
    flex: 1;
    overflow: hidden;
    max-height: 350px;
  }

  .tab-panel {
    display: none;
    max-height: 350px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--color-neon-cyan) rgba(0, 255, 247, 0.1);
  }

  .tab-panel::-webkit-scrollbar {
    width: 8px;
  }

  .tab-panel::-webkit-scrollbar-track {
    background: rgba(0, 255, 247, 0.05);
    border-radius: 4px;
  }

  .tab-panel::-webkit-scrollbar-thumb {
    background: var(--color-neon-cyan);
    border-radius: 4px;
  }

  .tab-panel::-webkit-scrollbar-thumb:hover {
    background: var(--color-neon-green);
  }

  .tab-panel.active {
    display: block;
  }

  /* Theme list */
  .theme-list {
    padding: 8px;
  }

  .theme-option {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 10px 12px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: 11px;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: left;
  }

  .theme-option:hover {
    background: rgba(0, 255, 247, 0.05);
    border-color: rgba(0, 255, 247, 0.2);
  }

  .theme-option.active {
    background: rgba(0, 255, 247, 0.1);
    border-color: var(--color-neon-cyan);
  }

  .theme-option.focused {
    background: rgba(0, 255, 247, 0.08);
    border-color: rgba(0, 255, 247, 0.4);
  }

  .theme-icon {
    font-size: 14px;
    width: 22px;
    text-align: center;
  }

  .theme-name {
    flex: 1;
    letter-spacing: 1px;
    font-weight: 500;
  }

  .theme-preview {
    display: flex;
    gap: 3px;
  }

  .color-swatch {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .theme-check {
    color: var(--color-neon-green);
    opacity: 0;
    transform: scale(0.5);
    transition: all 0.2s ease;
  }

  .theme-option.active .theme-check {
    opacity: 1;
    transform: scale(1);
  }

  /* Dropdown footer */
  .dropdown-footer {
    padding: 10px 16px;
    border-top: 1px solid rgba(0, 255, 247, 0.2);
    font-size: 10px;
    color: var(--color-text-muted);
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex-shrink: 0;
    background: var(--color-bg-terminal);
  }

  .keyboard-hints {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .keyboard-hints .hint {
    display: flex;
    align-items: center;
    gap: 3px;
    color: var(--color-text-muted);
  }

  .keyboard-hints kbd {
    padding: 2px 4px;
    background: var(--color-bg-card);
    border: 1px solid rgba(0, 255, 247, 0.2);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--color-neon-cyan);
  }

  .footer-text {
    opacity: 0.5;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .theme-selector {
      top: 15px;
      right: 15px;
    }

    .toggle-text,
    .shortcut-hint {
      display: none;
    }

    .theme-toggle {
      padding: 10px 12px;
    }

    .theme-dropdown {
      right: -5px;
      min-width: 260px;
      max-width: calc(100vw - 20px);
      max-height: 540px;
    }

    .keyboard-hints {
      display: none;
    }

    .tab-label {
      display: none;
    }

    .tab-button {
      padding: 8px 10px;
    }
  }
</style>

<script>
  import { initThemeSelectors } from '../../scripts/modules/theme';

  // Initialize theme selectors
  initThemeSelectors();
</script>
