---
// Theme definitions split by category
const baseThemes = [
  { id: 'cyberpunk', name: 'CYBERPUNK', icon: '⚡', colors: ['#00fff7', '#ff00ff', '#0a0a0f'] },
  { id: 'synthwave', name: 'SYNTHWAVE', icon: '🌅', colors: ['#ff2a6d', '#ff7f11', '#0f0e17'] },
  { id: 'matrix', name: 'MATRIX', icon: '💊', colors: ['#00ff41', '#00cc33', '#000000'] },
  { id: 'dracula', name: 'DRACULA', icon: '🧛', colors: ['#bd93f9', '#ff79c6', '#282a36'] },
  { id: 'nord', name: 'NORD', icon: '🌊', colors: ['#88c0d0', '#a3be8c', '#2e3440'] },
  { id: 'gruvbox', name: 'GRUVBOX', icon: '🔥', colors: ['#fe8019', '#fabd2f', '#282828'] },
  { id: 'tokyo', name: 'TOKYO NIGHT', icon: '🌃', colors: ['#7aa2f7', '#bb9af7', '#1a1b26'] },
  { id: 'fallout', name: 'FALLOUT', icon: '☢️', colors: ['#ffb000', '#cc8800', '#0a0a00'] },
  { id: 'crimson', name: 'CRIMSON', icon: '🩸', colors: ['#ff0033', '#cc0022', '#0a0000'] },
  { id: 'catppuccin', name: 'CATPPUCCIN', icon: '🐱', colors: ['#cba6f7', '#f5c2e7', '#1e1e2e'] },
  { id: 'sepia', name: 'SEPIA', icon: '🏜️', colors: ['#d4a574', '#cd7f32', '#1a1510'] },
];

const gamingThemes = [
  { id: 'gameboy', name: 'GAMEBOY', icon: '🎮', colors: ['#9bbc0f', '#8bac0f', '#0f380f'] },
  { id: 'nes', name: 'NES', icon: '🕹️', colors: ['#cc0000', '#a5a2a2', '#1a1a1a'] },
  { id: 'ps2', name: 'PS2', icon: '💿', colors: ['#006fcd', '#5cc9fb', '#0a0a12'] },
  { id: 'xbox', name: 'XBOX', icon: '🟢', colors: ['#107c10', '#9bc848', '#0d0d0d'] },
  { id: 'snes', name: 'SNES', icon: '🎲', colors: ['#4f43ae', '#b5b6e4', '#1a1a24'] },
  { id: 'c64', name: 'C64', icon: '💾', colors: ['#352879', '#70a4b2', '#1a1a4a'] },
  { id: 'msdos', name: 'MS-DOS', icon: '📟', colors: ['#00aaaa', '#aaaaaa', '#000000'] },
];
---

<div class="theme-selector" data-theme-selector>
  <div class="toggle-wrapper">
    <button class="theme-toggle" aria-label="Select theme (T)" aria-expanded="false">
      <span class="toggle-icon">🎨</span>
      <span class="toggle-text">THEME</span>
      <svg class="chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </button>
    <kbd class="shortcut-hint">T</kbd>
  </div>

  <div class="theme-dropdown" aria-hidden="true">
    <div class="dropdown-header">
      <span class="header-prompt">&gt;</span>
      <span class="header-text">SELECT_THEME</span>
    </div>

    <!-- Tab Navigation -->
    <div class="tab-nav" role="tablist">
      <button
        class="tab-button active"
        data-tab="general"
        role="tab"
        aria-selected="true"
        aria-controls="panel-general"
      >
        <span class="tab-icon">🎨</span>
        <span class="tab-label">GENERAL</span>
        <span class="tab-count">{baseThemes.length}</span>
      </button>
      <button
        class="tab-button"
        data-tab="gaming"
        role="tab"
        aria-selected="false"
        aria-controls="panel-gaming"
      >
        <span class="tab-icon">🕹️</span>
        <span class="tab-label">GAMING</span>
        <span class="tab-count">{gamingThemes.length}</span>
      </button>
    </div>

    <!-- Tab Panels -->
    <div class="tab-panels">
      <div class="tab-panel active" id="panel-general" data-panel="general" role="tabpanel">
        <div class="theme-list">
          {baseThemes.map((theme) => (
            <button
              class="theme-option"
              data-theme-id={theme.id}
              data-category="general"
              aria-label={`Switch to ${theme.name} theme`}
            >
              <span class="theme-icon">{theme.icon}</span>
              <span class="theme-name">{theme.name}</span>
              <div class="theme-preview">
                {theme.colors.map((color) => (
                  <span class="color-swatch" style={`background-color: ${color};`}></span>
                ))}
              </div>
              <span class="theme-check">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </span>
            </button>
          ))}
        </div>
      </div>

      <div class="tab-panel" id="panel-gaming" data-panel="gaming" role="tabpanel">
        <div class="theme-list">
          {gamingThemes.map((theme) => (
            <button
              class="theme-option"
              data-theme-id={theme.id}
              data-category="gaming"
              aria-label={`Switch to ${theme.name} theme`}
            >
              <span class="theme-icon">{theme.icon}</span>
              <span class="theme-name">{theme.name}</span>
              <div class="theme-preview">
                {theme.colors.map((color) => (
                  <span class="color-swatch" style={`background-color: ${color};`}></span>
                ))}
              </div>
              <span class="theme-check">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </span>
            </button>
          ))}
        </div>
      </div>
    </div>

    <div class="dropdown-footer">
      <div class="keyboard-hints">
        <span class="hint"><kbd>←</kbd><kbd>→</kbd> tab</span>
        <span class="hint"><kbd>↑</kbd><kbd>↓</kbd> theme</span>
        <span class="hint"><kbd>↵</kbd> select</span>
        <span class="hint"><kbd>esc</kbd> close</span>
      </div>
      <span class="footer-text">// localStorage.theme</span>
    </div>
  </div>
</div>

<style>
  .theme-selector {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 1000;
    font-family: var(--font-mono);
  }

  /* Toggle wrapper */
  .toggle-wrapper {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Shortcut hint badge */
  .shortcut-hint {
    padding: 4px 8px;
    background: var(--color-bg-terminal);
    border: 1px solid rgba(0, 255, 247, 0.2);
    border-radius: 4px;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 10px;
    opacity: 0.7;
    transition: all 0.3s ease;
  }

  .toggle-wrapper:hover .shortcut-hint {
    opacity: 1;
    border-color: var(--color-neon-cyan);
    color: var(--color-neon-cyan);
  }

  /* Toggle button */
  .theme-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: var(--color-bg-terminal);
    border: 1px solid rgba(0, 255, 247, 0.3);
    border-radius: 6px;
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: 12px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .theme-toggle:hover {
    border-color: var(--color-neon-cyan);
    box-shadow: 0 0 15px rgba(0, 255, 247, 0.2);
  }

  .toggle-icon {
    font-size: 14px;
  }

  .toggle-text {
    color: var(--color-neon-cyan);
    letter-spacing: 1px;
  }

  .chevron {
    color: var(--color-text-muted);
    transition: transform 0.3s ease;
  }

  .theme-selector.open .chevron {
    transform: rotate(180deg);
  }

  /* Dropdown */
  .theme-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 280px;
    max-height: 600px;
    background: var(--color-bg-terminal);
    border: 1px solid var(--color-neon-cyan);
    border-radius: 8px;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-10px);
    transition: all 0.3s ease;
    box-shadow:
      0 0 20px rgba(0, 255, 247, 0.2),
      0 10px 40px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
  }

  .theme-selector.open .theme-dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  /* Dropdown header */
  .dropdown-header {
    padding: 12px 16px;
    border-bottom: 1px solid rgba(0, 255, 247, 0.2);
    font-size: 11px;
    letter-spacing: 2px;
    flex-shrink: 0;
  }

  .header-prompt {
    color: var(--color-neon-green);
  }

  .header-text {
    color: var(--color-text-muted);
    margin-left: 8px;
  }

  /* Tab Navigation */
  .tab-nav {
    display: flex;
    border-bottom: 1px solid rgba(0, 255, 247, 0.2);
    flex-shrink: 0;
  }

  .tab-button {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 12px;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tab-button:hover {
    background: rgba(0, 255, 247, 0.05);
    color: var(--color-text-secondary);
  }

  .tab-button.active {
    color: var(--color-neon-cyan);
    border-bottom-color: var(--color-neon-cyan);
    background: rgba(0, 255, 247, 0.08);
  }

  .tab-icon {
    font-size: 12px;
  }

  .tab-label {
    font-weight: 500;
  }

  .tab-count {
    padding: 2px 6px;
    background: rgba(0, 255, 247, 0.15);
    border-radius: 10px;
    font-size: 9px;
    color: var(--color-neon-cyan);
  }

  .tab-button.active .tab-count {
    background: var(--color-neon-cyan);
    color: var(--color-bg-primary);
  }

  /* Tab Panels */
  .tab-panels {
    flex: 1;
    overflow: hidden;
    max-height: 350px;
  }

  .tab-panel {
    display: none;
    max-height: 350px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--color-neon-cyan) rgba(0, 255, 247, 0.1);
  }

  .tab-panel::-webkit-scrollbar {
    width: 8px;
  }

  .tab-panel::-webkit-scrollbar-track {
    background: rgba(0, 255, 247, 0.05);
    border-radius: 4px;
  }

  .tab-panel::-webkit-scrollbar-thumb {
    background: var(--color-neon-cyan);
    border-radius: 4px;
  }

  .tab-panel::-webkit-scrollbar-thumb:hover {
    background: var(--color-neon-green);
  }

  .tab-panel.active {
    display: block;
  }

  /* Theme list */
  .theme-list {
    padding: 8px;
  }

  .theme-option {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 10px 12px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: 11px;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: left;
  }

  .theme-option:hover {
    background: rgba(0, 255, 247, 0.05);
    border-color: rgba(0, 255, 247, 0.2);
  }

  .theme-option.active {
    background: rgba(0, 255, 247, 0.1);
    border-color: var(--color-neon-cyan);
  }

  .theme-option.focused {
    background: rgba(0, 255, 247, 0.08);
    border-color: rgba(0, 255, 247, 0.4);
  }

  .theme-icon {
    font-size: 14px;
    width: 22px;
    text-align: center;
  }

  .theme-name {
    flex: 1;
    letter-spacing: 1px;
    font-weight: 500;
  }

  .theme-preview {
    display: flex;
    gap: 3px;
  }

  .color-swatch {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .theme-check {
    color: var(--color-neon-green);
    opacity: 0;
    transform: scale(0.5);
    transition: all 0.2s ease;
  }

  .theme-option.active .theme-check {
    opacity: 1;
    transform: scale(1);
  }

  /* Dropdown footer */
  .dropdown-footer {
    padding: 10px 16px;
    border-top: 1px solid rgba(0, 255, 247, 0.2);
    font-size: 10px;
    color: var(--color-text-muted);
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex-shrink: 0;
    background: var(--color-bg-terminal);
  }

  .keyboard-hints {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .keyboard-hints .hint {
    display: flex;
    align-items: center;
    gap: 3px;
    color: var(--color-text-muted);
  }

  .keyboard-hints kbd {
    padding: 2px 4px;
    background: var(--color-bg-card);
    border: 1px solid rgba(0, 255, 247, 0.2);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--color-neon-cyan);
  }

  .footer-text {
    opacity: 0.5;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .theme-selector {
      top: 15px;
      right: 15px;
    }

    .toggle-text,
    .shortcut-hint {
      display: none;
    }

    .theme-toggle {
      padding: 10px 12px;
    }

    .theme-dropdown {
      right: -5px;
      min-width: 260px;
      max-width: calc(100vw - 20px);
      max-height: 540px;
    }

    .keyboard-hints {
      display: none;
    }

    .tab-label {
      display: none;
    }

    .tab-button {
      padding: 8px 10px;
    }
  }
</style>

<script>
  class ThemeSelector {
    private selector: HTMLElement;
    private toggle: HTMLButtonElement;
    private dropdown: HTMLElement;
    private tabButtons: NodeListOf<HTMLButtonElement>;
    private tabPanels: NodeListOf<HTMLElement>;
    private isOpen: boolean = false;
    private focusedIndex: number = -1;
    private currentTab: 'general' | 'gaming' = 'general';

    // Theme categories for navigation
    private readonly gamingThemes = ['gameboy', 'nes', 'ps2', 'xbox', 'snes', 'c64', 'msdos'];

    constructor(element: HTMLElement) {
      this.selector = element;
      this.toggle = element.querySelector('.theme-toggle')!;
      this.dropdown = element.querySelector('.theme-dropdown')!;
      this.tabButtons = element.querySelectorAll('.tab-button');
      this.tabPanels = element.querySelectorAll('.tab-panel');

      this.init();
    }

    private init() {
      // Set initial active theme and correct tab
      const currentTheme = this.getCurrentTheme();
      this.setActiveOption(currentTheme);
      this.setInitialTab(currentTheme);

      // Toggle dropdown
      this.toggle.addEventListener('click', () => this.toggleDropdown());

      // Tab clicks
      this.tabButtons.forEach(button => {
        button.addEventListener('click', () => {
          const tab = button.dataset.tab as 'general' | 'gaming';
          this.switchTab(tab);
        });
      });

      // Theme option clicks
      this.getAllOptions().forEach(option => {
        option.addEventListener('click', () => {
          const themeId = option.dataset.themeId;
          if (themeId) {
            this.setTheme(themeId);
            this.closeDropdown();
          }
        });
      });

      // Close on outside click
      document.addEventListener('click', (e) => {
        if (!this.selector.contains(e.target as Node)) {
          this.closeDropdown();
        }
      });

      // Keyboard navigation
      document.addEventListener('keydown', (e) => {
        // Global shortcut "T" to toggle theme selector
        if (e.key.toLowerCase() === 't' && !this.isTyping(e)) {
          e.preventDefault();
          this.toggleDropdown();
          return;
        }

        if (!this.isOpen) return;

        switch (e.key) {
          case 'Escape':
            this.closeDropdown();
            this.toggle.focus();
            break;
          case 'ArrowDown':
            e.preventDefault();
            this.navigateOptions(1);
            break;
          case 'ArrowUp':
            e.preventDefault();
            this.navigateOptions(-1);
            break;
          case 'ArrowLeft':
            e.preventDefault();
            this.switchTab('general');
            break;
          case 'ArrowRight':
            e.preventDefault();
            this.switchTab('gaming');
            break;
          case 'Enter':
            e.preventDefault();
            this.closeDropdown();
            this.toggle.focus();
            break;
        }
      });
    }

    private isTyping(e: KeyboardEvent): boolean {
      const target = e.target as HTMLElement;
      const tagName = target.tagName.toLowerCase();
      return tagName === 'input' || tagName === 'textarea' || target.isContentEditable;
    }

    private getAllOptions(): NodeListOf<HTMLButtonElement> {
      return this.selector.querySelectorAll('.theme-option');
    }

    private getCurrentTabOptions(): HTMLButtonElement[] {
      const panel = this.selector.querySelector(`.tab-panel[data-panel="${this.currentTab}"]`);
      return Array.from(panel?.querySelectorAll('.theme-option') || []);
    }

    private setInitialTab(themeId: string) {
      if (this.gamingThemes.includes(themeId)) {
        this.switchTab('gaming', false);
      } else {
        this.switchTab('general', false);
      }
    }

    private switchTab(tab: 'general' | 'gaming', resetFocus = true) {
      if (this.currentTab === tab) return;

      this.currentTab = tab;

      // Update tab buttons
      this.tabButtons.forEach(button => {
        const isActive = button.dataset.tab === tab;
        button.classList.toggle('active', isActive);
        button.setAttribute('aria-selected', String(isActive));
      });

      // Update panels
      this.tabPanels.forEach(panel => {
        const isActive = panel.dataset.panel === tab;
        panel.classList.toggle('active', isActive);
      });

      // Reset focus index when switching tabs
      if (resetFocus) {
        this.focusedIndex = -1;
        this.clearFocusedState();
      }
    }

    private navigateOptions(direction: number) {
      const options = this.getCurrentTabOptions();
      const totalOptions = options.length;

      if (totalOptions === 0) return;

      // Clear previous focused state
      this.clearFocusedState();

      // If no option is focused, find current active and move from there
      if (this.focusedIndex === -1) {
        const currentTheme = this.getCurrentTheme();
        const activeIndex = options.findIndex(opt => opt.dataset.themeId === currentTheme);

        if (activeIndex !== -1) {
          // Start from current theme and move in direction
          this.focusedIndex = (activeIndex + direction + totalOptions) % totalOptions;
        } else {
          // No active theme in this tab, start at beginning or end
          this.focusedIndex = direction === 1 ? 0 : totalOptions - 1;
        }
      } else {
        // Already navigating, move in direction
        this.focusedIndex = (this.focusedIndex + direction + totalOptions) % totalOptions;
      }

      // Get the theme ID and apply it
      const option = options[this.focusedIndex];
      const themeId = option.dataset.themeId;

      if (themeId) {
        this.setTheme(themeId);
        option.classList.add('focused');
        option.scrollIntoView({ block: 'nearest' });
      }
    }

    private clearFocusedState() {
      this.getAllOptions().forEach(opt => opt.classList.remove('focused'));
    }

    private getCurrentTheme(): string {
      return document.documentElement.dataset.theme || 'cyberpunk';
    }

    private setTheme(themeId: string) {
      document.documentElement.classList.remove('no-transitions');
      document.documentElement.dataset.theme = themeId;
      localStorage.setItem('theme', themeId);

      const themeColors: Record<string, string> = {
        // Base themes
        cyberpunk: '#0a0a0f',
        synthwave: '#0f0e17',
        matrix: '#000000',
        dracula: '#282a36',
        nord: '#2e3440',
        gruvbox: '#282828',
        tokyo: '#1a1b26',
        fallout: '#0a0a00',
        crimson: '#0a0000',
        catppuccin: '#1e1e2e',
        sepia: '#1a1510',
        // Gaming themes
        gameboy: '#0f380f',
        nes: '#1a1a1a',
        ps2: '#0a0a12',
        xbox: '#0d0d0d',
        snes: '#1a1a24',
        c64: '#1a1a4a',
        msdos: '#000000'
      };

      const metaTheme = document.querySelector('meta[name="theme-color"]');
      if (metaTheme) {
        metaTheme.setAttribute('content', themeColors[themeId] || '#0a0a0f');
      }

      this.setActiveOption(themeId);
    }

    private setActiveOption(themeId: string) {
      this.getAllOptions().forEach(option => {
        option.classList.toggle('active', option.dataset.themeId === themeId);
      });
    }

    private toggleDropdown() {
      this.isOpen ? this.closeDropdown() : this.openDropdown();
    }

    private openDropdown() {
      this.isOpen = true;
      this.focusedIndex = -1;
      this.clearFocusedState();

      // Switch to correct tab based on current theme
      const currentTheme = this.getCurrentTheme();
      this.setInitialTab(currentTheme);

      this.selector.classList.add('open');
      this.toggle.setAttribute('aria-expanded', 'true');
      this.dropdown.setAttribute('aria-hidden', 'false');
    }

    private closeDropdown() {
      this.isOpen = false;
      this.clearFocusedState();
      this.selector.classList.remove('open');
      this.toggle.setAttribute('aria-expanded', 'false');
      this.dropdown.setAttribute('aria-hidden', 'true');
    }
  }

  // Initialize
  document.querySelectorAll('[data-theme-selector]').forEach(el => {
    new ThemeSelector(el as HTMLElement);
  });
</script>
