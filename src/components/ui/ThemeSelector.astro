---
// Import theme data from centralized config (SINGLE SOURCE OF TRUTH)
import { baseThemes, gamingThemes, customTheme } from '../../scripts/modules/theme/theme-config';

// Default custom colors for initial display
const defaultCustomColors = {
  primary: '#00fff7',
  secondary: '#ff00ff',
  background: '#0a0a0f',
};
---

<div class="theme-selector" data-theme-selector>
  <div class="toggle-wrapper">
    <button class="theme-toggle" aria-label="Select theme (T)" aria-expanded="false">
      <span class="toggle-icon">🎨</span>
      <span class="toggle-text">THEME</span>
      <svg class="chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </button>
    <kbd class="shortcut-hint">T</kbd>
  </div>

  <div class="theme-dropdown" aria-hidden="true">
    <div class="dropdown-header">
      <span class="header-prompt">&gt;</span>
      <span class="header-text">SELECT_THEME</span>
    </div>

    <!-- Tab Navigation -->
    <div class="tab-nav" role="tablist">
      <button
        class="tab-button active"
        data-tab="general"
        role="tab"
        aria-selected="true"
        aria-controls="panel-general"
      >
        <span class="tab-icon">🎨</span>
        <span class="tab-label">GENERAL</span>
        <span class="tab-count">{baseThemes.length}</span>
      </button>
      <button
        class="tab-button"
        data-tab="gaming"
        role="tab"
        aria-selected="false"
        aria-controls="panel-gaming"
      >
        <span class="tab-icon">🕹️</span>
        <span class="tab-label">GAMING</span>
        <span class="tab-count">{gamingThemes.length}</span>
      </button>
      <button
        class="tab-button"
        data-tab="custom"
        role="tab"
        aria-selected="false"
        aria-controls="panel-custom"
      >
        <span class="tab-icon">{customTheme.icon}</span>
        <span class="tab-label">CUSTOM</span>
      </button>
    </div>

    <!-- Tab Panels -->
    <div class="tab-panels">
      <div class="tab-panel active" id="panel-general" data-panel="general" role="tabpanel">
        <div class="theme-list">
          {baseThemes.map((theme) => (
            <button
              class="theme-option"
              data-theme-id={theme.id}
              data-category="general"
              aria-label={`Switch to ${theme.name} theme`}
            >
              <span class="theme-icon">{theme.icon}</span>
              <span class="theme-name">{theme.name}</span>
              <div class="theme-preview">
                {theme.colors.map((color) => (
                  <span class="color-swatch" style={`background-color: ${color};`}></span>
                ))}
              </div>
              <span class="theme-check">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </span>
            </button>
          ))}
        </div>
      </div>

      <div class="tab-panel" id="panel-gaming" data-panel="gaming" role="tabpanel">
        <div class="theme-list">
          {gamingThemes.map((theme) => (
            <button
              class="theme-option"
              data-theme-id={theme.id}
              data-category="gaming"
              aria-label={`Switch to ${theme.name} theme`}
            >
              <span class="theme-icon">{theme.icon}</span>
              <span class="theme-name">{theme.name}</span>
              <div class="theme-preview">
                {theme.colors.map((color) => (
                  <span class="color-swatch" style={`background-color: ${color};`}></span>
                ))}
              </div>
              <span class="theme-check">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </span>
            </button>
          ))}
        </div>
      </div>

      <div class="tab-panel" id="panel-custom" data-panel="custom" role="tabpanel">
        <div class="custom-theme-editor">
          <!-- PRIMARY color row -->
          <div class="color-row">
            <div class="color-label">
              <span class="label-name">PRIMARY</span>
              <span class="label-hint">// neon accent</span>
            </div>
            <div class="color-inputs">
              <div
                class="pickr-container"
                data-pickr="primary"
                data-default={defaultCustomColors.primary}
                aria-label="Primary color picker"
              ></div>
              <input
                type="text"
                class="hex-input"
                data-hex="primary"
                value={defaultCustomColors.primary}
                placeholder="#00fff7"
                maxlength="7"
                aria-label="Primary color hex code"
              />
            </div>
          </div>

          <!-- SECONDARY color row -->
          <div class="color-row">
            <div class="color-label">
              <span class="label-name">SECONDARY</span>
              <span class="label-hint">// accent 2</span>
            </div>
            <div class="color-inputs">
              <div
                class="pickr-container"
                data-pickr="secondary"
                data-default={defaultCustomColors.secondary}
                aria-label="Secondary color picker"
              ></div>
              <input
                type="text"
                class="hex-input"
                data-hex="secondary"
                value={defaultCustomColors.secondary}
                placeholder="#ff00ff"
                maxlength="7"
                aria-label="Secondary color hex code"
              />
            </div>
          </div>

          <!-- BACKGROUND color row -->
          <div class="color-row">
            <div class="color-label">
              <span class="label-name">BACKGROUND</span>
              <span class="label-hint">// base bg</span>
            </div>
            <div class="color-inputs">
              <div
                class="pickr-container"
                data-pickr="background"
                data-default={defaultCustomColors.background}
                aria-label="Background color picker"
              ></div>
              <input
                type="text"
                class="hex-input"
                data-hex="background"
                value={defaultCustomColors.background}
                placeholder="#0a0a0f"
                maxlength="7"
                aria-label="Background color hex code"
              />
            </div>
          </div>

          <!-- Preview swatches -->
          <div class="preview-section">
            <span class="preview-label">// preview</span>
            <div class="preview-swatches">
              <span
                class="preview-swatch"
                data-preview="primary"
                style={`background-color: ${defaultCustomColors.primary};`}
              ></span>
              <span
                class="preview-swatch"
                data-preview="secondary"
                style={`background-color: ${defaultCustomColors.secondary};`}
              ></span>
              <span
                class="preview-swatch"
                data-preview="background"
                style={`background-color: ${defaultCustomColors.background};`}
              ></span>
            </div>
          </div>

          <!-- Apply button -->
          <button class="apply-custom-theme" data-apply-custom>
            <span class="apply-icon">✓</span>
            <span class="apply-text">APPLY THEME</span>
          </button>
        </div>
      </div>
    </div>

    <div class="dropdown-footer">
      <div class="keyboard-hints">
        <span class="hint"><kbd>←</kbd><kbd>→</kbd> tab</span>
        <span class="hint"><kbd>↑</kbd><kbd>↓</kbd> theme</span>
        <span class="hint"><kbd>↵</kbd> select</span>
        <span class="hint"><kbd>esc</kbd> close</span>
      </div>
      <span class="footer-text">// localStorage.theme</span>
    </div>
  </div>
</div>

<style>
  .theme-selector {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 1000;
    font-family: var(--font-mono);
  }

  /* Toggle wrapper */
  .toggle-wrapper {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Shortcut hint badge */
  .shortcut-hint {
    padding: 4px 8px;
    background: var(--color-bg-terminal);
    border: 1px solid rgba(0, 255, 247, 0.2);
    border-radius: 4px;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 10px;
    opacity: 0.7;
    transition: all 0.3s ease;
  }

  .toggle-wrapper:hover .shortcut-hint {
    opacity: 1;
    border-color: var(--color-neon-cyan);
    color: var(--color-neon-cyan);
  }

  /* Toggle button */
  .theme-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: var(--color-bg-terminal);
    border: 1px solid rgba(0, 255, 247, 0.3);
    border-radius: 6px;
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: 12px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .theme-toggle:hover {
    border-color: var(--color-neon-cyan);
    box-shadow: 0 0 15px rgba(0, 255, 247, 0.2);
  }

  .toggle-icon {
    font-size: 14px;
  }

  .toggle-text {
    color: var(--color-neon-cyan);
    letter-spacing: 1px;
  }

  .chevron {
    color: var(--color-text-muted);
    transition: transform 0.3s ease;
  }

  .theme-selector.open .chevron {
    transform: rotate(180deg);
  }

  /* Dropdown */
  .theme-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 280px;
    max-height: 600px;
    background: var(--color-bg-terminal);
    border: 1px solid var(--color-neon-cyan);
    border-radius: 8px;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-10px);
    transition: all 0.3s ease;
    box-shadow:
      0 0 20px rgba(0, 255, 247, 0.2),
      0 10px 40px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
  }

  .theme-selector.open .theme-dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  /* Dropdown header */
  .dropdown-header {
    padding: 12px 16px;
    border-bottom: 1px solid rgba(0, 255, 247, 0.2);
    font-size: 11px;
    letter-spacing: 2px;
    flex-shrink: 0;
  }

  .header-prompt {
    color: var(--color-neon-green);
  }

  .header-text {
    color: var(--color-text-muted);
    margin-left: 8px;
  }

  /* Tab Navigation */
  .tab-nav {
    display: flex;
    border-bottom: 1px solid rgba(0, 255, 247, 0.2);
    flex-shrink: 0;
  }

  .tab-button {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 12px;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tab-button:hover {
    background: rgba(0, 255, 247, 0.05);
    color: var(--color-text-secondary);
  }

  .tab-button.active {
    color: var(--color-neon-cyan);
    border-bottom-color: var(--color-neon-cyan);
    background: rgba(0, 255, 247, 0.08);
  }

  .tab-icon {
    font-size: 12px;
  }

  .tab-label {
    font-weight: 500;
  }

  .tab-count {
    padding: 2px 6px;
    background: rgba(0, 255, 247, 0.15);
    border-radius: 10px;
    font-size: 9px;
    color: var(--color-neon-cyan);
  }

  .tab-button.active .tab-count {
    background: var(--color-neon-cyan);
    color: var(--color-bg-primary);
  }

  /* Tab Panels */
  .tab-panels {
    flex: 1;
    overflow: hidden;
    max-height: 450px;
  }

  .tab-panel {
    display: none;
    max-height: 450px;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--color-neon-cyan) rgba(0, 255, 247, 0.1);
  }

  .tab-panel::-webkit-scrollbar {
    width: 8px;
  }

  .tab-panel::-webkit-scrollbar-track {
    background: rgba(0, 255, 247, 0.05);
    border-radius: 4px;
  }

  .tab-panel::-webkit-scrollbar-thumb {
    background: var(--color-neon-cyan);
    border-radius: 4px;
  }

  .tab-panel::-webkit-scrollbar-thumb:hover {
    background: var(--color-neon-green);
  }

  .tab-panel.active {
    display: block;
  }

  /* Theme list */
  .theme-list {
    padding: 8px;
  }

  .theme-option {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 10px 12px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: 11px;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: left;
  }

  .theme-option:hover {
    background: rgba(0, 255, 247, 0.05);
    border-color: rgba(0, 255, 247, 0.2);
  }

  .theme-option.active {
    background: rgba(0, 255, 247, 0.1);
    border-color: var(--color-neon-cyan);
  }

  .theme-option.focused {
    background: rgba(0, 255, 247, 0.08);
    border-color: rgba(0, 255, 247, 0.4);
  }

  .theme-icon {
    font-size: 14px;
    width: 22px;
    text-align: center;
  }

  .theme-name {
    flex: 1;
    letter-spacing: 1px;
    font-weight: 500;
  }

  .theme-preview {
    display: flex;
    gap: 3px;
  }

  .color-swatch {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .theme-check {
    color: var(--color-neon-green);
    opacity: 0;
    transform: scale(0.5);
    transition: all 0.2s ease;
  }

  .theme-option.active .theme-check {
    opacity: 1;
    transform: scale(1);
  }

  /* Dropdown footer */
  .dropdown-footer {
    padding: 10px 16px;
    border-top: 1px solid rgba(0, 255, 247, 0.2);
    font-size: 10px;
    color: var(--color-text-muted);
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex-shrink: 0;
    background: var(--color-bg-terminal);
  }

  .keyboard-hints {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .keyboard-hints .hint {
    display: flex;
    align-items: center;
    gap: 3px;
    color: var(--color-text-muted);
  }

  .keyboard-hints kbd {
    padding: 2px 4px;
    background: var(--color-bg-card);
    border: 1px solid rgba(0, 255, 247, 0.2);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--color-neon-cyan);
  }

  .footer-text {
    opacity: 0.5;
  }

  /* Custom Theme Editor */
  .custom-theme-editor {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .color-row {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .color-label {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .label-name {
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--color-neon-cyan);
    font-weight: 600;
  }

  .label-hint {
    font-size: 10px;
    color: var(--color-text-muted);
  }

  .color-inputs {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .pickr-container {
    flex-shrink: 0;
  }

  .hex-input {
    flex: 1;
    padding: 8px 12px;
    background: var(--color-bg-secondary);
    border: 1px solid rgba(0, 255, 247, 0.2);
    border-radius: 4px;
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    transition: all 0.2s ease;
  }

  .hex-input::placeholder {
    color: var(--color-text-muted);
    opacity: 0.5;
  }

  .hex-input:focus {
    outline: none;
    border-color: var(--color-neon-cyan);
    box-shadow: 0 0 8px rgba(0, 255, 247, 0.2);
  }

  .hex-input.invalid {
    border-color: var(--color-neon-magenta);
    box-shadow: 0 0 8px rgba(255, 0, 255, 0.2);
  }

  /* Preview Section */
  .preview-section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 0;
    border-top: 1px solid rgba(0, 255, 247, 0.1);
  }

  .preview-label {
    font-size: 10px;
    color: var(--color-text-muted);
  }

  .preview-swatches {
    display: flex;
    gap: 6px;
  }

  .preview-swatch {
    width: 24px;
    height: 24px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .preview-swatch:hover {
    transform: scale(1.1);
    box-shadow: 0 0 10px rgba(0, 255, 247, 0.3);
  }

  /* Apply Button */
  .apply-custom-theme {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 16px;
    background: rgba(0, 255, 247, 0.1);
    border: 1px solid var(--color-neon-cyan);
    border-radius: 6px;
    color: var(--color-neon-cyan);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 2px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .apply-custom-theme:hover {
    background: rgba(0, 255, 247, 0.2);
    box-shadow: 0 0 15px rgba(0, 255, 247, 0.3);
  }

  .apply-custom-theme:active {
    transform: scale(0.98);
  }

  .apply-custom-theme.applied {
    background: var(--color-neon-green);
    border-color: var(--color-neon-green);
    color: var(--color-bg-primary);
  }

  .apply-icon {
    font-size: 14px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .theme-selector {
      top: 15px;
      right: 15px;
    }

    .toggle-text,
    .shortcut-hint {
      display: none;
    }

    .theme-toggle {
      padding: 10px 12px;
    }

    .theme-dropdown {
      right: -5px;
      min-width: 260px;
      max-width: calc(100vw - 20px);
      max-height: 540px;
    }

    .keyboard-hints {
      display: none;
    }

    .tab-label {
      display: none;
    }

    .tab-button {
      padding: 8px 10px;
    }

    /* Custom theme editor on mobile */
    .custom-theme-editor {
      padding: 12px;
      gap: 12px;
    }

    .label-hint {
      display: none;
    }

    .hex-input {
      padding: 6px 10px;
      font-size: 11px;
    }

    .preview-swatch {
      width: 20px;
      height: 20px;
    }

    .apply-custom-theme {
      padding: 10px 12px;
      font-size: 10px;
    }
  }
</style>

<script>
  import { initThemeSelectors } from '../../scripts/modules/theme';

  // Initialize theme selectors
  initThemeSelectors();
</script>
