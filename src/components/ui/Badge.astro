---
interface Props {
  label: string;
  icon?: string;
  variant?: 'yellow' | 'magenta' | 'cyan' | 'green';
  class?: string;
}

const {
  label,
  icon,
  variant = 'cyan',
  class: className
} = Astro.props;
---

<span class:list={["badge", variant, className]}>
  {icon && <span class="badge-icon" set:html={icon} />}
  <span class="badge-label">{label}</span>
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 4px 10px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.2s ease;
  }

  .badge-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
  }

  .badge-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  /* Cyan variant (default) */
  .badge.cyan {
    background: rgba(0, 255, 247, 0.1);
    border: 1px solid var(--color-neon-cyan);
    color: var(--color-neon-cyan);
  }

  /* Yellow variant */
  .badge.yellow {
    background: rgba(255, 215, 0, 0.1);
    border: 1px solid var(--color-neon-yellow);
    color: var(--color-neon-yellow);
  }

  .badge.yellow .badge-icon {
    color: var(--color-neon-yellow);
  }

  /* Magenta variant */
  .badge.magenta {
    background: rgba(255, 0, 255, 0.1);
    border: 1px solid var(--color-neon-magenta);
    color: var(--color-neon-magenta);
  }

  /* Green variant */
  .badge.green {
    background: rgba(0, 255, 136, 0.1);
    border: 1px solid var(--color-neon-green);
    color: var(--color-neon-green);
  }
</style>
