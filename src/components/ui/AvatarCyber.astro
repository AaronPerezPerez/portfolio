---
import HudFrame from './HudFrame.astro';

interface Props {
  realSrc?: string;
  showToggle?: boolean;
  githubUser?: string;
  birthday?: string; // Format: YYYY-MM-DD
}

const {
  realSrc = '/aaron.png',
  showToggle = true,
  githubUser = 'AaronPerezPerez',
  birthday = '1994-12-15'
} = Astro.props;

// Calculate age (LVL)
function calculateAge(birthDate: string): number {
  const birth = new Date(birthDate);
  const today = new Date();
  let age = today.getFullYear() - birth.getFullYear();
  const m = today.getMonth() - birth.getMonth();
  if (m < 0 || (m === 0 && today.getDate() < birth.getDate())) {
    age--;
  }
  return age;
}

const lvl = calculateAge(birthday);
---

<div class="avatar-cyber" data-avatar-cyber>
  <!-- Toggle Button -->
  {showToggle && (
    <button class="avatar-toggle" aria-label="Toggle avatar mode" data-avatar-toggle>
      <svg class="icon-photo" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
        <circle cx="8.5" cy="8.5" r="1.5"></circle>
        <polyline points="21 15 16 10 5 21"></polyline>
      </svg>
      <svg class="icon-user" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
    </button>
  )}

  <HudFrame showScanLine={true}>
    <!-- Avatar Images -->
    <div class="avatar-container" data-avatar-content>
      <!-- Glass reflection for 3D effect -->
      <div class="crt-reflection" aria-hidden="true"></div>

      <!-- Real Photo -->
      <img
        src={realSrc}
        alt="Aarón Pérez"
        class="avatar-image avatar-real"
        loading="eager"
      />

      <!-- Silhouette Placeholder -->
      <div class="avatar-image avatar-silhouette">
        <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="silhouetteGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" style="stop-color:var(--color-neon-cyan);stop-opacity:0.8" />
              <stop offset="100%" style="stop-color:var(--color-neon-magenta);stop-opacity:0.8" />
            </linearGradient>
            <filter id="glow">
              <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
              <feMerge>
                <feMergeNode in="coloredBlur"/>
                <feMergeNode in="SourceGraphic"/>
              </feMerge>
            </filter>
          </defs>
          <!-- Head -->
          <circle cx="100" cy="70" r="45" fill="url(#silhouetteGrad)" filter="url(#glow)" opacity="0.9"/>
          <!-- Body -->
          <path d="M40 200 L40 160 Q40 120 100 120 Q160 120 160 160 L160 200" fill="url(#silhouetteGrad)" filter="url(#glow)" opacity="0.9"/>
          <!-- Cyber lines -->
          <line x1="55" y1="60" x2="75" y2="60" stroke="var(--color-neon-cyan)" stroke-width="2" opacity="0.8"/>
          <line x1="125" y1="60" x2="145" y2="60" stroke="var(--color-neon-cyan)" stroke-width="2" opacity="0.8"/>
          <line x1="85" y1="85" x2="115" y2="85" stroke="var(--color-neon-magenta)" stroke-width="2" opacity="0.6"/>
          <!-- Data lines -->
          <line x1="60" y1="140" x2="80" y2="140" stroke="var(--color-neon-green)" stroke-width="1" opacity="0.5"/>
          <line x1="120" y1="140" x2="140" y2="140" stroke="var(--color-neon-green)" stroke-width="1" opacity="0.5"/>
          <line x1="70" y1="160" x2="130" y2="160" stroke="var(--color-neon-cyan)" stroke-width="1" opacity="0.4"/>
        </svg>
      </div>

      <!-- CRT RGB pixels overlay -->
      <div class="crt-pixels" aria-hidden="true"></div>

      <!-- Glitch overlay -->
      <div class="glitch-overlay" aria-hidden="true"></div>
    </div>

    <!-- HUD Panel Stats -->
    <div slot="panel">
      <div class="hud-panel-line">
        <span class="prompt">▸</span>
        <span class="label">SCANNING</span>
        <span class="hud-progress">
          <span class="hud-progress-bar"></span>
          <span class="hud-progress-bar"></span>
          <span class="hud-progress-bar"></span>
          <span class="hud-progress-bar"></span>
          <span class="hud-progress-bar"></span>
          <span class="hud-progress-bar"></span>
        </span>
      </div>
      <div class="hud-panel-line">
        <span class="prompt">▸</span>
        <span class="label">ID:</span>
        <span class="value">@{githubUser}</span>
      </div>
      <div class="hud-panel-line">
        <span class="prompt">▸</span>
        <span class="label">LVL:</span>
        <span class="value lvl-value">{lvl}</span>
      </div>
      <div class="hud-panel-line">
        <span class="prompt">▸</span>
        <span class="label">STATUS:</span>
        <span class="hud-status-dot"></span>
        <span class="value status-online">ONLINE</span>
      </div>
    </div>
  </HudFrame>

  <!-- Floating particles -->
  <div class="particles" aria-hidden="true">
    <span class="particle"></span>
    <span class="particle"></span>
    <span class="particle"></span>
    <span class="particle"></span>
  </div>
</div>

<style>
  .avatar-cyber {
    position: relative;
    width: 320px;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  /* Make HudFrame fill the height */
  .avatar-cyber :global(.hud-frame) {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .avatar-cyber :global(.hud-content) {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* Toggle Button */
  .avatar-toggle {
    position: absolute;
    top: -15px;
    right: -15px;
    z-index: 20;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-terminal);
    border: 1px solid var(--color-neon-cyan);
    border-radius: 50%;
    color: var(--color-neon-cyan);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .avatar-toggle:hover {
    background: rgba(0, 255, 247, 0.1);
    box-shadow: 0 0 15px var(--color-glow-cyan);
    transform: scale(1.1);
  }

  .avatar-toggle .icon-user {
    display: none;
  }

  .avatar-cyber.silhouette-mode .avatar-toggle .icon-photo {
    display: none;
  }

  .avatar-cyber.silhouette-mode .avatar-toggle .icon-user {
    display: block;
  }

  /* Avatar Container - CRT Effect */
  .avatar-container {
    position: relative;
    width: 100%;
    flex: 1;
    min-height: 200px;
    border-radius: 16px; /* Curved CRT corners */
    overflow: hidden;
    background: #000;
    /* 3D bulge effect - old TV curvature */
    box-shadow:
      inset 0 0 30px rgba(0, 0, 0, 0.5),
      0 4px 20px rgba(0, 0, 0, 0.4),
      0 0 0 3px rgba(30, 30, 30, 0.8),
      0 0 0 5px rgba(20, 20, 20, 0.9);
  }

  /* CRT curved screen effect - glass bulge */
  .avatar-container::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    border-radius: 16px;
    /* 3D curved glass effect */
    background: radial-gradient(
      ellipse 80% 60% at 50% 50%,
      transparent 0%,
      transparent 50%,
      rgba(0, 0, 0, 0.15) 70%,
      rgba(0, 0, 0, 0.4) 90%,
      rgba(0, 0, 0, 0.6) 100%
    );
    /* Glass highlight reflection */
    box-shadow:
      inset 0 0 80px rgba(0, 0, 0, 0.5),
      inset 2px 2px 20px rgba(255, 255, 255, 0.03);
  }

  /* Glass reflection highlight */
  .avatar-container .crt-reflection {
    position: absolute;
    top: 5%;
    left: 10%;
    width: 35%;
    height: 20%;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.08) 0%,
      rgba(255, 255, 255, 0.02) 50%,
      transparent 100%
    );
    border-radius: 50%;
    filter: blur(8px);
    z-index: 7;
    pointer-events: none;
  }

  /* CRT Scanlines - more visible */
  .avatar-container::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 6;
    pointer-events: none;
    border-radius: 16px;
    background: repeating-linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.3) 0px,
      rgba(0, 0, 0, 0.3) 2px,
      transparent 2px,
      transparent 4px
    );
    animation: crt-flicker 0.15s infinite;
  }

  @keyframes crt-flicker {
    0%, 100% { opacity: 0.9; }
    50% { opacity: 1; }
  }

  .avatar-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 16px;
    transition: opacity 0.4s ease;
    /* Slight saturation boost for CRT look */
    filter: saturate(1.1) contrast(1.05);
  }

  /* Real photo gets extra CRT treatment */
  .avatar-real {
    /* Subtle RGB shift for CRT color fringing */
    animation: crt-rgb-shift 4s ease-in-out infinite;
  }

  @keyframes crt-rgb-shift {
    0%, 100% {
      filter: saturate(1.1) contrast(1.05);
    }
    25% {
      filter: saturate(1.15) contrast(1.08) hue-rotate(1deg);
    }
    75% {
      filter: saturate(1.1) contrast(1.05) hue-rotate(-1deg);
    }
  }

  /* CRT RGB Pixels - subtle pixel grid */
  .crt-pixels {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
    border-radius: 16px;
    /* RGB subpixel pattern - lighter */
    background-image:
      repeating-linear-gradient(
        90deg,
        rgba(255, 0, 0, 0.06) 0px,
        rgba(255, 0, 0, 0.06) 2px,
        rgba(0, 255, 0, 0.06) 2px,
        rgba(0, 255, 0, 0.06) 4px,
        rgba(0, 100, 255, 0.06) 4px,
        rgba(0, 100, 255, 0.06) 6px
      ),
      repeating-linear-gradient(
        0deg,
        rgba(0, 0, 0, 0.08) 0px,
        rgba(0, 0, 0, 0.08) 1px,
        transparent 1px,
        transparent 3px
      );
    background-size: 6px 3px;
  }

  .avatar-silhouette {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-terminal);
    opacity: 0;
  }

  .avatar-silhouette svg {
    width: 80%;
    height: 80%;
  }

  .avatar-cyber.silhouette-mode .avatar-real {
    opacity: 0;
  }

  .avatar-cyber.silhouette-mode .avatar-silhouette {
    opacity: 1;
  }

  /* Glitch overlay */
  .glitch-overlay {
    position: absolute;
    inset: 0;
    background: transparent;
    animation: periodic-glitch 8s infinite;
    pointer-events: none;
  }

  @keyframes periodic-glitch {
    0%, 95%, 100% {
      clip-path: inset(0 0 0 0);
      transform: translate(0);
      opacity: 0;
    }
    96% {
      clip-path: inset(20% 0 30% 0);
      transform: translate(-3px, 0);
      background: var(--color-neon-cyan);
      opacity: 0.1;
    }
    97% {
      clip-path: inset(50% 0 20% 0);
      transform: translate(3px, 0);
      background: var(--color-neon-magenta);
      opacity: 0.1;
    }
    98% {
      clip-path: inset(10% 0 60% 0);
      transform: translate(-2px, 0);
      background: var(--color-neon-cyan);
      opacity: 0.05;
    }
  }

  /* LVL value styling */
  :global(.lvl-value) {
    color: var(--color-neon-magenta) !important;
    font-weight: 600;
  }

  :global(.status-online) {
    color: var(--color-neon-green) !important;
  }

  /* Particles */
  .particles {
    position: absolute;
    inset: -20px;
    pointer-events: none;
  }

  .particle {
    position: absolute;
    width: 4px;
    height: 4px;
    background: var(--color-neon-cyan);
    border-radius: 50%;
    opacity: 0;
    animation: float-particle 4s ease-in-out infinite;
  }

  .particle:nth-child(1) { top: 20%; left: -10px; animation-delay: 0s; }
  .particle:nth-child(2) { top: 50%; right: -10px; animation-delay: 1s; background: var(--color-neon-magenta); }
  .particle:nth-child(3) { top: 80%; left: -10px; animation-delay: 2s; background: var(--color-neon-green); }
  .particle:nth-child(4) { bottom: 20%; right: -10px; animation-delay: 3s; }

  @keyframes float-particle {
    0%, 100% {
      opacity: 0;
      transform: translateY(0) scale(0.5);
    }
    20% {
      opacity: 1;
      transform: translateY(-10px) scale(1);
    }
    80% {
      opacity: 1;
      transform: translateY(-30px) scale(1);
    }
    100% {
      opacity: 0;
      transform: translateY(-40px) scale(0.5);
    }
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .avatar-cyber {
      width: 280px;
    }
  }

  @media (max-width: 768px) {
    .avatar-cyber {
      width: 240px;
      margin: 0 auto;
    }

    .particles {
      display: none;
    }
  }
</style>

<script>
  class AvatarCyber {
    private container: HTMLElement;
    private toggle: HTMLButtonElement | null;
    private storageKey = 'avatar-mode';

    constructor(element: HTMLElement) {
      this.container = element;
      this.toggle = element.querySelector('[data-avatar-toggle]');

      this.init();
    }

    private init() {
      // Restore saved preference
      const savedMode = localStorage.getItem(this.storageKey);
      if (savedMode === 'silhouette') {
        this.container.classList.add('silhouette-mode');
      }

      // Toggle click handler
      this.toggle?.addEventListener('click', () => this.toggleMode());
    }

    private toggleMode() {
      const isSilhouette = this.container.classList.toggle('silhouette-mode');
      localStorage.setItem(this.storageKey, isSilhouette ? 'silhouette' : 'photo');
    }
  }

  // Initialize all avatar instances
  document.querySelectorAll('[data-avatar-cyber]').forEach(el => {
    new AvatarCyber(el as HTMLElement);
  });
</script>
