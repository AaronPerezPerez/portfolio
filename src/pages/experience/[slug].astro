---
import Layout from '../../layouts/Layout.astro';
import { experiences } from '../../lib/data';
import TechTag from '../../components/ui/TechTag.astro';
import Icon from '../../components/ui/Icon.astro';
import Badge from '../../components/ui/Badge.astro';
import ResponsiveImage from '../../components/ui/ResponsiveImage.astro';

export function getStaticPaths() {
  return experiences.map((exp) => ({
    params: { slug: exp.slug },
    props: { experience: exp },
  }));
}

const { experience } = Astro.props;
const exp = experience;

// Find adjacent experiences for navigation
const currentIndex = experiences.findIndex(e => e.slug === exp.slug);
const prevExp = currentIndex > 0 ? experiences[currentIndex - 1] : null;
const nextExp = currentIndex < experiences.length - 1 ? experiences[currentIndex + 1] : null;
---

<Layout title={`${exp.company} | Aaron Perez`} description={exp.description}>
  <div class="experience-page">
    <!-- Back navigation -->
    <nav class="back-nav" transition:animate="fade">
      <a href="/" class="back-link">
        <Icon name="arrow-left" size={20} />
        <span>Back to Timeline</span>
      </a>
    </nav>

    <!-- Header with morph transition -->
    <header class="experience-header" transition:name={`exp-card-${exp.slug}`}>
      <!-- FILA 1: Título transversal -->
      <div class="header-title-row">
        <h1 class="company-title" transition:name={`exp-title-${exp.slug}`}>
          <span class="company-bracket">{'{'}</span>
          <span class="company-name">{exp.company}</span>
          <span class="company-bracket">{'}'}</span>
        </h1>
        {exp.current && <Badge label="Active" variant="green" />}
        {exp.companyUrl && (
          <a
            href={exp.companyUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="company-link"
          >
            <Icon name="link" size={18} />
            Visit Website
          </a>
        )}
      </div>

      <!-- FILA 2: Grid de 3 columnas -->
      <div class="header-grid">
        <!-- Columna 1: Logo grande -->
        <div
          class="col-logo"
          style={`--logo-color: ${exp.logoColor}`}
          transition:name={`exp-logo-${exp.slug}`}
        >
          {exp.logo.startsWith('/') || exp.logo.startsWith('http') ? (
            <img src={exp.logo} alt={`${exp.company} logo`} class="logo-img" />
          ) : (
            <span class="logo-icon" set:html={exp.logo} />
          )}
        </div>

        <!-- Columna 2: Info -->
        <div class="col-info">
          <div class="role-badge" transition:name={`exp-role-${exp.slug}`}>
            <span class="role-prompt">&gt;</span>
            <span class="role-text">{exp.role}</span>
          </div>

          <div class="meta-info">
            <span class="meta-item" transition:name={`exp-location-${exp.slug}`}>
              <Icon name="location" size={16} />
              {exp.location}
            </span>
            <span class="meta-item" transition:name={`exp-date-${exp.slug}`}>
              <Icon name="calendar" size={16} />
              {exp.startDate} - {exp.endDate}
              {exp.duration && <span class="duration">({exp.duration})</span>}
            </span>
          </div>

          <p class="description" transition:name={`exp-desc-${exp.slug}`}>{exp.description}</p>
        </div>

        <!-- Columna 3: Tech Stack -->
        <div class="col-tech" transition:name={`exp-tech-${exp.slug}`}>
          <span class="tech-label">// Stack</span>
          <div class="technologies">
            {exp.technologies.map((tech: string) => (
              <TechTag name={tech} size="lg" />
            ))}
          </div>
        </div>
      </div>
    </header>

    <!-- Projects Section -->
    <section class="projects-section">
      <h2 class="section-title">
        <span class="title-prefix">//</span>
        Projects
        <span class="project-count">({exp.projects.length})</span>
      </h2>

      <div class="projects-grid">
        {exp.projects.map((project: any, index: number) => (
          <article
            class="project-card"
            style={`--delay: ${index * 100}ms`}
            transition:animate="slide"
          >
            {project.image && (
              <div class="project-image">
                <ResponsiveImage
                  src={project.image}
                  alt={project.name}
                  width={800}
                  height={450}
                  sizes="(max-width: 768px) 100vw, 600px"
                />
                <div class="image-overlay"></div>
              </div>
            )}

            <div class="project-content">
              <h3 class="project-name">{project.name}</h3>
              <p class="project-description">{project.description}</p>

              <div class="project-tech">
                {project.technologies.map((tech: string) => (
                  <TechTag name={tech} size="sm" />
                ))}
              </div>

              {project.url && (
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="project-link"
                >
                  <Icon name="link" size={14} />
                  View Project
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Navigation between experiences -->
    <nav class="experience-nav" transition:animate="fade">
      {prevExp ? (
        <a href={`/experience/${prevExp.slug}`} class="nav-link prev">
          <Icon name="arrow-left" size={20} />
          <div class="nav-content">
            <span class="nav-label">Previous</span>
            <span class="nav-company">{prevExp.company}</span>
          </div>
        </a>
      ) : (
        <div class="nav-placeholder"></div>
      )}

      {nextExp ? (
        <a href={`/experience/${nextExp.slug}`} class="nav-link next">
          <div class="nav-content">
            <span class="nav-label">Next</span>
            <span class="nav-company">{nextExp.company}</span>
          </div>
          <Icon name="arrow-right" size={20} />
        </a>
      ) : (
        <div class="nav-placeholder"></div>
      )}
    </nav>
  </div>
</Layout>

<style>
  .experience-page {
    min-height: 100vh;
    padding: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Back Navigation */
  .back-nav {
    margin-bottom: 2rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    padding: 0.5rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    transition: all 0.3s ease;
  }

  .back-link:hover {
    color: var(--color-neon-cyan);
    border-color: var(--color-neon-cyan);
    background: rgba(0, 255, 247, 0.1);
  }

  /* Header */
  .experience-header {
    background: var(--color-bg-terminal);
    border: 1px solid rgba(0, 255, 247, 0.3);
    border-radius: 16px;
    padding: 2.5rem;
    margin-bottom: 3rem;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .experience-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 6px;
    height: 100%;
    background: var(--logo-color, var(--color-neon-cyan));
  }

  /* FILA 1: Título transversal */
  .header-title-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .company-title {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .company-bracket {
    color: var(--color-neon-magenta);
    font-weight: 300;
  }

  .company-name {
    color: var(--color-text-primary);
  }

  .company-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.5rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    transition: all 0.3s ease;
    margin-left: auto;
  }

  .company-link:hover {
    color: var(--color-neon-cyan);
    border-color: var(--color-neon-cyan);
    background: rgba(0, 255, 247, 0.1);
  }

  /* FILA 2: Grid de 3 columnas */
  .header-grid {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 2.5rem;
    align-items: start;
  }

  /* Columna 1: Logo */
  .col-logo {
    width: 120px;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.05);
    border: 2px solid var(--logo-color, var(--color-neon-cyan));
    border-radius: 20px;
    flex-shrink: 0;
  }

  .col-logo .logo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 16px;
  }

  .col-logo .logo-icon {
    width: 72px;
    height: 72px;
    color: var(--logo-color, var(--color-text-primary));
  }

  .col-logo .logo-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  /* Columna 2: Info */
  .col-info {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .role-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 1.2rem;
  }

  .role-prompt {
    color: var(--color-neon-green);
    font-weight: 600;
  }

  .role-text {
    color: var(--color-neon-cyan);
  }

  .meta-info {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .meta-item :global(.icon) {
    color: var(--color-neon-cyan);
    opacity: 0.7;
  }

  .duration {
    color: var(--color-text-secondary);
    margin-left: 0.25rem;
  }

  .description {
    color: var(--color-text-secondary);
    font-size: 1rem;
    line-height: 1.7;
    margin: 0;
  }

  /* Columna 3: Tech Stack */
  .col-tech {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 180px;
  }

  .tech-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-neon-magenta);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .technologies {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  /* Projects Section */
  .projects-section {
    margin-bottom: 3rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: 1.8rem;
    color: var(--color-text-primary);
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .title-prefix {
    color: var(--color-neon-magenta);
    font-weight: 300;
  }

  .project-count {
    color: var(--color-text-muted);
    font-size: 1rem;
    font-weight: 400;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 1.5rem;
  }

  .project-card {
    background: var(--color-bg-terminal);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s ease;
    animation: slide-up 0.5s ease forwards;
    animation-delay: var(--delay);
    opacity: 0;
    transform: translateY(20px);
  }

  @keyframes slide-up {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .project-card:hover {
    border-color: var(--color-neon-cyan);
    box-shadow: 0 0 30px rgba(0, 255, 247, 0.15);
    transform: translateY(-5px);
  }

  .project-image {
    position: relative;
    height: 180px;
    overflow: hidden;
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .project-card:hover .project-image img {
    transform: scale(1.05);
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 50%,
      var(--color-bg-terminal)
    );
  }

  .project-content {
    padding: 1.5rem;
  }

  .project-name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--color-text-primary);
    margin: 0 0 0.75rem 0;
  }

  .project-description {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-neon-cyan);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    transition: all 0.2s ease;
  }

  .project-link:hover {
    text-shadow: 0 0 10px rgba(0, 255, 247, 0.5);
  }

  /* Experience Navigation */
  .experience-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
    background: var(--color-bg-terminal);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.3s ease;
    min-width: 200px;
  }

  .nav-link:hover {
    border-color: var(--color-neon-cyan);
    background: rgba(0, 255, 247, 0.05);
  }

  .nav-link :global(.icon) {
    color: var(--color-neon-cyan);
  }

  .nav-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .nav-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .nav-company {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-text-primary);
  }

  .nav-link.next {
    margin-left: auto;
    text-align: right;
  }

  .nav-placeholder {
    min-width: 200px;
  }

  /* Responsive */
  @media (max-width: 968px) {
    .header-grid {
      grid-template-columns: auto 1fr;
      gap: 1.5rem;
    }

    .col-tech {
      grid-column: 1 / -1;
    }

    .technologies {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  @media (max-width: 768px) {
    .experience-page {
      padding: 1rem;
    }

    .experience-header {
      padding: 1.5rem;
      gap: 1.5rem;
    }

    .header-title-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .company-title {
      font-size: 1.8rem;
    }

    .company-link {
      margin-left: 0;
    }

    .header-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .col-logo {
      width: 80px;
      height: 80px;
    }

    .col-logo .logo-icon {
      width: 48px;
      height: 48px;
    }

    .col-tech {
      grid-column: auto;
    }

    .role-badge {
      font-size: 1rem;
    }

    .meta-info {
      flex-direction: column;
      gap: 0.75rem;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }

    .experience-nav {
      flex-direction: column;
    }

    .nav-link {
      min-width: auto;
    }

    .nav-link.next {
      margin-left: 0;
      flex-direction: row-reverse;
      text-align: left;
    }
  }
</style>
