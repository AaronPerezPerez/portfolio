---
import Layout from '../../layouts/Layout.astro';

export const prerender = false;
---

<Layout title="Admin Panel | Aaron.chat" description="Admin panel for chat conversations">
  <!-- Login View with enhanced background -->
  <div class="min-h-screen flex items-center justify-center p-4" id="login-view">
    <div class="login-backdrop"></div>
    <div class="w-full max-w-md relative z-10">
      <div class="login-window">
        <div class="terminal-header">
          <span class="terminal-dot bg-red-500"></span>
          <span class="terminal-dot bg-yellow-500"></span>
          <span class="terminal-dot bg-green-500"></span>
          <span class="ml-4 text-xs opacity-70">admin.login</span>
        </div>
        <div class="p-6">
          <div class="flex items-center gap-2 mb-6">
            <span class="text-[var(--primary)]">&gt;</span>
            <span class="text-xl font-mono">AARON.ADMIN</span>
          </div>

          <form id="login-form" class="space-y-4">
            <div>
              <label class="block text-xs text-[var(--text-muted)] mb-2 font-mono">
                PASSWORD_
              </label>
              <input
                type="password"
                id="password-input"
                class="w-full bg-[var(--bg-secondary)] border border-[var(--border-color)] rounded px-4 py-3 font-mono text-[var(--text-primary)] focus:outline-none focus:border-[var(--primary)] transition-colors"
                placeholder="Enter admin password"
                autocomplete="current-password"
              />
            </div>

            <div id="login-error" class="hidden text-red-400 text-sm font-mono">
              <span class="text-red-500">[ERROR]</span> Invalid password
            </div>

            <button
              type="submit"
              class="w-full bg-[var(--primary)] text-[var(--bg-primary)] py-3 rounded font-mono font-semibold hover:opacity-90 transition-opacity flex items-center justify-center gap-2"
            >
              <span>&gt;</span>
              <span>AUTHENTICATE</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <div class="hidden min-h-screen pt-16" id="admin-view">
    <!-- Header with stats -->
    <header class="sticky top-0 z-40 bg-[var(--bg-primary)]/95 backdrop-blur border-b border-[var(--border-color)]">
      <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
        <div class="flex items-center gap-4">
          <span class="text-[var(--primary)]">&gt;</span>
          <span class="font-mono font-bold">AARON.ADMIN</span>
        </div>

        <div class="flex items-center gap-6 text-sm font-mono">
          <div class="flex items-center gap-2">
            <span class="text-[var(--text-muted)]">CONVERSATIONS:</span>
            <span id="stat-conversations" class="text-[var(--primary)]">--</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[var(--text-muted)]">MESSAGES:</span>
            <span id="stat-messages" class="text-[var(--primary)]">--</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[var(--text-muted)]">TODAY:</span>
            <span id="stat-today" class="text-[var(--secondary)]">--</span>
          </div>
          <button
            id="logout-btn"
            class="px-3 py-1 border border-[var(--border-color)] rounded hover:border-red-500 hover:text-red-500 transition-colors"
          >
            LOGOUT
          </button>
        </div>
      </div>
    </header>

    <!-- Main content -->
    <div class="max-w-7xl mx-auto flex" style="height: calc(100vh - 60px);">
      <!-- Sidebar: Conversation list -->
      <aside class="w-80 border-r border-[var(--border-color)] overflow-y-auto">
        <div class="p-4 border-b border-[var(--border-color)]">
          <div class="flex items-center gap-2 text-sm font-mono text-[var(--text-muted)]">
            <span class="text-[var(--primary)]">//</span>
            <span>CONVERSATIONS</span>
          </div>
        </div>
        <div id="conversations-list" class="divide-y divide-[var(--border-color)]">
          <!-- Conversations will be loaded here -->
          <div class="p-4 text-center text-[var(--text-muted)] font-mono text-sm">
            Loading...
          </div>
        </div>
      </aside>

      <!-- Main: Conversation detail -->
      <main class="flex-1 flex flex-col overflow-hidden">
        <div id="conversation-detail" class="flex-1 overflow-y-auto p-6">
          <div class="h-full flex items-center justify-center text-[var(--text-muted)] font-mono">
            <div class="text-center">
              <div class="text-4xl mb-4 opacity-20">&gt;_</div>
              <div>Select a conversation</div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>
</Layout>

<style is:global>
  /* Login backdrop - creates depth behind login window */
  .login-backdrop {
    position: fixed;
    inset: 0;
    background: radial-gradient(ellipse at center, var(--bg-secondary) 0%, transparent 70%);
    opacity: 0.8;
  }

  /* Login window with glassmorphism effect */
  .login-window {
    background: linear-gradient(
      135deg,
      rgba(var(--bg-secondary-rgb, 20, 20, 30), 0.95) 0%,
      rgba(var(--bg-tertiary-rgb, 30, 30, 45), 0.9) 100%
    );
    border: 1px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(var(--primary-rgb, 0, 255, 255), 0.1),
      0 8px 32px rgba(0, 0, 0, 0.4),
      0 0 60px rgba(var(--primary-rgb, 0, 255, 255), 0.05),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(20px);
    position: relative;
  }

  .login-window::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 12px;
    padding: 1px;
    background: linear-gradient(
      135deg,
      rgba(var(--primary-rgb, 0, 255, 255), 0.3) 0%,
      transparent 50%,
      rgba(var(--secondary-rgb, 255, 0, 255), 0.2) 100%
    );
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .terminal-header {
    background: rgba(var(--bg-tertiary-rgb, 30, 30, 45), 0.8);
    padding: 12px 16px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
  }

  .terminal-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    margin-right: 8px;
  }

  /* Conversation list items */
  .conversation-item {
    padding: 12px 16px;
    cursor: pointer;
    transition: all 0.2s ease;
    border-left: 3px solid transparent;
  }

  .conversation-item:hover {
    background: var(--color-bg-tertiary, rgba(255, 255, 255, 0.05));
    border-left-color: var(--color-neon-cyan);
    transform: translateX(2px);
  }

  .conversation-item.active {
    background: var(--color-bg-tertiary, rgba(255, 255, 255, 0.05));
    border-left-color: var(--color-neon-cyan);
  }

  /* Message styles - matching AI Chat widget exactly */
  .admin-message {
    display: flex;
    flex-direction: column;
    gap: 2px;
    max-width: 57%;
    margin-bottom: 12px;
  }

  .admin-message.user {
    align-self: flex-end;
    margin-left: auto;
  }

  .admin-message.assistant {
    align-self: flex-start;
  }

  .admin-message-meta {
    font-size: 10px;
    color: var(--color-text-muted);
    margin-bottom: 4px;
    font-family: var(--font-mono);
    opacity: 0.7;
  }

  .admin-message.user .admin-message-meta {
    text-align: right;
  }

  .admin-message-content {
    padding: 10px 14px;
    font-size: 13px;
    line-height: 1.5;
    word-break: break-word;
  }

  /* User bubble - solid cyan, right-aligned (same as chat) */
  .admin-message.user .admin-message-content {
    background: var(--color-neon-cyan);
    color: var(--color-bg-terminal);
    border-radius: 12px 12px 4px 12px;
    font-weight: 500;
  }

  /* Assistant bubble - terminal style with prompt (same as chat) */
  .admin-message.assistant .admin-message-content {
    background: rgba(0, 0, 0, 0.3);
    border-left: 2px solid var(--color-neon-green);
    color: var(--color-text-primary);
    border-radius: 0 8px 8px 0;
    padding-left: 12px;
  }

  .admin-message.assistant .admin-message-content::before {
    content: '>';
    color: var(--color-neon-green);
    margin-right: 6px;
    font-weight: bold;
  }
</style>

<script>
  class AdminPanel {
    private authenticated = false;
    private conversations: any[] = [];
    private selectedConversationId: number | null = null;

    constructor() {
      this.init();
    }

    private async init() {
      await this.checkAuth();
      this.setupEventListeners();
    }

    private setupEventListeners() {
      // Login form
      document.getElementById('login-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        this.login();
      });

      // Logout button
      document.getElementById('logout-btn')?.addEventListener('click', () => {
        this.logout();
      });
    }

    private async checkAuth() {
      try {
        const response = await fetch('/api/admin/auth');
        const data = await response.json();

        if (data.authenticated) {
          this.showAdminView();
          await this.loadConversations();
        } else {
          this.showLoginView();
        }
      } catch {
        this.showLoginView();
      }
    }

    private async login() {
      const passwordInput = document.getElementById('password-input') as HTMLInputElement;
      const errorEl = document.getElementById('login-error');
      const password = passwordInput?.value;

      if (!password) return;

      try {
        const response = await fetch('/api/admin/auth', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password })
        });

        if (response.ok) {
          errorEl?.classList.add('hidden');
          this.showAdminView();
          await this.loadConversations();
        } else {
          errorEl?.classList.remove('hidden');
          passwordInput.value = '';
          passwordInput.focus();
        }
      } catch {
        errorEl?.classList.remove('hidden');
      }
    }

    private async logout() {
      await fetch('/api/admin/auth', { method: 'DELETE' });
      this.showLoginView();
    }

    private showLoginView() {
      document.getElementById('login-view')?.classList.remove('hidden');
      document.getElementById('admin-view')?.classList.add('hidden');
      (document.getElementById('password-input') as HTMLInputElement)?.focus();
    }

    private showAdminView() {
      document.getElementById('login-view')?.classList.add('hidden');
      document.getElementById('admin-view')?.classList.remove('hidden');
    }

    private async loadConversations() {
      try {
        const response = await fetch('/api/admin/conversations');
        if (!response.ok) {
          if (response.status === 401) {
            this.showLoginView();
            return;
          }
          throw new Error('Failed to fetch');
        }

        const data = await response.json();
        this.conversations = data.conversations;
        this.updateStats(data.stats);
        this.renderConversationsList();
      } catch (error) {
        console.error('Failed to load conversations:', error);
      }
    }

    private updateStats(stats: { total_conversations: number; total_messages: number; messages_today: number }) {
      document.getElementById('stat-conversations')!.textContent = stats.total_conversations.toString();
      document.getElementById('stat-messages')!.textContent = stats.total_messages.toString();
      document.getElementById('stat-today')!.textContent = stats.messages_today.toString();
    }

    private renderConversationsList() {
      const container = document.getElementById('conversations-list')!;

      if (this.conversations.length === 0) {
        container.innerHTML = `
          <div class="p-4 text-center text-[var(--text-muted)] font-mono text-sm">
            No conversations yet
          </div>
        `;
        return;
      }

      container.innerHTML = this.conversations.map(conv => {
        const lastMessageAt = conv.last_message_at ? this.formatTimeAgo(conv.last_message_at) : 'No messages';
        const preview = conv.last_message ? this.truncate(conv.last_message, 50) : 'Empty conversation';
        const isActive = conv.id === this.selectedConversationId;
        const shortId = conv.user_id.substring(0, 8);

        return `
          <div class="conversation-item ${isActive ? 'active' : ''}" data-id="${conv.id}">
            <div class="flex items-center justify-between mb-1">
              <span class="font-mono text-sm text-[var(--primary)]">${shortId}...</span>
              <span class="text-xs text-[var(--text-muted)]">${lastMessageAt}</span>
            </div>
            <div class="text-sm text-[var(--text-muted)] truncate">${this.escapeHtml(preview)}</div>
            <div class="text-xs text-[var(--text-muted)] mt-1 flex items-center gap-1">
              <span class="text-[var(--secondary)]">${conv.message_count}</span>
              <span>messages</span>
            </div>
          </div>
        `;
      }).join('');

      // Add click handlers
      container.querySelectorAll('.conversation-item').forEach(item => {
        item.addEventListener('click', () => {
          const id = parseInt(item.getAttribute('data-id')!);
          this.selectConversation(id);
        });
      });
    }

    private async selectConversation(id: number) {
      this.selectedConversationId = id;
      this.renderConversationsList();

      const detailContainer = document.getElementById('conversation-detail')!;
      detailContainer.innerHTML = `
        <div class="h-full flex items-center justify-center text-[var(--text-muted)] font-mono">
          <div>Loading messages...</div>
        </div>
      `;

      try {
        const response = await fetch(`/api/admin/conversation/${id}`);
        if (!response.ok) throw new Error('Failed to fetch');

        const data = await response.json();
        this.renderConversationDetail(data.conversation, data.messages);
      } catch (error) {
        console.error('Failed to load conversation:', error);
        detailContainer.innerHTML = `
          <div class="h-full flex items-center justify-center text-red-400 font-mono">
            <div>Failed to load conversation</div>
          </div>
        `;
      }
    }

    private renderConversationDetail(conversation: any, messages: any[]) {
      const container = document.getElementById('conversation-detail')!;

      const header = `
        <div class="mb-6 pb-4 border-b border-[var(--border-color)]">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-[var(--primary)] font-mono">&gt;</span>
            <span class="font-mono font-semibold">User: ${conversation.user_id}</span>
          </div>
          <div class="text-sm text-[var(--text-muted)] font-mono">
            Started: ${this.formatDate(conversation.created_at)}
          </div>
        </div>
      `;

      const messagesHtml = messages.map(msg => `
        <div class="admin-message ${msg.role}">
          <div class="admin-message-meta">
            ${msg.role === 'user' ? 'USER' : 'AARON.AI'} · ${this.formatTime(msg.created_at)}
          </div>
          <div class="admin-message-content">${this.escapeHtml(msg.content)}</div>
        </div>
      `).join('');

      container.innerHTML = header + `<div>${messagesHtml}</div>`;
      container.scrollTop = container.scrollHeight;
    }

    private formatTimeAgo(dateStr: string): string {
      const date = new Date(dateStr + 'Z');
      const now = new Date();
      const diffMs = now.getTime() - date.getTime();
      const diffMins = Math.floor(diffMs / 60000);
      const diffHours = Math.floor(diffMs / 3600000);
      const diffDays = Math.floor(diffMs / 86400000);

      if (diffMins < 1) return 'Just now';
      if (diffMins < 60) return `${diffMins}m ago`;
      if (diffHours < 24) return `${diffHours}h ago`;
      if (diffDays < 7) return `${diffDays}d ago`;
      return date.toLocaleDateString();
    }

    private formatDate(dateStr: string): string {
      const date = new Date(dateStr + 'Z');
      return date.toLocaleString();
    }

    private formatTime(dateStr: string): string {
      const date = new Date(dateStr + 'Z');
      return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }

    private truncate(str: string, len: number): string {
      return str.length > len ? str.substring(0, len) + '...' : str;
    }

    private escapeHtml(str: string): string {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }
  }

  // Initialize when DOM is ready
  document.addEventListener('DOMContentLoaded', () => {
    new AdminPanel();
  });

  // Also handle Astro View Transitions
  document.addEventListener('astro:page-load', () => {
    new AdminPanel();
  });
</script>
