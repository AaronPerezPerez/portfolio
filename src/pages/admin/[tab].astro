---
import Layout from '../../layouts/Layout.astro';
import '../../styles/admin.css';

export const prerender = false;

const { tab } = Astro.params;
const validTabs = ['conversations', 'analytics', 'trash', 'settings', 'moderation'];

// Redirect invalid tabs
if (!validTabs.includes(tab || '')) {
  return Astro.redirect('/admin/conversations');
}

const currentTab = tab as 'conversations' | 'analytics' | 'trash' | 'settings' | 'moderation';
---

<Layout title="Admin Panel | Aaron.chat" description="Admin panel for chat conversations">
  <!-- Login View with enhanced background -->
  <div class="min-h-screen flex items-center justify-center p-4" id="login-view">
    <div class="login-backdrop"></div>
    <div class="w-full max-w-md relative z-10">
      <div class="login-window">
        <div class="terminal-header">
          <span class="terminal-dot bg-red-500"></span>
          <span class="terminal-dot bg-yellow-500"></span>
          <span class="terminal-dot bg-green-500"></span>
          <span class="ml-4 text-xs opacity-70">admin.login</span>
        </div>
        <div class="p-6">
          <div class="flex items-center gap-2 mb-6">
            <span class="text-[var(--primary)]">&gt;</span>
            <span class="text-xl font-mono">AARON.ADMIN</span>
          </div>

          <form id="login-form" class="space-y-4">
            <div>
              <label class="block text-xs text-[var(--text-muted)] mb-2 font-mono">
                PASSWORD_
              </label>
              <input
                type="password"
                id="password-input"
                class="w-full bg-[var(--bg-secondary)] border border-[var(--border-color)] rounded px-4 py-3 font-mono text-[var(--text-primary)] focus:outline-none focus:border-[var(--primary)] transition-colors"
                placeholder="Enter admin password"
                autocomplete="current-password"
              />
            </div>

            <div id="login-error" class="hidden text-red-400 text-sm font-mono">
              <span class="text-red-500">[ERROR]</span> Invalid password
            </div>

            <button
              type="submit"
              class="w-full bg-[var(--primary)] text-[var(--bg-primary)] py-3 rounded font-mono font-semibold hover:opacity-90 transition-opacity flex items-center justify-center gap-2"
            >
              <span>&gt;</span>
              <span>AUTHENTICATE</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <div class="hidden min-h-screen pt-16" id="admin-view">
    <!-- Header with stats -->
    <header class="sticky top-0 z-40 bg-[var(--bg-primary)]/95 backdrop-blur border-b border-[var(--border-color)]">
      <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
        <div class="flex items-center gap-4">
          <span class="text-[var(--primary)]">&gt;</span>
          <span class="font-mono font-bold">AARON.ADMIN</span>
        </div>

        <div class="flex items-center gap-6 text-sm font-mono">
          <div id="live-indicator" class="hidden items-center gap-2">
            <span class="live-dot"></span>
            <span id="live-count" class="text-[var(--color-neon-green)]">0</span>
            <span class="text-[var(--text-muted)]">LIVE</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[var(--text-muted)]">CONVERSATIONS:</span>
            <span id="stat-conversations" class="text-[var(--primary)]">--</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[var(--text-muted)]">MESSAGES:</span>
            <span id="stat-messages" class="text-[var(--primary)]">--</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[var(--text-muted)]">TODAY:</span>
            <span id="stat-today" class="text-[var(--secondary)]">--</span>
          </div>
          <button
            id="logout-btn"
            class="px-3 py-1 border border-[var(--border-color)] rounded hover:border-red-500 hover:text-red-500 transition-colors"
          >
            LOGOUT
          </button>
        </div>
      </div>
    </header>

    <!-- Tabs Navigation -->
    <nav class="max-w-7xl mx-auto px-4 border-b border-[var(--border-color)]">
      <div class="flex gap-1">
        <a
          href="/admin/conversations"
          class:list={[
            "tab-link",
            { "active": currentTab === 'conversations' }
          ]}
        >
          <span class="text-[var(--primary)]">//</span> CONVERSATIONS
        </a>
        <a
          href="/admin/analytics"
          class:list={[
            "tab-link",
            { "active": currentTab === 'analytics' }
          ]}
        >
          <span class="text-[var(--primary)]">//</span> ANALYTICS
        </a>
        <a
          href="/admin/trash"
          class:list={[
            "tab-link",
            { "active": currentTab === 'trash' }
          ]}
        >
          <span class="text-[var(--text-muted)]">//</span> TRASH
        </a>
        <a
          href="/admin/settings"
          class:list={[
            "tab-link",
            { "active": currentTab === 'settings' }
          ]}
        >
          <span class="text-[var(--primary)]">//</span> SETTINGS
        </a>
        <a
          href="/admin/moderation"
          class:list={[
            "tab-link",
            { "active": currentTab === 'moderation' }
          ]}
        >
          <span class="text-[var(--secondary)]">//</span> MODERATION
        </a>
      </div>
    </nav>

    <!-- Tab Content -->
    {currentTab === 'conversations' && (
      <div class="max-w-7xl mx-auto flex" style="height: calc(100vh - 120px);">
        <!-- Sidebar: Conversation list -->
        <aside class="w-80 border-r border-[var(--border-color)] overflow-y-auto">
          <!-- Search bar -->
          <div class="p-3 border-b border-[var(--border-color)] relative">
            <div class="relative">
              <input
                type="text"
                id="search-input"
                class="w-full bg-[var(--bg-secondary)] border border-[var(--border-color)] rounded px-3 py-2 pl-8 font-mono text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--primary)] transition-colors"
                placeholder="Search... (press /)"
              />
              <svg class="absolute left-2.5 top-1/2 -translate-y-1/2 w-4 h-4 text-[var(--text-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
            <!-- Search results dropdown -->
            <div id="search-results" class="hidden absolute left-3 right-3 top-full mt-1 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-lg shadow-lg max-h-80 overflow-y-auto z-50">
              <!-- Results populated by JS -->
            </div>
          </div>

          <!-- Filters panel -->
          <div class="border-b border-[var(--border-color)]">
            <button
              id="filters-toggle"
              class="w-full px-3 py-2 flex items-center justify-between text-xs font-mono text-[var(--text-muted)] hover:bg-[var(--bg-secondary)] transition-colors"
            >
              <span class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
                </svg>
                <span>FILTERS</span>
                <span id="active-filters-count" class="hidden px-1.5 py-0.5 bg-[var(--primary)] text-[var(--bg-primary)] rounded text-[10px]">0</span>
              </span>
              <svg id="filters-chevron" class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>

            <div id="filters-panel" class="hidden px-3 pb-3 space-y-3">
              <!-- Date filters -->
              <div class="space-y-1">
                <label class="text-[10px] font-mono text-[var(--text-muted)]">DATE RANGE</label>
                <div class="flex gap-2">
                  <input
                    type="date"
                    id="filter-date-from"
                    class="flex-1 bg-[var(--bg-secondary)] border border-[var(--border-color)] rounded px-2 py-1 font-mono text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--primary)]"
                  />
                  <span class="text-[var(--text-muted)] self-center text-xs">→</span>
                  <input
                    type="date"
                    id="filter-date-to"
                    class="flex-1 bg-[var(--bg-secondary)] border border-[var(--border-color)] rounded px-2 py-1 font-mono text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--primary)]"
                  />
                </div>
              </div>

              <!-- Language filter -->
              <div class="space-y-1">
                <label class="text-[10px] font-mono text-[var(--text-muted)]">LANGUAGE</label>
                <select
                  id="filter-language"
                  class="w-full bg-[var(--bg-secondary)] border border-[var(--border-color)] rounded px-2 py-1 font-mono text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--primary)]"
                >
                  <option value="">All languages</option>
                  <option value="es">Spanish</option>
                  <option value="en">English</option>
                </select>
              </div>

              <!-- Message count filter -->
              <div class="space-y-1">
                <label class="text-[10px] font-mono text-[var(--text-muted)]">MESSAGE COUNT</label>
                <div class="flex gap-2">
                  <input
                    type="number"
                    id="filter-min-messages"
                    placeholder="Min"
                    min="0"
                    class="flex-1 bg-[var(--bg-secondary)] border border-[var(--border-color)] rounded px-2 py-1 font-mono text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--primary)]"
                  />
                  <span class="text-[var(--text-muted)] self-center text-xs">-</span>
                  <input
                    type="number"
                    id="filter-max-messages"
                    placeholder="Max"
                    min="0"
                    class="flex-1 bg-[var(--bg-secondary)] border border-[var(--border-color)] rounded px-2 py-1 font-mono text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--primary)]"
                  />
                </div>
              </div>

              <!-- Tag filter -->
              <div class="space-y-1">
                <label class="text-[10px] font-mono text-[var(--text-muted)]">TAG</label>
                <select
                  id="filter-tag"
                  class="w-full bg-[var(--bg-secondary)] border border-[var(--border-color)] rounded px-2 py-1 font-mono text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--primary)]"
                >
                  <option value="">All tags</option>
                  <!-- Options populated by JS -->
                </select>
              </div>

              <!-- Filter actions -->
              <div class="flex gap-2 pt-1">
                <button
                  id="apply-filters-btn"
                  class="flex-1 bg-[var(--primary)] text-[var(--bg-primary)] py-1.5 rounded font-mono text-xs font-semibold hover:opacity-90 transition-opacity"
                >
                  APPLY
                </button>
                <button
                  id="clear-filters-btn"
                  class="px-3 py-1.5 border border-[var(--border-color)] rounded font-mono text-xs text-[var(--text-muted)] hover:border-[var(--text-muted)] transition-colors"
                >
                  CLEAR
                </button>
              </div>
            </div>
          </div>

          <!-- Active filters chips -->
          <div id="active-filters-chips" class="hidden px-3 py-2 flex-wrap gap-1 border-b border-[var(--border-color)]">
            <!-- Chips populated by JS -->
          </div>

          <!-- Bulk action bar -->
          <div id="bulk-action-bar" class="hidden px-3 py-2 bg-[var(--bg-secondary)] border-b border-[var(--border-color)]">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <input
                  type="checkbox"
                  id="select-all-checkbox"
                  class="bulk-checkbox"
                />
                <span class="text-xs font-mono text-[var(--text-muted)]">
                  <span id="selected-count">0</span> selected
                </span>
              </div>
              <div class="flex items-center gap-2">
                <button id="bulk-delete-btn" class="bulk-btn delete" title="Delete selected">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                  </svg>
                </button>
                <button id="bulk-tag-btn" class="bulk-btn tag" title="Add tag to selected">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                  </svg>
                </button>
                <button id="bulk-export-btn" class="bulk-btn export" title="Export selected">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <!-- Tag selector dropdown for bulk tagging -->
          <div id="bulk-tag-dropdown" class="hidden absolute left-0 right-0 mx-3 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-lg shadow-lg z-50 p-2">
            <div class="text-xs font-mono text-[var(--text-muted)] mb-2">Select tag to add:</div>
            <div id="bulk-tag-options" class="space-y-1">
              <!-- Populated by JS -->
            </div>
          </div>

          <div id="conversations-list" class="divide-y divide-[var(--border-color)]">
            <div class="p-4 text-center text-[var(--text-muted)] font-mono text-sm">
              Loading...
            </div>
          </div>
        </aside>

        <!-- Main: Conversation detail -->
        <main class="flex-1 flex flex-col overflow-hidden">
          <div id="conversation-detail" class="flex-1 overflow-y-auto p-6">
            <div class="h-full flex items-center justify-center text-[var(--text-muted)] font-mono">
              <div class="text-center">
                <div class="text-4xl mb-4 opacity-20">&gt;_</div>
                <div>Select a conversation</div>
              </div>
            </div>
          </div>
        </main>
      </div>
    )}

    {currentTab === 'analytics' && (
      <div class="max-w-7xl mx-auto p-6" id="analytics-container">
        <!-- Period Comparison Section -->
        <div class="mb-6">
          <div class="analytics-card">
            <div class="analytics-card-header flex items-center justify-between">
              <span><span class="text-[var(--primary)]">//</span> PERIOD COMPARISON</span>
              <div class="flex items-center gap-3">
                <select id="comparison-period" class="bg-[var(--bg-secondary)] border border-[var(--border-color)] rounded px-2 py-1 text-xs font-mono text-[var(--text-primary)] focus:outline-none focus:border-[var(--primary)]">
                  <option value="7">Last 7 days</option>
                  <option value="14">Last 14 days</option>
                  <option value="30">Last 30 days</option>
                </select>
              </div>
            </div>
            <div class="analytics-card-body">
              <div id="comparison-stats" class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <!-- Will be populated by JS -->
                <div class="comparison-stat-loading">
                  <div class="h-4 w-20 bg-[var(--bg-secondary)] rounded animate-pulse"></div>
                  <div class="h-8 w-16 bg-[var(--bg-secondary)] rounded animate-pulse mt-2"></div>
                </div>
                <div class="comparison-stat-loading">
                  <div class="h-4 w-20 bg-[var(--bg-secondary)] rounded animate-pulse"></div>
                  <div class="h-8 w-16 bg-[var(--bg-secondary)] rounded animate-pulse mt-2"></div>
                </div>
                <div class="comparison-stat-loading">
                  <div class="h-4 w-20 bg-[var(--bg-secondary)] rounded animate-pulse"></div>
                  <div class="h-8 w-16 bg-[var(--bg-secondary)] rounded animate-pulse mt-2"></div>
                </div>
                <div class="comparison-stat-loading">
                  <div class="h-4 w-20 bg-[var(--bg-secondary)] rounded animate-pulse"></div>
                  <div class="h-8 w-16 bg-[var(--bg-secondary)] rounded animate-pulse mt-2"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Activity Chart -->
          <div class="analytics-card">
            <div class="analytics-card-header">
              <span class="text-[var(--primary)]">//</span> ACTIVITY (30 DAYS)
            </div>
            <div class="analytics-card-body">
              <canvas id="activity-chart" height="200"></canvas>
            </div>
          </div>

          <!-- Hourly Heatmap -->
          <div class="analytics-card">
            <div class="analytics-card-header">
              <span class="text-[var(--primary)]">//</span> HOURLY HEATMAP
            </div>
            <div class="analytics-card-body">
              <div id="hourly-heatmap" class="flex gap-1 justify-center items-end h-32">
                <!-- Will be populated by JS -->
              </div>
              <div class="flex justify-between text-xs text-[var(--text-muted)] mt-2 font-mono">
                <span>0h</span>
                <span>6h</span>
                <span>12h</span>
                <span>18h</span>
                <span>24h</span>
              </div>
            </div>
          </div>

          <!-- Language Distribution -->
          <div class="analytics-card">
            <div class="analytics-card-header">
              <span class="text-[var(--primary)]">//</span> LANGUAGES
            </div>
            <div class="analytics-card-body flex items-center justify-center">
              <div id="language-chart" class="relative w-40 h-40">
                <!-- Will be populated by JS -->
              </div>
              <div id="language-legend" class="ml-6 space-y-2 font-mono text-sm">
                <!-- Will be populated by JS -->
              </div>
            </div>
          </div>

          <!-- Top Topics -->
          <div class="analytics-card">
            <div class="analytics-card-header">
              <span class="text-[var(--primary)]">//</span> TOP TOPICS
            </div>
            <div class="analytics-card-body">
              <div id="topics-chart" class="space-y-3">
                <!-- Will be populated by JS -->
              </div>
            </div>
          </div>

          <!-- Word Cloud -->
          <div class="analytics-card md:col-span-2">
            <div class="analytics-card-header">
              <span class="text-[var(--primary)]">//</span> WORD CLOUD
            </div>
            <div class="analytics-card-body">
              <div id="wordcloud-chart" class="flex flex-wrap justify-center items-center gap-2 min-h-[200px]">
                <!-- Will be populated by JS -->
              </div>
            </div>
          </div>

          <!-- Potential Leads -->
          <div class="analytics-card">
            <div class="analytics-card-header flex items-center justify-between">
              <span><span class="text-[var(--primary)]">//</span> POTENTIAL LEADS</span>
              <span id="leads-count" class="text-xs px-2 py-0.5 bg-[var(--color-neon-green)]/20 text-[var(--color-neon-green)] rounded">0</span>
            </div>
            <div class="analytics-card-body">
              <div id="leads-list" class="space-y-2 max-h-[250px] overflow-y-auto">
                <!-- Will be populated by JS -->
              </div>
            </div>
          </div>

          <!-- Top Engaging Conversations -->
          <div class="analytics-card">
            <div class="analytics-card-header">
              <span class="text-[var(--primary)]">//</span> TOP ENGAGING
            </div>
            <div class="analytics-card-body">
              <div id="engagement-list" class="space-y-2 max-h-[250px] overflow-y-auto">
                <!-- Will be populated by JS -->
              </div>
            </div>
          </div>

          <!-- Cost Analytics -->
          <div class="analytics-card md:col-span-2">
            <div class="analytics-card-header flex items-center justify-between">
              <span><span class="text-[var(--primary)]">//</span> COST ANALYTICS</span>
              <span id="total-cost" class="text-sm font-mono text-[var(--secondary)]">$0.00</span>
            </div>
            <div class="analytics-card-body">
              <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
                <div class="cost-stat">
                  <div class="cost-stat-label">Total Tokens</div>
                  <div class="cost-stat-value" id="cost-tokens">0</div>
                </div>
                <div class="cost-stat">
                  <div class="cost-stat-label">Messages</div>
                  <div class="cost-stat-value" id="cost-messages">0</div>
                </div>
                <div class="cost-stat">
                  <div class="cost-stat-label">Avg/Message</div>
                  <div class="cost-stat-value" id="cost-avg-tokens">0</div>
                </div>
                <div class="cost-stat">
                  <div class="cost-stat-label">Avg/Conv</div>
                  <div class="cost-stat-value" id="cost-avg-conv">$0.00</div>
                </div>
              </div>
              <div id="cost-chart" class="h-24">
                <!-- Will be populated by JS -->
              </div>
            </div>
          </div>
        </div>
      </div>
    )}

    {currentTab === 'trash' && (
      <div class="max-w-7xl mx-auto flex" style="height: calc(100vh - 120px);">
        <!-- Sidebar: Deleted conversations list -->
        <aside class="w-80 border-r border-[var(--border-color)] overflow-y-auto">
          <div class="p-3 border-b border-[var(--border-color)]">
            <div class="flex items-center gap-2 text-[var(--text-muted)] font-mono text-xs">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
              <span>DELETED CONVERSATIONS</span>
            </div>
          </div>
          <div id="trash-list" class="divide-y divide-[var(--border-color)]">
            <div class="p-4 text-center text-[var(--text-muted)] font-mono text-sm">
              Loading...
            </div>
          </div>
        </aside>

        <!-- Main: Trash detail -->
        <main class="flex-1 flex flex-col overflow-hidden">
          <div id="trash-detail" class="flex-1 overflow-y-auto p-6">
            <div class="h-full flex items-center justify-center text-[var(--text-muted)] font-mono">
              <div class="text-center">
                <div class="text-4xl mb-4 opacity-20">
                  <svg class="w-16 h-16 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                  </svg>
                </div>
                <div>Select a deleted conversation</div>
                <div class="text-xs mt-2 text-[var(--text-muted)]">
                  Items in trash can be restored or permanently deleted
                </div>
              </div>
            </div>
          </div>
        </main>
      </div>
    )}

    {currentTab === 'settings' && (
      <div class="max-w-4xl mx-auto p-6" id="settings-container">
        <!-- System Prompt Section -->
        <div class="settings-card mb-6">
          <div class="settings-card-header flex items-center justify-between">
            <span><span class="text-[var(--primary)]">//</span> SYSTEM PROMPT</span>
            <div class="flex items-center gap-2">
              <span id="prompt-status" class="text-xs text-[var(--text-muted)]">Loading...</span>
            </div>
          </div>
          <div class="settings-card-body">
            <div class="mb-3 text-xs text-[var(--text-muted)]">
              Customize the AI persona and behavior. Changes take effect immediately.
            </div>
            <textarea
              id="system-prompt-editor"
              class="w-full h-80 bg-[var(--bg-secondary)] border border-[var(--border-color)] rounded p-4 font-mono text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--primary)] resize-y"
              placeholder="Loading system prompt..."
            ></textarea>
            <div class="flex items-center justify-between mt-4">
              <div class="flex items-center gap-2">
                <span id="prompt-char-count" class="text-xs text-[var(--text-muted)]">0 characters</span>
              </div>
              <div class="flex items-center gap-2">
                <button
                  id="reset-prompt-btn"
                  class="px-3 py-1.5 border border-[var(--border-color)] rounded font-mono text-xs hover:bg-[var(--bg-secondary)] transition-colors"
                >
                  Reset to Default
                </button>
                <button
                  id="save-prompt-btn"
                  class="px-4 py-1.5 bg-[var(--primary)] text-[var(--bg-primary)] rounded font-mono text-xs font-semibold hover:opacity-90 transition-opacity"
                >
                  Save Changes
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Temperature Section -->
        <div class="settings-card mb-6">
          <div class="settings-card-header">
            <span class="text-[var(--primary)]">//</span> AI TEMPERATURE
          </div>
          <div class="settings-card-body">
            <div class="mb-4 text-xs text-[var(--text-muted)]">
              Controls response creativity. Lower = more focused, Higher = more creative.
            </div>
            <div class="flex items-center gap-4">
              <span class="text-xs text-[var(--text-muted)] w-16">Focused</span>
              <input
                type="range"
                id="temperature-slider"
                min="0"
                max="1"
                step="0.1"
                value="0.5"
                class="flex-1 temperature-slider"
              />
              <span class="text-xs text-[var(--text-muted)] w-16 text-right">Creative</span>
            </div>
            <div class="flex items-center justify-between mt-3">
              <span id="temperature-value" class="font-mono text-lg text-[var(--primary)]">0.5</span>
              <div class="flex items-center gap-2">
                <button
                  id="reset-temperature-btn"
                  class="px-3 py-1.5 border border-[var(--border-color)] rounded font-mono text-xs hover:bg-[var(--bg-secondary)] transition-colors"
                >
                  Reset to 0.5
                </button>
                <button
                  id="save-temperature-btn"
                  class="px-4 py-1.5 bg-[var(--primary)] text-[var(--bg-primary)] rounded font-mono text-xs font-semibold hover:opacity-90 transition-opacity"
                >
                  Save
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Config History Section -->
        <div class="settings-card">
          <div class="settings-card-header">
            <span class="text-[var(--primary)]">//</span> CHANGE HISTORY
          </div>
          <div class="settings-card-body">
            <div id="config-history" class="space-y-2 max-h-60 overflow-y-auto">
              <div class="text-center text-[var(--text-muted)] py-4 text-sm">
                Loading history...
              </div>
            </div>
          </div>
        </div>
      </div>
    )}

    {currentTab === 'moderation' && (
      <div class="max-w-6xl mx-auto p-6" id="moderation-container">
        <!-- Stats Overview -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
          <div class="moderation-stat-card">
            <div class="label">Rate Limit Events (24h)</div>
            <div class="value" data-stat="total-events">--</div>
          </div>
          <div class="moderation-stat-card">
            <div class="label">Blocked Requests</div>
            <div class="value" data-stat="blocked-count">--</div>
          </div>
          <div class="moderation-stat-card">
            <div class="label">Pending Flags</div>
            <div class="value" data-stat="pending-flags">--</div>
          </div>
          <div class="moderation-stat-card warning">
            <div class="label">High Priority</div>
            <div class="value" data-stat="high-priority">--</div>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- Rate Limiting Section -->
          <div class="moderation-card">
            <div class="moderation-card-header">
              <span class="text-[var(--secondary)]">//</span> RATE LIMITING
            </div>
            <div class="moderation-card-body">
              <div class="mb-3 flex items-center justify-between">
                <span class="text-xs text-[var(--text-muted)]">Recent rate limit events</span>
                <label class="flex items-center gap-2 text-xs">
                  <input type="checkbox" id="blocked-only" class="accent-[var(--secondary)]" />
                  <span class="text-[var(--text-muted)]">Blocked only</span>
                </label>
              </div>
              <div id="rate-limit-list" class="space-y-2 max-h-80 overflow-y-auto">
                <div class="text-center text-[var(--text-muted)] py-4 text-sm">Loading...</div>
              </div>
              <div class="mt-4 pt-3 border-t border-[var(--border-color)]">
                <div class="text-xs text-[var(--text-muted)] mb-2">Top Blocked IPs (7 days)</div>
                <div id="top-blocked-list" class="space-y-1">
                  <div class="text-center text-[var(--text-muted)] py-2 text-xs">Loading...</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Flagged Conversations Section -->
          <div class="moderation-card">
            <div class="moderation-card-header flex items-center justify-between">
              <div class="flex items-center gap-3">
                <span><span class="text-[var(--secondary)]">//</span> FLAGGED CONVERSATIONS</span>
                <span id="scan-result" class="hidden text-xs text-[var(--secondary)] font-normal"></span>
              </div>
              <button
                id="scan-spam-btn"
                class="px-3 py-1 bg-[var(--secondary)] text-[var(--bg-primary)] rounded font-mono text-xs font-semibold hover:opacity-90 transition-opacity"
              >
                Scan for Spam
              </button>
            </div>
            <div class="moderation-card-body">
              <div class="mb-3 flex items-center justify-between">
                <span class="text-xs text-[var(--text-muted)]">Conversations requiring review</span>
                <label class="flex items-center gap-2 text-xs">
                  <input type="checkbox" id="show-reviewed" class="accent-[var(--secondary)]" />
                  <span class="text-[var(--text-muted)]">Show reviewed</span>
                </label>
              </div>
              <div id="flagged-list" class="space-y-2 max-h-96 overflow-y-auto">
                <div class="text-center text-[var(--text-muted)] py-4 text-sm">Loading...</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- Delete Confirmation Modal -->
    <div id="delete-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center">
      <div class="modal-backdrop absolute inset-0 bg-black/70"></div>
      <div class="modal-content relative bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-lg w-full max-w-md mx-4 shadow-2xl">
        <div class="terminal-header">
          <span class="terminal-dot bg-red-500"></span>
          <span class="terminal-dot bg-yellow-500"></span>
          <span class="terminal-dot bg-green-500"></span>
          <span class="ml-4 text-xs opacity-70" id="modal-title">confirm.delete</span>
        </div>
        <div class="p-6">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full bg-red-500/20 flex items-center justify-center">
              <svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-mono font-semibold" id="modal-heading">Delete Conversation?</h3>
              <p class="text-sm text-[var(--text-muted)]" id="modal-description">
                This will move the conversation to trash.
              </p>
            </div>
          </div>
          <div class="flex gap-3 mt-6">
            <button
              id="modal-cancel"
              class="flex-1 px-4 py-2 border border-[var(--border-color)] rounded font-mono text-sm hover:bg-[var(--bg-secondary)] transition-colors"
            >
              Cancel
            </button>
            <button
              id="modal-confirm"
              class="flex-1 px-4 py-2 bg-red-500 text-white rounded font-mono text-sm hover:bg-red-600 transition-colors"
            >
              Delete
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  /* Login backdrop */
  .login-backdrop {
    position: fixed;
    inset: 0;
    background: radial-gradient(ellipse at center, var(--bg-secondary) 0%, transparent 70%);
    opacity: 0.8;
  }

  /* Login window with glassmorphism */
  .login-window {
    background: linear-gradient(
      135deg,
      rgba(var(--bg-secondary-rgb, 20, 20, 30), 0.95) 0%,
      rgba(var(--bg-tertiary-rgb, 30, 30, 45), 0.9) 100%
    );
    border: 1px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(var(--primary-rgb, 0, 255, 255), 0.1),
      0 8px 32px rgba(0, 0, 0, 0.4),
      0 0 60px rgba(var(--primary-rgb, 0, 255, 255), 0.05),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(20px);
    position: relative;
  }

  .login-window::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 12px;
    padding: 1px;
    background: linear-gradient(
      135deg,
      rgba(var(--primary-rgb, 0, 255, 255), 0.3) 0%,
      transparent 50%,
      rgba(var(--secondary-rgb, 255, 0, 255), 0.2) 100%
    );
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .terminal-header {
    background: rgba(var(--bg-tertiary-rgb, 30, 30, 45), 0.8);
    padding: 12px 16px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
  }

  .terminal-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    margin-right: 8px;
  }

  /* Tabs */
  .tab-link {
    padding: 12px 20px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
    border-bottom: 2px solid transparent;
    transition: all 0.2s ease;
  }

  .tab-link:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.02);
  }

  .tab-link.active {
    color: var(--primary);
    border-bottom-color: var(--primary);
  }

  /* Live indicator */
  .live-dot {
    width: 8px;
    height: 8px;
    background: var(--color-neon-green);
    border-radius: 50%;
    animation: pulse 1.5s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  /* Conversation list items */
  .conversation-item {
    padding: 12px 16px;
    cursor: pointer;
    transition: all 0.2s ease;
    border-left: 3px solid transparent;
  }

  .conversation-item:hover {
    background: var(--color-bg-tertiary, rgba(255, 255, 255, 0.05));
    border-left-color: var(--color-neon-cyan);
    transform: translateX(2px);
  }

  .conversation-item.active {
    background: var(--color-bg-tertiary, rgba(255, 255, 255, 0.05));
    border-left-color: var(--color-neon-cyan);
  }

  /* Message styles */
  .admin-message {
    display: flex;
    flex-direction: column;
    gap: 2px;
    max-width: 57%;
    margin-bottom: 12px;
  }

  .admin-message.user {
    align-self: flex-end;
    margin-left: auto;
  }

  .admin-message.assistant {
    align-self: flex-start;
  }

  .admin-message-meta {
    font-size: 10px;
    color: var(--color-text-muted);
    margin-bottom: 4px;
    font-family: var(--font-mono);
    opacity: 0.7;
  }

  .admin-message.user .admin-message-meta {
    text-align: right;
  }

  .admin-message-content {
    padding: 10px 14px;
    font-size: 13px;
    line-height: 1.5;
    word-break: break-word;
  }

  .admin-message.user .admin-message-content {
    background: var(--color-neon-cyan);
    color: var(--color-bg-terminal);
    border-radius: 12px 12px 4px 12px;
    font-weight: 500;
  }

  .admin-message.assistant .admin-message-content {
    background: rgba(0, 0, 0, 0.3);
    border-left: 2px solid var(--color-neon-green);
    color: var(--color-text-primary);
    border-radius: 0 8px 8px 0;
    padding-left: 12px;
  }

  .admin-message.assistant .admin-message-content::before {
    content: '>';
    color: var(--color-neon-green);
    margin-right: 6px;
    font-weight: bold;
  }

  /* Analytics cards */
  .analytics-card {
    background: rgba(var(--bg-secondary-rgb, 20, 20, 30), 0.5);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    overflow: hidden;
  }

  .analytics-card-header {
    padding: 12px 16px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-color);
    background: rgba(0, 0, 0, 0.2);
  }

  .analytics-card-body {
    padding: 20px;
    min-height: 180px;
  }

  /* Heatmap bar */
  .heatmap-bar {
    width: 12px;
    min-height: 4px;
    border-radius: 2px 2px 0 0;
    transition: all 0.3s ease;
  }

  /* Topic bar */
  .topic-bar {
    height: 24px;
    border-radius: 4px;
    transition: width 0.5s ease;
  }

  /* Search results */
  .search-result {
    border-bottom: 1px solid var(--border-color);
  }

  .search-result:last-child {
    border-bottom: none;
  }

  .search-result:hover {
    background: var(--bg-secondary);
  }

  /* Search highlight */
  .search-highlight {
    background: rgba(var(--primary-rgb, 0, 255, 255), 0.3);
    color: var(--primary);
    padding: 0 2px;
    border-radius: 2px;
    font-weight: 500;
  }

  /* Filter chips */
  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    font-size: 10px;
    font-family: var(--font-mono);
    background: rgba(var(--primary-rgb, 0, 255, 255), 0.15);
    border: 1px solid rgba(var(--primary-rgb, 0, 255, 255), 0.3);
    border-radius: 4px;
    color: var(--primary);
  }

  .filter-chip-remove {
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .filter-chip-remove:hover {
    opacity: 1;
  }

  /* Filters chevron rotation */
  #filters-chevron.open {
    transform: rotate(180deg);
  }

  /* Tag badges */
  .tag-badge {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 1px 6px;
    font-size: 9px;
    font-family: var(--font-mono);
    border-radius: 3px;
    text-transform: uppercase;
    font-weight: 500;
  }

  .tag-badge-remove {
    cursor: pointer;
    opacity: 0.7;
    margin-left: 2px;
    font-size: 10px;
  }

  .tag-badge-remove:hover {
    opacity: 1;
  }

  /* Tag selector */
  .tag-selector {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 8px;
    background: var(--bg-secondary);
    border-radius: 4px;
    margin-top: 8px;
  }

  .tag-option {
    cursor: pointer;
    padding: 2px 8px;
    font-size: 10px;
    font-family: var(--font-mono);
    border-radius: 3px;
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .tag-option:hover {
    opacity: 1;
  }

  .tag-option.selected {
    opacity: 1;
    box-shadow: 0 0 0 1px currentColor;
  }

  /* Modal animations */
  #delete-modal .modal-backdrop {
    animation: fadeIn 0.15s ease-out;
  }

  #delete-modal .modal-content {
    animation: slideUp 0.2s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Trash item styles */
  .trash-item {
    padding: 12px 16px;
    cursor: pointer;
    transition: all 0.2s ease;
    border-left: 3px solid transparent;
    opacity: 0.7;
  }

  .trash-item:hover {
    background: var(--color-bg-tertiary, rgba(255, 255, 255, 0.05));
    border-left-color: var(--color-neon-magenta);
    transform: translateX(2px);
    opacity: 1;
  }

  .trash-item.active {
    background: var(--color-bg-tertiary, rgba(255, 255, 255, 0.05));
    border-left-color: var(--color-neon-magenta);
    opacity: 1;
  }

  /* Trash action buttons */
  .trash-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    font-size: 12px;
    font-family: var(--font-mono);
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .trash-action-btn.restore {
    background: rgba(var(--color-neon-green-rgb, 0, 255, 136), 0.15);
    border: 1px solid rgba(var(--color-neon-green-rgb, 0, 255, 136), 0.4);
    color: var(--color-neon-green);
  }

  .trash-action-btn.restore:hover {
    background: rgba(var(--color-neon-green-rgb, 0, 255, 136), 0.25);
    border-color: var(--color-neon-green);
  }

  .trash-action-btn.delete-permanent {
    background: rgba(255, 100, 100, 0.15);
    border: 1px solid rgba(255, 100, 100, 0.4);
    color: #ff6464;
  }

  .trash-action-btn.delete-permanent:hover {
    background: rgba(255, 100, 100, 0.25);
    border-color: #ff6464;
  }

  /* Delete button in conversation header */
  .delete-conversation-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    font-size: 11px;
    font-family: var(--font-mono);
    border: 1px solid rgba(255, 100, 100, 0.3);
    border-radius: 4px;
    color: rgba(255, 100, 100, 0.8);
    cursor: pointer;
    transition: all 0.2s ease;
    background: transparent;
  }

  .delete-conversation-btn:hover {
    background: rgba(255, 100, 100, 0.1);
    border-color: rgba(255, 100, 100, 0.6);
    color: #ff6464;
  }

  /* Minimalist terminal checkbox */
  .terminal-checkbox {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    width: 14px;
    height: 14px;
    background: transparent;
    border: 1px solid var(--color-text-muted);
    cursor: pointer;
    position: relative;
    transition: border-color 0.15s ease, opacity 0.15s ease;
    flex-shrink: 0;
    margin: 0;
    opacity: 0.6;
  }

  .terminal-checkbox:hover {
    border-color: var(--color-neon-cyan);
    opacity: 1;
  }

  .terminal-checkbox:checked {
    border-color: var(--color-neon-cyan);
    opacity: 1;
  }

  .terminal-checkbox:checked::after {
    content: '×';
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-size: 12px;
    line-height: 1;
    color: var(--color-neon-cyan);
    font-family: var(--font-mono);
    font-weight: bold;
  }

  .terminal-checkbox:focus {
    outline: none;
    border-color: var(--color-neon-cyan);
    opacity: 1;
  }

  /* Conversation item row layout */
  .conversation-item-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding-top: 2px;
  }

  .conversation-item-content {
    flex: 1;
    min-width: 0;
  }

  /* Bulk action bar checkbox */
  .bulk-checkbox {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    width: 12px;
    height: 12px;
    background: transparent;
    border: 1px solid var(--border-color);
    cursor: pointer;
    position: relative;
    transition: border-color 0.15s ease;
    flex-shrink: 0;
  }

  .bulk-checkbox:hover {
    border-color: var(--primary);
  }

  .bulk-checkbox:checked {
    border-color: var(--primary);
  }

  .bulk-checkbox:checked::after {
    content: '×';
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-size: 10px;
    line-height: 1;
    color: var(--primary);
    font-family: var(--font-mono);
  }

  .bulk-checkbox:focus {
    outline: none;
    border-color: var(--primary);
  }

  .bulk-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
    border: 1px solid var(--border-color);
    background: transparent;
    color: var(--text-muted);
  }

  .bulk-btn:hover {
    background: var(--bg-secondary);
    color: var(--text-primary);
  }

  .bulk-btn.delete:hover {
    background: rgba(255, 100, 100, 0.15);
    border-color: rgba(255, 100, 100, 0.4);
    color: #ff6464;
