</style>

<script define:vars={{ currentTab }}>
  class AdminPanel {
    constructor() {
      this.authenticated = false;
      this.conversations = [];
      this.selectedConversationId = null;
      this.currentTab = currentTab;
      this.eventSource = null;
      this.searchDebounceTimer = null;
      this.currentSearchQuery = '';
      this.isSearching = false;
      this.filters = {
        dateFrom: null,
        dateTo: null,
        language: null,
        minMessages: null,
        maxMessages: null,
        hasTag: null,
      };
      this.availableTags = [];
      this.conversationTags = {}; // Map of conversationId -> tags array
      // Trash state
      this.trashConversations = [];
      this.selectedTrashId = null;
      // Modal state
      this.modalResolve = null;
      this.pendingDeleteAction = null;
      // Bulk selection state
      this.selectedIds = new Set();
      this.bulkMode = false;
      // Moderation state
      this.rateLimitLogs = [];
      this.flaggedConversations = [];
      this.moderationStats = null;
      this.init();
    }

    async init() {
      await this.checkAuth();
      this.setupEventListeners();
    }

    setupEventListeners() {
      document.getElementById('login-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        this.login();
      });

      document.getElementById('logout-btn')?.addEventListener('click', () => {
        this.logout();
      });

      this.setupSearchEventListeners();
      this.setupFilterEventListeners();
      this.setupModalEventListeners();
      this.setupBulkEventListeners();
      this.loadFiltersFromURL();
    }

    setupBulkEventListeners() {
      const selectAllCheckbox = document.getElementById('select-all-checkbox');
      const bulkDeleteBtn = document.getElementById('bulk-delete-btn');
      const bulkTagBtn = document.getElementById('bulk-tag-btn');
      const bulkExportBtn = document.getElementById('bulk-export-btn');
      const bulkTagDropdown = document.getElementById('bulk-tag-dropdown');

      // Select all checkbox
      selectAllCheckbox?.addEventListener('change', (e) => {
        const checked = e.target.checked;
        if (checked) {
          this.conversations.forEach((c) => this.selectedIds.add(c.id));
        } else {
          this.selectedIds.clear();
        }
        this.updateBulkUI();
        this.renderConversationsList();
      });

      // Bulk delete button
      bulkDeleteBtn?.addEventListener('click', async () => {
        if (this.selectedIds.size === 0) return;
        await this.bulkDelete();
      });

      // Bulk tag button - toggle dropdown
      bulkTagBtn?.addEventListener('click', () => {
        if (this.selectedIds.size === 0) return;
        bulkTagDropdown?.classList.toggle('hidden');
        if (!bulkTagDropdown?.classList.contains('hidden')) {
          this.populateBulkTagDropdown();
        }
      });

      // Bulk export button
      bulkExportBtn?.addEventListener('click', async () => {
        if (this.selectedIds.size === 0) return;
        await this.bulkExport();
      });

      // Close tag dropdown when clicking outside
      document.addEventListener('click', (e) => {
        if (!bulkTagBtn?.contains(e.target) && !bulkTagDropdown?.contains(e.target)) {
          bulkTagDropdown?.classList.add('hidden');
        }
      });
    }

    setupModalEventListeners() {
      const modal = document.getElementById('delete-modal');
      const cancelBtn = document.getElementById('modal-cancel');
      const confirmBtn = document.getElementById('modal-confirm');

      // Cancel button
      cancelBtn?.addEventListener('click', () => {
        this.closeModal(false);
      });

      // Confirm button
      confirmBtn?.addEventListener('click', () => {
        this.closeModal(true);
      });

      // Click on backdrop to close
      modal?.querySelector('.modal-backdrop')?.addEventListener('click', () => {
        this.closeModal(false);
      });

      // Escape key to close
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
          this.closeModal(false);
        }
      });
    }

    setupSearchEventListeners() {
      const searchInput = document.getElementById('search-input');
      const searchResults = document.getElementById('search-results');
      const searchContainer = searchInput?.parentElement?.parentElement;

      if (!searchInput) return;

      // Input with debounce
      searchInput.addEventListener('input', () => {
        if (this.searchDebounceTimer) {
          clearTimeout(this.searchDebounceTimer);
        }

        const query = searchInput.value.trim();
        this.currentSearchQuery = query;

        if (query.length < 2) {
          this.hideSearchResults();
          return;
        }

        this.searchDebounceTimer = setTimeout(() => {
          this.performSearch(query);
        }, 300);
      });

      // Focus/blur for showing/hiding results
      searchInput.addEventListener('focus', () => {
        if (this.currentSearchQuery.length >= 2 && searchResults?.innerHTML.trim()) {
          this.showSearchResults();
        }
      });

      // Click outside to close
      document.addEventListener('click', (e) => {
        if (!searchContainer?.contains(e.target)) {
          this.hideSearchResults();
        }
      });

      // Keyboard: Escape to close
      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          this.hideSearchResults();
          searchInput.blur();
        }
      });

      // Global "/" shortcut to focus search
      document.addEventListener('keydown', (e) => {
        if (e.key === '/' && document.activeElement !== searchInput && this.currentTab === 'conversations') {
          e.preventDefault();
          searchInput.focus();
        }
      });
    }

    async checkAuth() {
      try {
        const response = await fetch('/api/admin/auth');
        const data = await response.json();

        if (data.authenticated) {
          this.showAdminView();
          if (this.currentTab === 'conversations') {
            await this.loadConversations();
          } else if (this.currentTab === 'analytics') {
            await this.loadAnalytics();
            this.setupComparisonListeners();
          } else if (this.currentTab === 'trash') {
            await this.loadTrash();
          } else if (this.currentTab === 'settings') {
            await this.loadSettings();
            this.setupSettingsListeners();
          } else if (this.currentTab === 'moderation') {
            await this.loadModeration();
            this.setupModerationListeners();
          }
        } else {
          this.showLoginView();
        }
      } catch {
        this.showLoginView();
      }
    }

    async login() {
      const passwordInput = document.getElementById('password-input');
      const errorEl = document.getElementById('login-error');
      const password = passwordInput?.value;

      if (!password) return;

      try {
        const response = await fetch('/api/admin/auth', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password })
        });

        if (response.ok) {
          errorEl?.classList.add('hidden');
          this.showAdminView();
          if (this.currentTab === 'conversations') {
            await this.loadConversations();
          } else if (this.currentTab === 'analytics') {
            await this.loadAnalytics();
            this.setupComparisonListeners();
          } else if (this.currentTab === 'trash') {
            await this.loadTrash();
          } else if (this.currentTab === 'settings') {
            await this.loadSettings();
            this.setupSettingsListeners();
          } else if (this.currentTab === 'moderation') {
            await this.loadModeration();
            this.setupModerationListeners();
          }
        } else {
          errorEl?.classList.remove('hidden');
          passwordInput.value = '';
          passwordInput.focus();
        }
      } catch {
        errorEl?.classList.remove('hidden');
      }
    }

    async logout() {
      if (this.eventSource) {
        this.eventSource.close();
        this.eventSource = null;
      }
      this.clearSearch();
      await fetch('/api/admin/auth', { method: 'DELETE' });
      this.showLoginView();
    }

    showLoginView() {
      document.getElementById('login-view')?.classList.remove('hidden');
      document.getElementById('admin-view')?.classList.add('hidden');
      document.getElementById('password-input')?.focus();
      this.hideLiveIndicator();
    }

    showAdminView() {
      document.getElementById('login-view')?.classList.add('hidden');
      document.getElementById('admin-view')?.classList.remove('hidden');
      this.startLiveConnection();
      this.loadTags(); // Load available tags for filtering
    }

    // ========== LIVE USERS SSE ==========

    startLiveConnection() {
      if (this.eventSource) {
        this.eventSource.close();
      }

      try {
        this.eventSource = new EventSource('/api/admin/live');

        this.eventSource.onmessage = (event) => {
          try {
            const data = JSON.parse(event.data);
            this.updateLiveIndicator(data.count, data.users);
          } catch (e) {
            console.error('Failed to parse SSE data:', e);
          }
        };

        this.eventSource.onerror = () => {
          // SSE connection failed or closed, hide indicator
          this.hideLiveIndicator();
          // Reconnect after 30 seconds
          setTimeout(() => {
            if (document.getElementById('admin-view')?.classList.contains('hidden') === false) {
              this.startLiveConnection();
            }
          }, 30000);
        };
      } catch (e) {
        console.error('Failed to start SSE:', e);
      }
    }

    updateLiveIndicator(count, users) {
      const indicator = document.getElementById('live-indicator');
      const countEl = document.getElementById('live-count');

      if (count > 0) {
        indicator?.classList.remove('hidden');
        indicator?.classList.add('flex');
        if (countEl) countEl.textContent = count.toString();
      } else {
        this.hideLiveIndicator();
      }
    }

    hideLiveIndicator() {
      const indicator = document.getElementById('live-indicator');
      indicator?.classList.add('hidden');
      indicator?.classList.remove('flex');
    }

    // ========== CONVERSATIONS TAB ==========

    async loadConversations() {
      try {
        // Build URL with filters
        const url = new URL('/api/admin/conversations', window.location.origin);

        if (this.filters.dateFrom) url.searchParams.set('dateFrom', this.filters.dateFrom);
        if (this.filters.dateTo) url.searchParams.set('dateTo', this.filters.dateTo);
        if (this.filters.language) url.searchParams.set('language', this.filters.language);
        if (this.filters.minMessages) url.searchParams.set('minMessages', this.filters.minMessages.toString());
        if (this.filters.maxMessages) url.searchParams.set('maxMessages', this.filters.maxMessages.toString());
        if (this.filters.hasTag) url.searchParams.set('hasTag', this.filters.hasTag.toString());

        const response = await fetch(url.toString());
        if (!response.ok) {
          if (response.status === 401) {
            this.showLoginView();
            return;
          }
          throw new Error('Failed to fetch');
        }

        const data = await response.json();
        this.conversations = data.conversations;
        this.updateStats(data.stats);
        this.renderConversationsList();
      } catch (error) {
        console.error('Failed to load conversations:', error);
      }
    }

    updateStats(stats) {
      document.getElementById('stat-conversations').textContent = stats.totalConversations?.toString() || '0';
      document.getElementById('stat-messages').textContent = stats.totalMessages?.toString() || '0';
      document.getElementById('stat-today').textContent = stats.messagesToday?.toString() || '0';
    }

    renderConversationsList() {
      const container = document.getElementById('conversations-list');
      if (!container) return;

      // Show/hide bulk action bar based on selection
      this.updateBulkUI();

      if (this.conversations.length === 0) {
        const hasFilters = this.hasActiveFilters();
        container.innerHTML = `
          <div class="p-4 text-center text-[var(--text-muted)] font-mono text-sm">
            ${hasFilters
              ? 'No conversations match filters'
              : 'No conversations yet'
            }
          </div>
        `;
        return;
      }

      // Add bulk-mode class if any items are selected
      if (this.selectedIds.size > 0) {
        container.classList.add('bulk-mode');
      } else {
        container.classList.remove('bulk-mode');
      }

      container.innerHTML = this.conversations.map(conv => {
        const lastMessageAt = conv.lastMessageAt ? this.formatTimeAgo(conv.lastMessageAt) : 'No messages';
        const preview = conv.lastMessage ? this.truncate(conv.lastMessage, 50) : 'Empty conversation';
        const isActive = conv.id === this.selectedConversationId;
        const isSelected = this.selectedIds.has(conv.id);
        const shortId = conv.userId ? conv.userId.substring(0, 8) : 'unknown';

        return `
          <div class="conversation-item ${isActive ? 'active' : ''} ${isSelected ? 'selected' : ''}" data-id="${conv.id}">
            <div class="conversation-item-row">
              <input
                type="checkbox"
                class="terminal-checkbox"
                data-id="${conv.id}"
                ${isSelected ? 'checked' : ''}
              />
              <div class="conversation-item-content">
                <div class="flex items-center justify-between mb-1">
                  <span class="font-mono text-sm text-[var(--primary)]">${shortId}...</span>
                  <span class="text-xs text-[var(--text-muted)]">${lastMessageAt}</span>
                </div>
                <div class="text-sm text-[var(--text-muted)] truncate">${this.escapeHtml(preview)}</div>
                <div class="text-xs text-[var(--text-muted)] mt-1 flex items-center gap-1">
                  <span class="text-[var(--secondary)]">${conv.messageCount || 0}</span>
                  <span>messages</span>
                </div>
              </div>
            </div>
          </div>
        `;
      }).join('');

      // Add checkbox handlers
      container.querySelectorAll('.terminal-checkbox').forEach(checkbox => {
        checkbox.addEventListener('click', (e) => {
          e.stopPropagation(); // Don't trigger conversation selection
          const id = parseInt(checkbox.getAttribute('data-id'), 10);
          if (checkbox.checked) {
            this.selectedIds.add(id);
          } else {
            this.selectedIds.delete(id);
          }
          this.updateBulkUI();
          // Update visual state without full re-render
          const item = checkbox.closest('.conversation-item');
          item?.classList.toggle('selected', checkbox.checked);
        });
      });

      // Add click handlers for conversation selection
      container.querySelectorAll('.conversation-item').forEach(item => {
        item.addEventListener('click', (e) => {
          // If clicking on checkbox, don't select conversation
          if (e.target.classList.contains('terminal-checkbox')) return;
          const id = parseInt(item.getAttribute('data-id'));
          this.selectConversation(id);
        });
      });
    }

    async selectConversation(id) {
      this.selectedConversationId = id;
      this.renderConversationsList();

      const detailContainer = document.getElementById('conversation-detail');
      if (!detailContainer) return;

      detailContainer.innerHTML = `
        <div class="h-full flex items-center justify-center text-[var(--text-muted)] font-mono">
          <div>Loading messages...</div>
        </div>
      `;

      try {
        const response = await fetch(`/api/admin/conversation/${id}`);
        if (!response.ok) throw new Error('Failed to fetch');

        const data = await response.json();
        this.renderConversationDetail(data.conversation, data.messages);
      } catch (error) {
        console.error('Failed to load conversation:', error);
        detailContainer.innerHTML = `
          <div class="h-full flex items-center justify-center text-red-400 font-mono">
            <div>Failed to load conversation</div>
          </div>
        `;
      }
    }

    renderConversationDetail(conversation, messages) {
      const container = document.getElementById('conversation-detail');
      if (!container) return;

      const header = `
        <div class="mb-6 pb-4 border-b border-[var(--border-color)]">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-2">
              <span class="text-[var(--primary)] font-mono">&gt;</span>
              <span class="font-mono font-semibold">User: ${conversation.user_id}</span>
            </div>
            <button class="delete-conversation-btn" data-conversation-id="${conversation.id}">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
              DELETE
            </button>
          </div>
          <div class="text-sm text-[var(--text-muted)] font-mono">
            Started: ${this.formatDate(conversation.created_at)}
          </div>
        </div>
      `;

      const messagesHtml = messages.map(msg => `
        <div class="admin-message ${msg.role}">
          <div class="admin-message-meta">
            ${msg.role === 'user' ? 'USER' : 'AARON.AI'} · ${this.formatTime(msg.created_at)}
          </div>
          <div class="admin-message-content">${this.escapeHtml(msg.content)}</div>
        </div>
      `).join('');

      container.innerHTML = header + `<div>${messagesHtml}</div>`;
      container.scrollTop = container.scrollHeight;

      // Add delete button event listener
      container.querySelector('.delete-conversation-btn')?.addEventListener('click', async (e) => {
        const btn = e.currentTarget;
        const conversationId = parseInt(btn.getAttribute('data-conversation-id'), 10);
        if (conversationId) {
          await this.deleteConversation(conversationId);
        }
      });
    }

    // ========== ANALYTICS TAB ==========

    async loadAnalytics() {
      try {
        // Load stats for header
        const statsResponse = await fetch('/api/admin/conversations');
        if (statsResponse.ok) {
          const data = await statsResponse.json();
          this.updateStats(data.stats);
        }

        // Load comparison data with selected period
        const comparisonDays = document.getElementById('comparison-period')?.value || '7';
        await this.loadComparison(comparisonDays);

        // Load all analytics data in parallel
        const [activityRes, hourlyRes, languagesRes, topicsRes, wordcloudRes, leadsRes, engagementRes, costsRes] = await Promise.all([
          fetch('/api/admin/analytics/activity'),
          fetch('/api/admin/analytics/hourly'),
          fetch('/api/admin/analytics/languages'),
          fetch('/api/admin/analytics/topics'),
          fetch('/api/admin/analytics/wordcloud?limit=80'),
          fetch('/api/admin/analytics/leads?limit=10'),
          fetch('/api/admin/analytics/engagement?limit=5'),
          fetch('/api/admin/analytics/costs?days=30'),
        ]);

        if (activityRes.ok) {
          const { activity } = await activityRes.json();
          this.renderActivityChart(activity);
        }

        if (hourlyRes.ok) {
          const { hourly } = await hourlyRes.json();
          this.renderHourlyHeatmap(hourly);
        }

        if (languagesRes.ok) {
          const { languages, total } = await languagesRes.json();
          this.renderLanguageChart(languages, total);
        }

        if (topicsRes.ok) {
          const { topics } = await topicsRes.json();
          this.renderTopicsChart(topics);
        }

        if (wordcloudRes.ok) {
          const data = await wordcloudRes.json();
          this.renderWordCloud(data.words);
        }

        if (leadsRes.ok) {
          const data = await leadsRes.json();
          this.renderLeads(data.leads, data.stats);
        }

        if (engagementRes.ok) {
          const data = await engagementRes.json();
          this.renderEngagement(data.conversations);
        }

        if (costsRes.ok) {
          const data = await costsRes.json();
          this.renderCosts(data);
        }
      } catch (error) {
        console.error('Failed to load analytics:', error);
      }
    }

    renderActivityChart(data) {
      const canvas = document.getElementById('activity-chart');
      if (!canvas || !(canvas instanceof HTMLCanvasElement)) return;

      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const width = canvas.width = canvas.parentElement?.clientWidth || 400;
      const height = canvas.height = 200;
      const padding = { top: 20, right: 20, bottom: 30, left: 40 };

      const maxCount = Math.max(...data.map(d => d.count), 1);
      const chartWidth = width - padding.left - padding.right;
      const chartHeight = height - padding.top - padding.bottom;

      ctx.clearRect(0, 0, width, height);

      // Get CSS custom properties
      const style = getComputedStyle(document.documentElement);
      const primaryColor = style.getPropertyValue('--primary').trim() || '#00ffff';
      const textColor = style.getPropertyValue('--text-muted').trim() || '#888';

      // Draw grid lines
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.1)';
      ctx.lineWidth = 1;
      for (let i = 0; i <= 4; i++) {
        const y = padding.top + (chartHeight / 4) * i;
        ctx.beginPath();
        ctx.moveTo(padding.left, y);
        ctx.lineTo(width - padding.right, y);
        ctx.stroke();
      }

      // Draw line chart
      if (data.length > 0) {
        ctx.strokeStyle = primaryColor;
        ctx.lineWidth = 2;
        ctx.beginPath();

        data.forEach((d, i) => {
          const x = padding.left + (i / (data.length - 1 || 1)) * chartWidth;
          const y = padding.top + chartHeight - (d.count / maxCount) * chartHeight;

          if (i === 0) {
            ctx.moveTo(x, y);
          } else {
            ctx.lineTo(x, y);
          }
        });
        ctx.stroke();

        // Draw dots
        ctx.fillStyle = primaryColor;
        data.forEach((d, i) => {
          const x = padding.left + (i / (data.length - 1 || 1)) * chartWidth;
          const y = padding.top + chartHeight - (d.count / maxCount) * chartHeight;
          ctx.beginPath();
          ctx.arc(x, y, 3, 0, Math.PI * 2);
          ctx.fill();
        });
      }

      // Y-axis labels
      ctx.fillStyle = textColor;
      ctx.font = '10px monospace';
      ctx.textAlign = 'right';
      for (let i = 0; i <= 4; i++) {
        const value = Math.round(maxCount * (4 - i) / 4);
        const y = padding.top + (chartHeight / 4) * i + 4;
        ctx.fillText(value.toString(), padding.left - 8, y);
      }
    }

    renderHourlyHeatmap(data) {
      const container = document.getElementById('hourly-heatmap');
      if (!container) return;

      const maxCount = Math.max(...data.map(d => d.count), 1);

      container.innerHTML = data.map(d => {
        const intensity = d.count / maxCount;
        const height = Math.max(4, Math.round(intensity * 100));
        const opacity = 0.2 + intensity * 0.8;

        return `
          <div
            class="heatmap-bar"
            style="height: ${height}px; background: rgba(0, 255, 255, ${opacity});"
            title="${d.hour}:00 - ${d.count} messages"
          ></div>
        `;
      }).join('');
    }

    renderLanguageChart(languages, total) {
      const chartContainer = document.getElementById('language-chart');
      const legendContainer = document.getElementById('language-legend');
      if (!chartContainer || !legendContainer) return;

      const colors = {
        es: '#ff6b6b',
        en: '#4ecdc4',
        other: '#a8a8a8'
      };

      // Simple donut chart using CSS
      let offset = 0;
      const segments = languages.map(lang => {
        const segment = {
          color: colors[lang.code] || colors.other,
          percentage: lang.percentage,
          offset: offset
        };
        offset += lang.percentage;
        return segment;
      });

      const gradientStops = segments.map(s =>
        `${s.color} ${s.offset}% ${s.offset + s.percentage}%`
      ).join(', ');

      chartContainer.innerHTML = `
        <div
          style="
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: conic-gradient(${gradientStops || 'rgba(255,255,255,0.1) 0% 100%'});
            position: relative;
          "
        >
          <div
            style="
              position: absolute;
              inset: 25%;
              background: var(--bg-primary);
              border-radius: 50%;
              display: flex;
              align-items: center;
              justify-content: center;
            "
          >
            <span class="text-xl font-bold font-mono">${total}</span>
          </div>
        </div>
      `;

      legendContainer.innerHTML = languages.map(lang => `
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded" style="background: ${colors[lang.code] || colors.other}"></div>
          <span>${lang.name}</span>
          <span class="text-[var(--text-muted)]">${lang.percentage}%</span>
        </div>
      `).join('');
    }

    renderTopicsChart(topics) {
      const container = document.getElementById('topics-chart');
      if (!container) return;

      if (topics.length === 0) {
        container.innerHTML = `
          <div class="text-center text-[var(--text-muted)] py-8">
            No topic data available
          </div>
        `;
        return;
      }

      container.innerHTML = topics.slice(0, 6).map(topic => `
        <div class="flex items-center gap-3">
          <div class="w-24 text-xs font-mono text-[var(--text-muted)] truncate">${topic.name}</div>
          <div class="flex-1 h-6 bg-[var(--bg-primary)] rounded overflow-hidden">
            <div
              class="topic-bar h-full"
              style="width: ${topic.percentage}%; background: linear-gradient(90deg, var(--primary), var(--secondary));"
            ></div>
          </div>
          <div class="w-8 text-xs font-mono text-right">${topic.count}</div>
        </div>
      `).join('');
    }

    renderWordCloud(words) {
      const container = document.getElementById('wordcloud-chart');
      if (!container) return;

      if (!words || words.length === 0) {
        container.innerHTML = `
          <div class="text-center text-[var(--text-muted)] py-8">
            No word data available
          </div>
        `;
        return;
      }

      // Generate colors based on size
      const getColor = (size) => {
        if (size >= 70) return 'var(--primary)';
        if (size >= 50) return 'var(--secondary)';
        if (size >= 30) return 'var(--color-neon-green)';
        return 'var(--text-muted)';
      };

      // Map size (10-100) to font size (10-32px)
      const getFontSize = (size) => {
        return Math.round(10 + (size / 100) * 22);
      };

      container.innerHTML = words.map(w => `
        <span
          class="wordcloud-word"
          style="font-size: ${getFontSize(w.size)}px; color: ${getColor(w.size)}; opacity: ${0.5 + (w.size / 200)};"
          title="${w.word}: ${w.count} occurrences"
          data-word="${this.escapeHtml(w.word)}"
        >
          ${this.escapeHtml(w.word)}
        </span>
      `).join('');

      // Add click handlers to filter by word
      container.querySelectorAll('.wordcloud-word').forEach(el => {
        el.addEventListener('click', () => {
          const word = el.getAttribute('data-word');
          if (word) {
            // Navigate to conversations with search
            window.location.href = `/admin/conversations?search=${encodeURIComponent(word)}`;
          }
        });
      });
    }

    renderLeads(leads, stats) {
      const container = document.getElementById('leads-list');
      const countBadge = document.getElementById('leads-count');
      if (!container) return;

      // Update count badge
      if (countBadge) {
        countBadge.textContent = stats?.total?.toString() || '0';
      }

      if (!leads || leads.length === 0) {
        container.innerHTML = `
          <div class="text-center text-[var(--text-muted)] py-8 text-sm">
            No potential leads detected
          </div>
        `;
        return;
      }

      container.innerHTML = leads.map(lead => {
        const scoreClass = lead.score >= 5 ? 'high' : lead.score >= 3 ? 'medium' : 'low';
        const shortUserId = lead.userId.substring(0, 8);
        const preview = lead.lastMessage
          ? this.truncate(lead.lastMessage, 60)
          : 'No preview';

        return `
          <div class="lead-item" data-conversation-id="${lead.conversationId}">
            <div class="flex items-center justify-between mb-1">
              <span class="font-mono text-xs text-[var(--primary)]">${shortUserId}...</span>
              <span class="lead-score ${scoreClass}">${lead.score}</span>
            </div>
            <div class="text-xs text-[var(--text-muted)] truncate mb-1">${this.escapeHtml(preview)}</div>
            <div class="flex flex-wrap gap-1">
              ${lead.matchedKeywords.slice(0, 3).map(k => `
                <span class="lead-keyword">${k}</span>
              `).join('')}
            </div>
          </div>
        `;
      }).join('');

      // Add click handlers
      container.querySelectorAll('.lead-item').forEach(el => {
        el.addEventListener('click', () => {
          const id = el.getAttribute('data-conversation-id');
          if (id) {
            window.location.href = `/admin/conversations?select=${id}`;
          }
        });
      });
    }

    renderEngagement(conversations) {
      const container = document.getElementById('engagement-list');
      if (!container) return;

      if (!conversations || conversations.length === 0) {
        container.innerHTML = `
          <div class="text-center text-[var(--text-muted)] py-8 text-sm">
            No engagement data available
          </div>
        `;
        return;
      }

      container.innerHTML = conversations.map(conv => {
        const shortUserId = conv.userId.substring(0, 8);
        const preview = conv.preview
          ? this.truncate(conv.preview, 50)
          : 'No preview';

        // Format duration
        let duration = '';
        if (conv.durationMinutes >= 60) {
          const hours = Math.floor(conv.durationMinutes / 60);
          const mins = conv.durationMinutes % 60;
          duration = `${hours}h ${mins}m`;
        } else {
          duration = `${conv.durationMinutes}m`;
        }

        return `
          <div class="engagement-item" data-conversation-id="${conv.id}">
            <div class="flex items-center justify-between mb-1">
              <span class="font-mono text-xs text-[var(--primary)]">${shortUserId}...</span>
              <span class="text-xs text-[var(--secondary)] font-mono">${conv.engagementScore}</span>
            </div>
            <div class="text-xs text-[var(--text-muted)] truncate mb-2">${this.escapeHtml(preview)}</div>
            <div class="flex items-center gap-3">
              <span class="engagement-stat">
                <span class="value">${conv.messageCount}</span> msgs
              </span>
              <span class="engagement-stat">
                <span class="value">${duration}</span>
              </span>
            </div>
          </div>
        `;
      }).join('');

      // Add click handlers
      container.querySelectorAll('.engagement-item').forEach(el => {
        el.addEventListener('click', () => {
          const id = el.getAttribute('data-conversation-id');
          if (id) {
            window.location.href = `/admin/conversations?select=${id}`;
          }
        });
      });
    }

    // ========== PERIOD COMPARISON ==========

    async loadComparison(days) {
      try {
        const response = await fetch(`/api/admin/analytics/comparison?days=${days}`);
        if (response.ok) {
          const data = await response.json();
          this.renderComparison(data);
        }
      } catch (error) {
        console.error('Failed to load comparison:', error);
      }
    }

    renderComparison(data) {
      const container = document.getElementById('comparison-stats');
      if (!container) return;

      const { current, previous, changes, period } = data;

      const formatChange = (value) => {
        if (value === 0) return { text: '0%', class: 'neutral', icon: '' };
        const arrow = value > 0 ? '↑' : '↓';
        const absValue = Math.abs(value);
        return {
          text: `${arrow} ${absValue}%`,
          class: value > 0 ? 'positive' : 'negative',
          icon: arrow
        };
      };

      const metrics = [
        { label: 'Conversations', current: current.conversations, previous: previous.conversations, change: changes.conversations },
        { label: 'Messages', current: current.messages, previous: previous.messages, change: changes.messages },
        { label: 'Unique Users', current: current.users, previous: previous.users, change: changes.users },
        { label: 'Avg Msgs/Conv', current: current.avgMessagesPerConversation, previous: previous.avgMessagesPerConversation, change: changes.avgMessagesPerConversation },
      ];

      container.innerHTML = metrics.map(metric => {
        const change = formatChange(metric.change);
        return `
          <div class="comparison-stat-card">
            <div class="label">${metric.label}</div>
            <div class="value">${metric.current}</div>
            <span class="change ${change.class}">${change.text}</span>
            <div class="previous">vs ${metric.previous} prev</div>
          </div>
        `;
      }).join('');
    }

    setupComparisonListeners() {
      const periodSelect = document.getElementById('comparison-period');
      if (periodSelect) {
        periodSelect.addEventListener('change', (e) => {
          this.loadComparison(e.target.value);
        });
      }
    }

    // ========== COST ANALYTICS ==========

    renderCosts(data) {
      const { daily, summary } = data;

      // Update summary stats
      const totalCostEl = document.getElementById('total-cost');
      const tokensEl = document.getElementById('cost-tokens');
      const messagesEl = document.getElementById('cost-messages');
      const avgTokensEl = document.getElementById('cost-avg-tokens');
      const avgConvEl = document.getElementById('cost-avg-conv');

      if (totalCostEl) totalCostEl.textContent = `$${summary.totalCost.toFixed(4)}`;
      if (tokensEl) tokensEl.textContent = this.formatNumber(summary.totalTokens);
      if (messagesEl) messagesEl.textContent = this.formatNumber(summary.totalMessages);
      if (avgTokensEl) avgTokensEl.textContent = this.formatNumber(summary.avgTokensPerMessage);
      if (avgConvEl) avgConvEl.textContent = `$${summary.avgCostPerConversation.toFixed(4)}`;

      // Render daily cost chart (bar chart)
      const chartContainer = document.getElementById('cost-chart');
      if (!chartContainer || !daily || daily.length === 0) return;

      const maxTokens = Math.max(...daily.map(d => d.tokens), 1);

      chartContainer.innerHTML = `
        <div class="cost-bar">
          ${daily.map(d => {
            const height = (d.tokens / maxTokens) * 100;
            return `
              <div
                class="cost-bar-item"
                style="height: ${Math.max(height, 2)}%"
                title="${d.date}: ${d.tokens} tokens ($${d.cost.toFixed(4)})"
              ></div>
            `;
          }).join('')}
        </div>
      `;
    }

    formatNumber(num) {
      if (num >= 1000000) return (num / 1000000).toFixed(1) + 'M';
      if (num >= 1000) return (num / 1000).toFixed(1) + 'K';
      return num.toString();
    }

    // ========== SETTINGS TAB ==========

    async loadSettings() {
      try {
        // Load prompt, temperature, and history in parallel
        const [promptRes, tempRes, historyRes] = await Promise.all([
          fetch('/api/admin/config/prompt'),
          fetch('/api/admin/config/temperature'),
          fetch('/api/admin/config/history?limit=20'),
        ]);

        if (promptRes.ok) {
          const data = await promptRes.json();
          this.renderPromptEditor(data);
        }

        if (tempRes.ok) {
          const data = await tempRes.json();
          this.renderTemperature(data);
        }

        if (historyRes.ok) {
          const data = await historyRes.json();
          this.renderConfigHistory(data.history);
        }
      } catch (error) {
        console.error('Failed to load settings:', error);
      }
    }

    renderPromptEditor(data) {
      const editor = document.getElementById('system-prompt-editor');
      const status = document.getElementById('prompt-status');
      const charCount = document.getElementById('prompt-char-count');

      if (editor) {
        editor.value = data.prompt;
        editor.dataset.isDefault = data.isDefault ? 'true' : 'false';
      }

      if (status) {
        status.textContent = data.isDefault ? 'Using default' : `Last updated: ${this.formatTimeAgo(data.updatedAt)}`;
        status.className = `text-xs ${data.isDefault ? 'text-[var(--text-muted)]' : 'text-[var(--color-neon-green)]'}`;
      }

      if (charCount && editor) {
        charCount.textContent = `${editor.value.length} characters`;
      }
    }

    renderTemperature(data) {
      const slider = document.getElementById('temperature-slider');
      const value = document.getElementById('temperature-value');

      if (slider) {
        slider.value = data.temperature.toString();
      }

      if (value) {
        value.textContent = data.temperature.toFixed(1);
      }
    }

    renderConfigHistory(history) {
      const container = document.getElementById('config-history');
      if (!container) return;

      if (!history || history.length === 0) {
        container.innerHTML = `
          <div class="text-center text-[var(--text-muted)] py-4 text-sm">
            No configuration changes yet
          </div>
        `;
        return;
      }

      container.innerHTML = history.map(entry => {
        const keyLabel = entry.configKey === 'system_prompt' ? 'System Prompt' : 'Temperature';
        const timeAgo = this.formatTimeAgo(entry.changedAt);

        // Truncate values for display
        const oldVal = entry.oldValue
          ? (entry.oldValue.length > 50 ? entry.oldValue.substring(0, 50) + '...' : entry.oldValue)
          : '(empty)';
        const newVal = entry.newValue.length > 50
          ? entry.newValue.substring(0, 50) + '...'
          : entry.newValue;

        return `
          <div class="history-item">
            <div class="flex items-center justify-between">
              <span class="key">${keyLabel}</span>
              <span class="time">${timeAgo}</span>
            </div>
            <div class="value-change">${oldVal} → ${newVal}</div>
          </div>
        `;
      }).join('');
    }

    setupSettingsListeners() {
      // Prompt editor character count
      const editor = document.getElementById('system-prompt-editor');
      const charCount = document.getElementById('prompt-char-count');

      if (editor && charCount) {
        editor.addEventListener('input', () => {
          charCount.textContent = `${editor.value.length} characters`;
        });
      }

      // Save prompt button
      document.getElementById('save-prompt-btn')?.addEventListener('click', () => {
        this.savePrompt();
      });

      // Reset prompt button
      document.getElementById('reset-prompt-btn')?.addEventListener('click', () => {
        this.resetPrompt();
      });

      // Temperature slider
      const slider = document.getElementById('temperature-slider');
      const tempValue = document.getElementById('temperature-value');

      if (slider && tempValue) {
        slider.addEventListener('input', () => {
          tempValue.textContent = parseFloat(slider.value).toFixed(1);
        });
      }

      // Save temperature button
      document.getElementById('save-temperature-btn')?.addEventListener('click', () => {
        this.saveTemperature();
      });

      // Reset temperature button
      document.getElementById('reset-temperature-btn')?.addEventListener('click', () => {
        this.resetTemperature();
      });
    }

    async savePrompt() {
      const editor = document.getElementById('system-prompt-editor');
      const status = document.getElementById('prompt-status');
      if (!editor) return;

      const prompt = editor.value.trim();

      if (prompt.length < 50) {
        alert('Prompt must be at least 50 characters');
        return;
      }

      try {
        status.textContent = 'Saving...';
        status.className = 'text-xs text-[var(--secondary)]';

        const response = await fetch('/api/admin/config/prompt', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ prompt }),
        });

        if (response.ok) {
          status.textContent = 'Saved successfully!';
          status.className = 'text-xs text-[var(--color-neon-green)]';

          // Reload history
          const historyRes = await fetch('/api/admin/config/history?limit=20');
          if (historyRes.ok) {
            const data = await historyRes.json();
            this.renderConfigHistory(data.history);
          }

          setTimeout(() => {
            status.textContent = 'Using custom prompt';
          }, 2000);
        } else {
          const error = await response.json();
          status.textContent = error.error || 'Failed to save';
          status.className = 'text-xs text-red-400';
        }
      } catch (error) {
        console.error('Failed to save prompt:', error);
        status.textContent = 'Error saving prompt';
        status.className = 'text-xs text-red-400';
      }
    }

    async resetPrompt() {
      if (!confirm('Reset system prompt to default? This cannot be undone.')) {
        return;
      }

      const status = document.getElementById('prompt-status');

      try {
        status.textContent = 'Resetting...';

        const response = await fetch('/api/admin/config/prompt', {
          method: 'DELETE',
        });

        if (response.ok) {
          const data = await response.json();
          const editor = document.getElementById('system-prompt-editor');
          if (editor) {
            editor.value = data.prompt;
          }

          status.textContent = 'Using default';
          status.className = 'text-xs text-[var(--text-muted)]';

          // Reload history
          const historyRes = await fetch('/api/admin/config/history?limit=20');
          if (historyRes.ok) {
            const historyData = await historyRes.json();
            this.renderConfigHistory(historyData.history);
          }
        }
      } catch (error) {
        console.error('Failed to reset prompt:', error);
      }
    }

    async saveTemperature() {
      const slider = document.getElementById('temperature-slider');
      if (!slider) return;

      const temperature = parseFloat(slider.value);

      try {
        const response = await fetch('/api/admin/config/temperature', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ temperature }),
        });

        if (response.ok) {
          alert('Temperature saved!');

          // Reload history
          const historyRes = await fetch('/api/admin/config/history?limit=20');
          if (historyRes.ok) {
            const data = await historyRes.json();
            this.renderConfigHistory(data.history);
          }
        } else {
          const error = await response.json();
          alert(error.error || 'Failed to save temperature');
        }
      } catch (error) {
        console.error('Failed to save temperature:', error);
      }
    }

    async resetTemperature() {
      try {
        const response = await fetch('/api/admin/config/temperature', {
          method: 'DELETE',
        });

        if (response.ok) {
          const data = await response.json();
          const slider = document.getElementById('temperature-slider');
          const value = document.getElementById('temperature-value');

          if (slider) slider.value = data.temperature.toString();
          if (value) value.textContent = data.temperature.toFixed(1);

          // Reload history
          const historyRes = await fetch('/api/admin/config/history?limit=20');
          if (historyRes.ok) {
            const historyData = await historyRes.json();
            this.renderConfigHistory(historyData.history);
          }
        }
      } catch (error) {
        console.error('Failed to reset temperature:', error);
      }
    }

    // ========== SEARCH ==========

    async performSearch(query) {
      if (this.isSearching) return;
      this.isSearching = true;

      const searchResults = document.getElementById('search-results');
      if (!searchResults) return;

      // Show loading state
      searchResults.innerHTML = `
        <div class="p-4 text-center text-[var(--text-muted)] font-mono text-sm">
          Searching...
        </div>
      `;
      this.showSearchResults();

      try {
        const response = await fetch(`/api/admin/search?q=${encodeURIComponent(query)}&limit=10`);

        if (!response.ok) {
          if (response.status === 401) {
            this.showLoginView();
            return;
          }
          throw new Error('Search failed');
        }

        const data = await response.json();
        this.renderSearchResults(data);
      } catch (error) {
        console.error('Search error:', error);
        searchResults.innerHTML = `
          <div class="p-4 text-center text-red-400 font-mono text-sm">
            Search failed. Please try again.
          </div>
        `;
      } finally {
        this.isSearching = false;
      }
    }

    renderSearchResults(data) {
      const searchResults = document.getElementById('search-results');
      if (!searchResults) return;

      if (data.results.length === 0) {
        searchResults.innerHTML = `
          <div class="p-4 text-center text-[var(--text-muted)] font-mono text-sm">
            No results found for "${this.escapeHtml(data.query)}"
          </div>
        `;
        return;
      }

      const resultsHtml = data.results.map(result => {
        const timeAgo = result.createdAt ? this.formatTimeAgo(result.createdAt) : '';
        const shortUserId = result.userId.substring(0, 8);

        // Convert highlight markers to HTML
        const highlightedContent = this.escapeHtml(result.highlight)
          .replace(/\[\[MATCH\]\]/g, '<mark class="search-highlight">')
          .replace(/\[\[\/MATCH\]\]/g, '</mark>');

        return `
          <div
            data-conversation-id="${result.conversationId}"
            class="search-result p-3 cursor-pointer transition-colors"
          >
            <div class="flex items-center justify-between mb-1">
              <span class="font-mono text-xs text-[var(--primary)]">
                ${shortUserId}...
              </span>
              <span class="text-xs text-[var(--text-muted)]">${timeAgo}</span>
            </div>
            <div class="text-sm text-[var(--text-primary)]">
              ${highlightedContent}
            </div>
            <div class="text-xs text-[var(--text-muted)] mt-1">
              ${result.role === 'user' ? 'User message' : 'AI response'}
            </div>
          </div>
        `;
      }).join('');

      const footer = data.pagination.total > data.results.length
        ? `
          <div class="p-3 text-center text-xs text-[var(--text-muted)] border-t border-[var(--border-color)]">
            Showing ${data.results.length} of ${data.pagination.total} results
          </div>
        `
        : '';

      searchResults.innerHTML = resultsHtml + footer;

      // Add click handlers
      searchResults.querySelectorAll('[data-conversation-id]').forEach(el => {
        el.addEventListener('click', () => {
          const id = parseInt(el.getAttribute('data-conversation-id'), 10);
          if (id) {
            this.hideSearchResults();
            document.getElementById('search-input').value = '';
            this.currentSearchQuery = '';
            this.selectConversation(id);
          }
        });
      });
    }

    showSearchResults() {
      document.getElementById('search-results')?.classList.remove('hidden');
    }

    hideSearchResults() {
      document.getElementById('search-results')?.classList.add('hidden');
    }

    clearSearch() {
      const searchInput = document.getElementById('search-input');
      if (searchInput) searchInput.value = '';
      this.currentSearchQuery = '';
      this.hideSearchResults();
    }

    // ========== MODAL ==========

    showModal(options = {}) {
      const modal = document.getElementById('delete-modal');
      const title = document.getElementById('modal-title');
      const heading = document.getElementById('modal-heading');
      const description = document.getElementById('modal-description');
      const confirmBtn = document.getElementById('modal-confirm');

      if (title) title.textContent = options.title || 'confirm.delete';
      if (heading) heading.textContent = options.heading || 'Delete Conversation?';
      if (description) description.textContent = options.description || 'This will move the conversation to trash.';
      if (confirmBtn) {
        confirmBtn.textContent = options.confirmText || 'Delete';
        confirmBtn.className = options.confirmClass || 'flex-1 px-4 py-2 bg-red-500 text-white rounded font-mono text-sm hover:bg-red-600 transition-colors';
      }

      modal?.classList.remove('hidden');

      return new Promise((resolve) => {
        this.modalResolve = resolve;
      });
    }

    closeModal(confirmed) {
      const modal = document.getElementById('delete-modal');
      modal?.classList.add('hidden');

      if (this.modalResolve) {
        this.modalResolve(confirmed);
        this.modalResolve = null;
      }
    }

    // ========== DELETE / TRASH ==========

    async deleteConversation(conversationId) {
      const confirmed = await this.showModal({
        title: 'confirm.delete',
        heading: 'Delete Conversation?',
        description: 'This will move the conversation to trash. You can restore it later.',
        confirmText: 'Delete',
      });

      if (!confirmed) return;

      try {
        const response = await fetch(`/api/admin/conversation/${conversationId}/delete`, {
          method: 'DELETE',
        });

        if (!response.ok) {
          if (response.status === 401) {
            this.showLoginView();
            return;
          }
          throw new Error('Failed to delete');
        }

        // Clear selection and reload
        this.selectedConversationId = null;
        await this.loadConversations();

        // Reset detail view
        const detailContainer = document.getElementById('conversation-detail');
        if (detailContainer) {
          detailContainer.innerHTML = `
            <div class="h-full flex items-center justify-center text-[var(--text-muted)] font-mono">
              <div class="text-center">
                <div class="text-4xl mb-4 opacity-20">&gt;_</div>
                <div>Conversation deleted</div>
                <div class="text-xs mt-2">Moved to trash</div>
              </div>
            </div>
          `;
        }
      } catch (error) {
        console.error('Failed to delete conversation:', error);
      }
    }

    async loadTrash() {
      try {
        const response = await fetch('/api/admin/trash');
        if (!response.ok) {
          if (response.status === 401) {
            this.showLoginView();
            return;
          }
          throw new Error('Failed to fetch');
        }

        const data = await response.json();
        this.trashConversations = data.conversations || [];
        this.renderTrashList();
      } catch (error) {
        console.error('Failed to load trash:', error);
      }
    }

    renderTrashList() {
      const container = document.getElementById('trash-list');
      if (!container) return;

      if (this.trashConversations.length === 0) {
        container.innerHTML = `
          <div class="p-6 text-center text-[var(--text-muted)] font-mono text-sm">
            <div class="text-2xl mb-3 opacity-30">
              <svg class="w-8 h-8 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div>Trash is empty</div>
          </div>
        `;
        return;
      }

      container.innerHTML = this.trashConversations.map(conv => {
        const deletedAt = conv.updatedAt ? this.formatTimeAgo(conv.updatedAt) : 'Unknown';
        const preview = conv.lastMessage ? this.truncate(conv.lastMessage, 40) : 'Empty conversation';
        const isActive = conv.id === this.selectedTrashId;
        const shortId = conv.userId.substring(0, 8);

        return `
          <div class="trash-item ${isActive ? 'active' : ''}" data-id="${conv.id}">
            <div class="flex items-center justify-between mb-1">
              <span class="font-mono text-sm text-[var(--secondary)]">${shortId}...</span>
              <span class="text-xs text-[var(--text-muted)]">Deleted ${deletedAt}</span>
            </div>
            <div class="text-sm text-[var(--text-muted)] truncate">${this.escapeHtml(preview)}</div>
            <div class="text-xs text-[var(--text-muted)] mt-1">
              <span class="text-[var(--secondary)]">${conv.messageCount}</span> messages
            </div>
          </div>
        `;
      }).join('');

      // Add click handlers
      container.querySelectorAll('.trash-item').forEach(item => {
        item.addEventListener('click', () => {
          const id = parseInt(item.getAttribute('data-id'), 10);
          this.selectTrashItem(id);
        });
      });
    }

    async selectTrashItem(id) {
      this.selectedTrashId = id;
      this.renderTrashList();

      const detailContainer = document.getElementById('trash-detail');
      if (!detailContainer) return;

      detailContainer.innerHTML = `
        <div class="h-full flex items-center justify-center text-[var(--text-muted)] font-mono">
          <div>Loading...</div>
        </div>
      `;

      try {
        // Fetch conversation detail (even if deleted)
        const response = await fetch(`/api/admin/conversation/${id}`);
        if (!response.ok) throw new Error('Failed to fetch');

        const data = await response.json();
        this.renderTrashDetail(data.conversation, data.messages);
      } catch (error) {
        console.error('Failed to load trash detail:', error);
        detailContainer.innerHTML = `
          <div class="h-full flex items-center justify-center text-red-400 font-mono">
            <div>Failed to load conversation</div>
          </div>
        `;
      }
    }

    renderTrashDetail(conversation, messages) {
      const container = document.getElementById('trash-detail');
      if (!container) return;

      const header = `
        <div class="mb-6 pb-4 border-b border-[var(--border-color)]">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-2">
              <span class="text-[var(--secondary)] font-mono">&gt;</span>
              <span class="font-mono font-semibold text-[var(--text-muted)]">User: ${conversation.user_id}</span>
              <span class="text-xs px-2 py-0.5 bg-red-500/20 text-red-400 rounded font-mono">DELETED</span>
            </div>
          </div>
          <div class="text-sm text-[var(--text-muted)] font-mono mb-4">
            Started: ${this.formatDate(conversation.created_at)}
          </div>
          <div class="flex gap-3">
            <button class="trash-action-btn restore" data-conversation-id="${conversation.id}">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path>
              </svg>
              RESTORE
            </button>
            <button class="trash-action-btn delete-permanent" data-conversation-id="${conversation.id}">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
              DELETE FOREVER
            </button>
          </div>
        </div>
      `;

      const messagesHtml = messages.map(msg => `
        <div class="admin-message ${msg.role}" style="opacity: 0.6;">
          <div class="admin-message-meta">
            ${msg.role === 'user' ? 'USER' : 'AARON.AI'} · ${this.formatTime(msg.created_at)}
          </div>
          <div class="admin-message-content">${this.escapeHtml(msg.content)}</div>
        </div>
      `).join('');

      container.innerHTML = header + `<div>${messagesHtml}</div>`;

      // Add action button handlers
      container.querySelector('.trash-action-btn.restore')?.addEventListener('click', async (e) => {
        const btn = e.currentTarget;
        const conversationId = parseInt(btn.getAttribute('data-conversation-id'), 10);
        if (conversationId) {
          await this.restoreConversation(conversationId);
        }
      });

      container.querySelector('.trash-action-btn.delete-permanent')?.addEventListener('click', async (e) => {
        const btn = e.currentTarget;
        const conversationId = parseInt(btn.getAttribute('data-conversation-id'), 10);
        if (conversationId) {
          await this.permanentDeleteConversation(conversationId);
        }
      });
    }

    async restoreConversation(conversationId) {
      try {
        const response = await fetch(`/api/admin/conversation/${conversationId}/restore`, {
          method: 'POST',
        });

        if (!response.ok) {
          if (response.status === 401) {
            this.showLoginView();
            return;
          }
          throw new Error('Failed to restore');
        }

        // Clear selection and reload trash
        this.selectedTrashId = null;
        await this.loadTrash();

        // Show success message
        const detailContainer = document.getElementById('trash-detail');
        if (detailContainer) {
          detailContainer.innerHTML = `
            <div class="h-full flex items-center justify-center text-[var(--text-muted)] font-mono">
              <div class="text-center">
                <div class="text-4xl mb-4 text-[var(--color-neon-green)]">
                  <svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <div class="text-[var(--color-neon-green)]">Conversation restored</div>
                <div class="text-xs mt-2">Available in Conversations tab</div>
              </div>
            </div>
          `;
        }
      } catch (error) {
        console.error('Failed to restore conversation:', error);
      }
    }

    async permanentDeleteConversation(conversationId) {
      const confirmed = await this.showModal({
        title: 'confirm.permanent_delete',
        heading: 'Delete Permanently?',
        description: 'This action cannot be undone. All messages will be lost forever.',
        confirmText: 'Delete Forever',
        confirmClass: 'flex-1 px-4 py-2 bg-red-600 text-white rounded font-mono text-sm hover:bg-red-700 transition-colors',
      });

      if (!confirmed) return;

      try {
        const response = await fetch(`/api/admin/conversation/${conversationId}/delete`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ permanent: true }),
        });

        if (!response.ok) {
          if (response.status === 401) {
            this.showLoginView();
            return;
          }
          throw new Error('Failed to permanently delete');
        }

        // Clear selection and reload trash
        this.selectedTrashId = null;
        await this.loadTrash();

        // Show success message
        const detailContainer = document.getElementById('trash-detail');
        if (detailContainer) {
          detailContainer.innerHTML = `
            <div class="h-full flex items-center justify-center text-[var(--text-muted)] font-mono">
              <div class="text-center">
                <div class="text-4xl mb-4 opacity-20">
                  <svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                  </svg>
                </div>
                <div>Permanently deleted</div>
              </div>
            </div>
          `;
        }
      } catch (error) {
        console.error('Failed to permanently delete conversation:', error);
      }
    }

    // ========== BULK ACTIONS ==========

    updateBulkUI() {
      const bulkBar = document.getElementById('bulk-action-bar');
      const selectedCount = document.getElementById('selected-count');
      const selectAllCheckbox = document.getElementById('select-all-checkbox');

      if (this.selectedIds.size > 0) {
        bulkBar?.classList.remove('hidden');
        if (selectedCount) selectedCount.textContent = this.selectedIds.size.toString();

        // Update select-all checkbox state
        if (selectAllCheckbox) {
          selectAllCheckbox.checked = this.selectedIds.size === this.conversations.length;
          selectAllCheckbox.indeterminate = this.selectedIds.size > 0 && this.selectedIds.size < this.conversations.length;
        }
      } else {
        bulkBar?.classList.add('hidden');
        if (selectAllCheckbox) {
          selectAllCheckbox.checked = false;
          selectAllCheckbox.indeterminate = false;
        }
      }
    }

    async bulkDelete() {
      const count = this.selectedIds.size;
      const confirmed = await this.showModal({
        title: 'confirm.bulk_delete',
        heading: `Delete ${count} Conversation${count > 1 ? 's' : ''}?`,
        description: `This will move ${count} conversation${count > 1 ? 's' : ''} to trash. You can restore them later.`,
        confirmText: `Delete ${count}`,
      });

      if (!confirmed) return;

      try {
        const ids = Array.from(this.selectedIds);
        const response = await fetch('/api/admin/conversations/bulk', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ids, action: 'delete' }),
        });

        if (!response.ok) {
          if (response.status === 401) {
            this.showLoginView();
            return;
          }
          throw new Error('Bulk delete failed');
        }

        const result = await response.json();

        // Clear selection and reload
        this.selectedIds.clear();
        this.selectedConversationId = null;
        await this.loadConversations();

        // Show result in detail view
        const detailContainer = document.getElementById('conversation-detail');
        if (detailContainer) {
          detailContainer.innerHTML = `
            <div class="h-full flex items-center justify-center text-[var(--text-muted)] font-mono">
              <div class="text-center">
                <div class="text-4xl mb-4 opacity-20">&gt;_</div>
                <div>${result.result.success} conversation${result.result.success !== 1 ? 's' : ''} deleted</div>
                ${result.result.failed > 0 ? `<div class="text-xs text-red-400 mt-1">${result.result.failed} failed</div>` : ''}
                <div class="text-xs mt-2">Moved to trash</div>
              </div>
            </div>
          `;
        }
      } catch (error) {
        console.error('Bulk delete failed:', error);
      }
    }

    populateBulkTagDropdown() {
      const container = document.getElementById('bulk-tag-options');
      if (!container) return;

      if (this.availableTags.length === 0) {
        container.innerHTML = `
          <div class="text-xs text-[var(--text-muted)] p-2">
            No tags available. Create tags first.
          </div>
        `;
        return;
      }

      container.innerHTML = this.availableTags.map(tag => `
        <div class="bulk-tag-option" data-tag-id="${tag.id}">
          <div class="tag-color" style="background: ${tag.color};"></div>
          <span class="text-xs font-mono">${this.escapeHtml(tag.name)}</span>
        </div>
      `).join('');

      // Add click handlers
      container.querySelectorAll('.bulk-tag-option').forEach(option => {
        option.addEventListener('click', async () => {
          const tagId = parseInt(option.getAttribute('data-tag-id'), 10);
          if (tagId) {
            document.getElementById('bulk-tag-dropdown')?.classList.add('hidden');
            await this.bulkTag(tagId);
          }
        });
      });
    }

    async bulkTag(tagId) {
      const count = this.selectedIds.size;
      const tag = this.availableTags.find(t => t.id === tagId);
      if (!tag) return;

      try {
        const ids = Array.from(this.selectedIds);
        const response = await fetch('/api/admin/conversations/bulk', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ids, action: 'tag', tagId }),
        });

        if (!response.ok) {
          if (response.status === 401) {
            this.showLoginView();
            return;
          }
          throw new Error('Bulk tag failed');
        }

        const result = await response.json();

        // Clear selection and reload
        this.selectedIds.clear();
        await this.loadConversations();

        // Show success feedback
        const detailContainer = document.getElementById('conversation-detail');
        if (detailContainer && !this.selectedConversationId) {
          detailContainer.innerHTML = `
            <div class="h-full flex items-center justify-center text-[var(--text-muted)] font-mono">
              <div class="text-center">
                <div class="text-4xl mb-4 text-[var(--primary)]">
                  <svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                  </svg>
                </div>
                <div>Tagged ${result.result.success} conversation${result.result.success !== 1 ? 's' : ''}</div>
                <div class="text-xs mt-2 flex items-center justify-center gap-1">
                  <span class="tag-badge" style="background: ${tag.color}20; color: ${tag.color};">${tag.name}</span>
                </div>
              </div>
            </div>
          `;
        }
      } catch (error) {
        console.error('Bulk tag failed:', error);
      }
    }

    async bulkExport() {
      const count = this.selectedIds.size;

      try {
        const ids = Array.from(this.selectedIds);
        const response = await fetch('/api/admin/conversations/bulk', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ids, action: 'export' }),
        });

        if (!response.ok) {
          if (response.status === 401) {
            this.showLoginView();
            return;
          }
          throw new Error('Bulk export failed');
        }

        const result = await response.json();

        // Create downloadable JSON file
        const blob = new Blob([JSON.stringify(result.result.data, null, 2)], {
          type: 'application/json',
        });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `conversations-export-${new Date().toISOString().split('T')[0]}.json`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);

        // Clear selection
        this.selectedIds.clear();
        this.updateBulkUI();
        this.renderConversationsList();

        // Show success feedback
        const detailContainer = document.getElementById('conversation-detail');
        if (detailContainer && !this.selectedConversationId) {
          detailContainer.innerHTML = `
            <div class="h-full flex items-center justify-center text-[var(--text-muted)] font-mono">
              <div class="text-center">
                <div class="text-4xl mb-4 text-[var(--color-neon-green)]">
                  <svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                  </svg>
                </div>
                <div class="text-[var(--color-neon-green)]">Exported ${result.result.success} conversation${result.result.success !== 1 ? 's' : ''}</div>
                <div class="text-xs mt-2">Download started</div>
              </div>
            </div>
          `;
        }
      } catch (error) {
        console.error('Bulk export failed:', error);
      }
    }

    // ========== FILTERS ==========

    setupFilterEventListeners() {
      const filtersToggle = document.getElementById('filters-toggle');
      const filtersPanel = document.getElementById('filters-panel');
      const filtersChevron = document.getElementById('filters-chevron');
      const applyBtn = document.getElementById('apply-filters-btn');
      const clearBtn = document.getElementById('clear-filters-btn');

      // Toggle filters panel
      filtersToggle?.addEventListener('click', () => {
        filtersPanel?.classList.toggle('hidden');
        filtersChevron?.classList.toggle('open');
      });

      // Apply filters
      applyBtn?.addEventListener('click', () => {
        this.applyFilters();
      });

      // Clear filters
      clearBtn?.addEventListener('click', () => {
        this.clearFilters();
      });
    }

    loadFiltersFromURL() {
      const url = new URL(window.location.href);
      const dateFrom = url.searchParams.get('dateFrom');
      const dateTo = url.searchParams.get('dateTo');
      const language = url.searchParams.get('language');
      const minMessages = url.searchParams.get('minMessages');
      const maxMessages = url.searchParams.get('maxMessages');
      const hasTag = url.searchParams.get('hasTag');

      // Populate form fields
      if (dateFrom) {
        document.getElementById('filter-date-from').value = dateFrom;
        this.filters.dateFrom = dateFrom;
      }
      if (dateTo) {
        document.getElementById('filter-date-to').value = dateTo;
        this.filters.dateTo = dateTo;
      }
      if (language) {
        document.getElementById('filter-language').value = language;
        this.filters.language = language;
      }
      if (minMessages) {
        document.getElementById('filter-min-messages').value = minMessages;
        this.filters.minMessages = parseInt(minMessages, 10);
      }
      if (maxMessages) {
        document.getElementById('filter-max-messages').value = maxMessages;
        this.filters.maxMessages = parseInt(maxMessages, 10);
      }
      if (hasTag) {
        document.getElementById('filter-tag').value = hasTag;
        this.filters.hasTag = parseInt(hasTag, 10);
      }

      this.updateFilterChips();
    }

    async loadTags() {
      try {
        const response = await fetch('/api/admin/tags');
        if (response.ok) {
          const data = await response.json();
          this.availableTags = data.tags || [];
          this.populateTagFilter();
        }
      } catch (error) {
        console.error('Failed to load tags:', error);
      }
    }

    populateTagFilter() {
      const select = document.getElementById('filter-tag');
      if (!select) return;

      // Keep the first "All tags" option
      select.innerHTML = '<option value="">All tags</option>';

      this.availableTags.forEach(tag => {
        const option = document.createElement('option');
        option.value = tag.id.toString();
        option.textContent = tag.name;
        option.style.color = tag.color;
        select.appendChild(option);
      });

      // Restore selected value if filter is active
      if (this.filters.hasTag) {
        select.value = this.filters.hasTag.toString();
      }
    }

    applyFilters() {
      // Read form values
      this.filters.dateFrom = document.getElementById('filter-date-from')?.value || null;
      this.filters.dateTo = document.getElementById('filter-date-to')?.value || null;
      this.filters.language = document.getElementById('filter-language')?.value || null;
      const minMsgVal = document.getElementById('filter-min-messages')?.value;
      const maxMsgVal = document.getElementById('filter-max-messages')?.value;
      const tagVal = document.getElementById('filter-tag')?.value;
      this.filters.minMessages = minMsgVal ? parseInt(minMsgVal, 10) : null;
      this.filters.maxMessages = maxMsgVal ? parseInt(maxMsgVal, 10) : null;
      this.filters.hasTag = tagVal ? parseInt(tagVal, 10) : null;

      // Update URL
      this.updateFilterURL();

      // Update chips
      this.updateFilterChips();

      // Reload conversations
      this.loadConversations();

      // Collapse filters panel
      document.getElementById('filters-panel')?.classList.add('hidden');
      document.getElementById('filters-chevron')?.classList.remove('open');
    }

    clearFilters() {
      // Clear form fields
      document.getElementById('filter-date-from').value = '';
      document.getElementById('filter-date-to').value = '';
      document.getElementById('filter-language').value = '';
      document.getElementById('filter-min-messages').value = '';
      document.getElementById('filter-max-messages').value = '';
      document.getElementById('filter-tag').value = '';

      // Clear filter state
      this.filters = {
        dateFrom: null,
        dateTo: null,
        language: null,
        minMessages: null,
        maxMessages: null,
        hasTag: null,
      };

      // Update URL
      this.updateFilterURL();

      // Update chips
      this.updateFilterChips();

      // Reload conversations
      this.loadConversations();
    }

    updateFilterURL() {
      const url = new URL(window.location.href);

      // Clear existing filter params
      ['dateFrom', 'dateTo', 'language', 'minMessages', 'maxMessages', 'hasTag'].forEach(key => {
        url.searchParams.delete(key);
      });

      // Add active filters
      if (this.filters.dateFrom) url.searchParams.set('dateFrom', this.filters.dateFrom);
      if (this.filters.dateTo) url.searchParams.set('dateTo', this.filters.dateTo);
      if (this.filters.language) url.searchParams.set('language', this.filters.language);
      if (this.filters.minMessages) url.searchParams.set('minMessages', this.filters.minMessages.toString());
      if (this.filters.maxMessages) url.searchParams.set('maxMessages', this.filters.maxMessages.toString());
      if (this.filters.hasTag) url.searchParams.set('hasTag', this.filters.hasTag.toString());

      // Update URL without reload
      window.history.replaceState({}, '', url.toString());
    }

    updateFilterChips() {
      const chipsContainer = document.getElementById('active-filters-chips');
      const countBadge = document.getElementById('active-filters-count');
      if (!chipsContainer) return;

      const chips = [];

      if (this.filters.dateFrom) {
        chips.push({ key: 'dateFrom', label: `From: ${this.filters.dateFrom}` });
      }
      if (this.filters.dateTo) {
        chips.push({ key: 'dateTo', label: `To: ${this.filters.dateTo}` });
      }
      if (this.filters.language) {
        const langNames = { es: 'Spanish', en: 'English' };
        chips.push({ key: 'language', label: langNames[this.filters.language] || this.filters.language });
      }
      if (this.filters.minMessages) {
        chips.push({ key: 'minMessages', label: `≥${this.filters.minMessages} msgs` });
      }
      if (this.filters.maxMessages) {
        chips.push({ key: 'maxMessages', label: `≤${this.filters.maxMessages} msgs` });
      }
      if (this.filters.hasTag) {
        const tag = this.availableTags.find(t => t.id === this.filters.hasTag);
        if (tag) {
          chips.push({ key: 'hasTag', label: `Tag: ${tag.name}` });
        }
      }

      // Update count badge
      if (countBadge) {
        if (chips.length > 0) {
          countBadge.textContent = chips.length.toString();
          countBadge.classList.remove('hidden');
        } else {
          countBadge.classList.add('hidden');
        }
      }

      // Render chips
      if (chips.length === 0) {
        chipsContainer.classList.add('hidden');
        chipsContainer.classList.remove('flex');
        chipsContainer.innerHTML = '';
        return;
      }

      chipsContainer.classList.remove('hidden');
      chipsContainer.classList.add('flex');
      chipsContainer.innerHTML = chips.map(chip => `
        <span class="filter-chip" data-filter-key="${chip.key}">
          ${chip.label}
          <span class="filter-chip-remove" data-remove="${chip.key}">×</span>
        </span>
      `).join('');

      // Add remove handlers
      chipsContainer.querySelectorAll('.filter-chip-remove').forEach(el => {
        el.addEventListener('click', (e) => {
          e.stopPropagation();
          const key = el.getAttribute('data-remove');
          this.removeFilter(key);
        });
      });
    }

    removeFilter(key) {
      this.filters[key] = null;

      // Clear form field
      const fieldIds = {
        dateFrom: 'filter-date-from',
        dateTo: 'filter-date-to',
        language: 'filter-language',
        minMessages: 'filter-min-messages',
        maxMessages: 'filter-max-messages',
        hasTag: 'filter-tag',
      };

      const fieldEl = document.getElementById(fieldIds[key]);
      if (fieldEl) fieldEl.value = '';

      // Update URL and chips
      this.updateFilterURL();
      this.updateFilterChips();

      // Reload conversations
      this.loadConversations();
    }

    hasActiveFilters() {
      return Object.values(this.filters).some(v => v !== null && v !== '');
    }

    // ========== MODERATION ==========

    async loadModeration() {
      try {
        // Load rate limit logs and flagged conversations in parallel
        const [rateLimitsRes, flaggedRes] = await Promise.all([
          fetch('/api/admin/moderation/rate-limits'),
          fetch('/api/admin/moderation/flagged'),
        ]);

        if (rateLimitsRes.status === 401 || flaggedRes.status === 401) {
          this.showLoginView();
          return;
        }

        const rateLimitsData = await rateLimitsRes.json();
        const flaggedData = await flaggedRes.json();

        this.rateLimitLogs = rateLimitsData.logs || [];
        this.flaggedConversations = flaggedData.flagged || [];
        this.moderationStats = {
          rateLimits: rateLimitsData.stats || {},
          flagged: flaggedData.stats || {},
          topBlocked: rateLimitsData.topBlocked || [],
        };

        this.renderModerationStats();
        this.renderRateLimits();
        this.renderFlagged();
        this.renderTopBlocked();
      } catch (error) {
        console.error('Failed to load moderation data:', error);
      }
    }

    renderModerationStats() {
      const stats = this.moderationStats;
      if (!stats) return;

      // Rate limit stats
      const totalEvents = document.querySelector('[data-stat="total-events"]');
      const blockedCount = document.querySelector('[data-stat="blocked-count"]');
      const blockRate = document.querySelector('[data-stat="block-rate"]');
      const uniqueIPs = document.querySelector('[data-stat="unique-ips"]');

      if (totalEvents) totalEvents.textContent = stats.rateLimits.totalEvents || 0;
      if (blockedCount) blockedCount.textContent = stats.rateLimits.totalBlocked || 0;
      if (blockRate) blockRate.textContent = `${stats.rateLimits.blockRate || 0}%`;
      if (uniqueIPs) uniqueIPs.textContent = stats.rateLimits.uniqueIPs || 0;

      // Flagged stats
      const pendingFlags = document.querySelector('[data-stat="pending-flags"]');
      const highPriority = document.querySelector('[data-stat="high-priority"]');

      if (pendingFlags) pendingFlags.textContent = stats.flagged.pending || 0;
      if (highPriority) highPriority.textContent = stats.flagged.highPriority || 0;
    }

    renderRateLimits() {
      const container = document.getElementById('rate-limit-list');
      if (!container) return;

      if (this.rateLimitLogs.length === 0) {
        container.innerHTML = `
          <div class="text-center text-[var(--text-muted)] py-8 font-mono text-xs">
            No rate limit events in the last 24 hours
          </div>
        `;
        return;
      }

      container.innerHTML = this.rateLimitLogs.slice(0, 20).map(log => `
        <div class="rate-limit-item ${log.blocked ? 'blocked' : ''}">
          <div class="rate-limit-info">
            <div class="rate-limit-ip font-mono">${this.escapeHtml(log.ip)}</div>
            <div class="rate-limit-meta">
              <span>${log.endpoint || '/api/chat'}</span>
              ${log.userId ? `<span>• ${this.truncate(log.userId, 10)}</span>` : ''}
            </div>
          </div>
          <div class="rate-limit-status">
            ${log.blocked
              ? '<span class="status-badge blocked">Blocked</span>'
              : '<span class="status-badge allowed">Allowed</span>'}
            <span class="rate-limit-time">${this.formatTimeAgo(log.createdAt)}</span>
          </div>
        </div>
      `).join('');
    }

    renderFlagged() {
      const container = document.getElementById('flagged-list');
      if (!container) return;

      if (this.flaggedConversations.length === 0) {
        container.innerHTML = `
          <div class="text-center text-[var(--text-muted)] py-8 font-mono text-xs">
            No flagged conversations pending review
          </div>
        `;
        return;
      }

      container.innerHTML = this.flaggedConversations.map(flag => `
        <div class="flagged-item" data-flag-id="${flag.id}" data-conversation-id="${flag.conversationId}">
          <div class="flagged-header">
            <div class="flagged-severity ${flag.severity}">${flag.severity.toUpperCase()}</div>
            <div class="flagged-reason">${this.escapeHtml(flag.reason)}</div>
          </div>
          <div class="flagged-meta">
            <span class="font-mono text-xs">${this.truncate(flag.userId, 12)}</span>
            <span>• ${flag.messageCount} messages</span>
            <span>• ${this.formatTimeAgo(flag.createdAt)}</span>
          </div>
          ${flag.lastMessage ? `
            <div class="flagged-preview">${this.escapeHtml(this.truncate(flag.lastMessage, 100))}</div>
          ` : ''}
          <div class="flagged-actions">
            <button class="btn-action view" data-conversation-id="${flag.conversationId}">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
              </svg>
              View
            </button>
            <button class="btn-action dismiss" data-flag-id="${flag.id}">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              Dismiss
            </button>
          </div>
        </div>
      `).join('');
    }

    renderTopBlocked() {
      const container = document.getElementById('top-blocked-list');
      if (!container || !this.moderationStats?.topBlocked) return;

      const topBlocked = this.moderationStats.topBlocked;

      if (topBlocked.length === 0) {
        container.innerHTML = `
          <div class="text-center text-[var(--text-muted)] py-4 font-mono text-xs">
            No blocked IPs in the last 7 days
          </div>
        `;
        return;
      }

      container.innerHTML = topBlocked.map(item => `
        <div class="blocked-ip-item">
          <span class="font-mono">${this.escapeHtml(item.ip)}</span>
          <span class="block-count">${item.block_count} blocks</span>
        </div>
      `).join('');
    }

    setupModerationListeners() {
      // Scan for spam button
      const scanBtn = document.getElementById('scan-spam-btn');
      scanBtn?.addEventListener('click', async () => {
        scanBtn.disabled = true;
        scanBtn.textContent = 'Scanning...';

        try {
          const response = await fetch('/api/admin/moderation/scan', { method: 'POST' });
          if (response.status === 401) {
            this.showLoginView();
            return;
          }

          const result = await response.json();

          // Show result message
          const resultEl = document.getElementById('scan-result');
          if (resultEl) {
            resultEl.textContent = result.message || `Scanned: ${result.scanned}, Flagged: ${result.flagged}`;
            resultEl.classList.remove('hidden');
            setTimeout(() => resultEl.classList.add('hidden'), 5000);
          }

          // Reload flagged conversations
          await this.loadModeration();
        } catch (error) {
          console.error('Scan failed:', error);
        } finally {
          scanBtn.disabled = false;
          scanBtn.textContent = 'Scan for Spam';
        }
      });

      // Show blocked only checkbox
      const blockedOnlyCheckbox = document.getElementById('blocked-only');
      blockedOnlyCheckbox?.addEventListener('change', async (e) => {
        const blockedOnly = e.target.checked;
        try {
          const response = await fetch(`/api/admin/moderation/rate-limits?blocked=${blockedOnly}`);
          if (response.ok) {
            const data = await response.json();
            this.rateLimitLogs = data.logs || [];
            this.renderRateLimits();
          }
        } catch (error) {
          console.error('Failed to filter rate limits:', error);
        }
      });

      // Show reviewed checkbox
      const showReviewedCheckbox = document.getElementById('show-reviewed');
      showReviewedCheckbox?.addEventListener('change', async (e) => {
        const showReviewed = e.target.checked;
        try {
          const response = await fetch(`/api/admin/moderation/flagged?reviewed=${showReviewed}`);
          if (response.ok) {
            const data = await response.json();
            this.flaggedConversations = data.flagged || [];
            this.renderFlagged();
          }
        } catch (error) {
          console.error('Failed to filter flagged:', error);
        }
      });

      // Flagged item actions (delegated)
      const flaggedList = document.getElementById('flagged-list');
      flaggedList?.addEventListener('click', async (e) => {
        const target = e.target.closest('button');
        if (!target) return;

        const flagId = target.dataset.flagId;
        const conversationId = target.dataset.conversationId;

        if (target.classList.contains('view') && conversationId) {
          // Navigate to conversation
          window.location.href = `/admin/conversations?id=${conversationId}`;
        } else if (target.classList.contains('dismiss') && flagId) {
          // Dismiss flag
          try {
            const response = await fetch('/api/admin/moderation/flagged', {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: parseInt(flagId, 10), action: 'dismiss' }),
            });

            if (response.ok) {
              // Remove from list
              this.flaggedConversations = this.flaggedConversations.filter(f => f.id !== parseInt(flagId, 10));
              this.renderFlagged();

              // Update stats
              if (this.moderationStats?.flagged?.pending > 0) {
                this.moderationStats.flagged.pending--;
                this.renderModerationStats();
              }
            }
          } catch (error) {
            console.error('Failed to dismiss flag:', error);
          }
        }
      });
    }

    // ========== HELPERS ==========

    formatTimeAgo(dateStr) {
      const date = new Date(dateStr + 'Z');
      const now = new Date();
      const diffMs = now.getTime() - date.getTime();
      const diffMins = Math.floor(diffMs / 60000);
      const diffHours = Math.floor(diffMs / 3600000);
      const diffDays = Math.floor(diffMs / 86400000);

      if (diffMins < 1) return 'Just now';
      if (diffMins < 60) return `${diffMins}m ago`;
      if (diffHours < 24) return `${diffHours}h ago`;
      if (diffDays < 7) return `${diffDays}d ago`;
      return date.toLocaleDateString();
    }

    formatDate(dateStr) {
      const date = new Date(dateStr + 'Z');
      return date.toLocaleString();
    }

    formatTime(dateStr) {
      const date = new Date(dateStr + 'Z');
      return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }

    truncate(str, len) {
      return str.length > len ? str.substring(0, len) + '...' : str;
    }

    escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }
  }

  // Singleton pattern to prevent multiple instances
  let adminPanelInstance = null;

  function initAdminPanel() {
    // Cleanup previous instance
    if (adminPanelInstance) {
      if (adminPanelInstance.eventSource) {
        adminPanelInstance.eventSource.close();
        adminPanelInstance.eventSource = null;
      }
      adminPanelInstance = null;
    }
    adminPanelInstance = new AdminPanel();
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAdminPanel);
  } else {
    initAdminPanel();
  }

  // Also handle Astro View Transitions
  document.addEventListener('astro:page-load', initAdminPanel);
</script>
