{
	"main": "dist/_worker.js/index.js",
	"name": "portfolio",
  "compatibility_date": "2025-12-13",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  // D1 database para persistir conversaciones del chat
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-chat",
      "database_id": "830a1493-18e6-4c4b-8e54-19edc92993d3"
    }
  ],
  // Admin panel secret (set via: wrangler secret put ADMIN_SECRET)
  // For local dev, set in .dev.vars file

  // Rate limiting para proteger el endpoint de chat (20 req/min por IP)
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}