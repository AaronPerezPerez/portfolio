{
	"main": "dist/_worker.js/index.js",
	"name": "portfolio",
  "compatibility_date": "2025-12-13",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI"
  },
  // Rate limiting para proteger el endpoint de chat (20 req/min por IP)
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}